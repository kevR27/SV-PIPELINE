configfile: "config_lrs.yaml"

SAMPLES    = list(config["samples"].keys())
BAMS       = config["samples"]
PATH       = config["path"]
REF        = config["ref"]
THREADS    = config["threads"]
BED        = config["bed"]                    # panel regions (Clair3 target + AnnotSV candidate genes)
GENE_LIST  = config["candidate_genes_list"]    # optic-neuropathy / mito-disease panel gene symbols
CPG        = config["cpg"]
CONDAENV   = config["condaenv"]
MODKITENV  = config["modkitenv"]
CLAIRENV   = config["clair3env"]
TLDR_ELTS  = config["tldr_elements"]           # only used by the OPTIONAL confirmatory rule below

# --- SVAN inputs ---
SVAN_DIR       = config["svan_dir"]
VNTR_BED       = config["vntr_bed"]
MEI_CONSENSUS  = config["mei_consensus_fasta"]
GTF            = config["gtf"]

# --- needLR (used ONLY as an ONT-native population-AF filter, not as gene annotation) ---
NEEDLR_BACKEND = config.get("needlr_backend_files", None)

# --- VEP ---
VEP_CACHE_DIR  = config["vep_cache_dir"]
VEP_ASSEMBLY   = config.get("vep_assembly", "GRCh38")

# --- Optional confirmatory MEI caller (see block at bottom) ---
RUN_TLDR_CONFIRMATION = config.get("run_tldr_confirmation", False)  # keep False by default


rule all:
    input:
        # QC
        expand(PATH + "{sample}/coverage/{sample}.mosdepth.global.dist.txt", sample=SAMPLES),

        # small variants + phasing (control track)
        expand(PATH + "{sample}/snp_clair3/{sample}.vcf.gz", sample=SAMPLES),
        expand(PATH + "{sample}/phasing/{sample}.phased.vcf.gz", sample=SAMPLES),
        expand(PATH + "{sample}/phasing/{sample}.phased.bam", sample=SAMPLES),

        # SV calling + merge
        expand(PATH + "{sample}/sv/sniffles2/{sample}_sniffles.vcf", sample=SAMPLES),
        expand(PATH + "{sample}/sv/cutesv/{sample}_cutesv.vcf", sample=SAMPLES),
        expand(PATH + "{sample}/sv/merged/{sample}_merged_SV.vcf", sample=SAMPLES),

        # insertion / MEI mechanism classification (RepeatMasker -> SVAN; no redundant 2nd/3rd/4th caller)
        expand(PATH + "{sample}/sv/insertions/{sample}_repeatmasker.out", sample=SAMPLES),
        expand(PATH + "{sample}/sv/svan/{sample}_SVAN.vcf", sample=SAMPLES),

        # repeat expansion (straglr primary, annotated)
        expand(PATH + "{sample}/sv/straglr/{sample}_straglr.annotated.vcf", sample=SAMPLES),

        # population-AF filtering (ONT-native cohort, upstream of clinical annotation)
        expand(PATH + "{sample}/sv/needlr/{sample}_needLR_RESULTS.vcf.gz", sample=SAMPLES),

        # clinical/gene annotation (single source of truth) + transcript-level consequence detail
        expand(PATH + "{sample}/sv/annotsv/{sample}_merged_SV.annotsv.tsv", sample=SAMPLES),
        expand(PATH + "{sample}/sv/vep/{sample}_SV_VEP.txt", sample=SAMPLES),
        PATH + "reference/hg38_exons.bed",

        # methylation + mtDNA
        expand(PATH + "{sample}/methylation/{sample}.modkit.tsv", sample=SAMPLES),
        expand(PATH + "{sample}/mtdna/eklipse/{sample}_eKLIPse.csv", sample=SAMPLES)

################
# QC           #
################

rule mosdepth_coverage:
    input:
        lambda wc: BAMS[wc.sample]
    output:
        PATH + "{sample}/coverage/{sample}.mosdepth.global.dist.txt"
    conda:
        CONDAENV + "mosdepth.yaml"
    shell:
        """
        mosdepth -t {THREADS} {PATH}/{wildcards.sample}/coverage/{wildcards.sample} {input}
        """

##################################
# Small variant calling (control) #
##################################

rule clair3_snp_calling:
    input:
        bam = lambda wc: BAMS[wc.sample],
        ref = REF
    output:
        vcf = PATH + "{sample}/snp_clair3/{sample}.vcf.gz"
    conda:
        CONDAENV + "clair3.yaml"
    shell:
        """
        run_clair3.sh -b {input.bam} -f {input.ref} -t {THREADS} -p ont \
            -o {PATH}/{wildcards.sample}/snp_clair3 \
            -m {CLAIRENV} \
            --bed_fn={BED}

        cp {PATH}/{wildcards.sample}/snp_clair3/merge_output.vcf.gz {output.vcf}
        tabix -p vcf {output.vcf}
        """

rule whatsHap_phasing:
    # default phasing track. LongPhase (SV+SNP joint phasing) was dropped from
    # the default run — it was doubling phasing work for a comparison you
    # only need on a specific candidate locus. Re-add it as a targeted,
    # on-demand rule if/when a candidate SV needs SV-aware phase blocks.
    input:
        vcf = rules.clair3_snp_calling.output.vcf,
        bam = lambda wc: BAMS[wc.sample],
        ref = REF
    output:
        phased = PATH + "{sample}/phasing/{sample}.phased.vcf.gz",
        haplotag = PATH + "{sample}/phasing/{sample}.phased.bam"
    conda:
        CONDAENV + "whatshap.yaml"
    shell:
        """
        whatshap phase --reference {input.ref} -o {output.phased} {input.vcf} {input.bam} --ignore-read-groups
        tabix -p vcf {output.phased}
        whatshap haplotag -o {output.haplotag} --reference {input.ref} {output.phased} {input.bam} --ignore-read-groups
        samtools index {output.haplotag}
        """

########################
# SV calling + merge   #
########################

rule sniffles2_sv:
    input:
        bam = lambda wc: BAMS[wc.sample],
        ref = REF
    output:
        vcf = PATH + "{sample}/sv/sniffles2/{sample}_sniffles.vcf"
    conda:
        CONDAENV + "sniffles2.yaml"
    shell:
        """
        sniffles --input {input.bam} --vcf {output.vcf} --reference {input.ref} --threads {THREADS} \
            --minsupport 1 --no-qc --mosaic --allow-overwrite --min-alignment-length 100 \
            --output-rnames --tandem-repeats {VNTR_BED}
        """

rule cutesv:
    input:
        bam = lambda wc: BAMS[wc.sample],
        ref = REF
    output:
        vcf = PATH + "{sample}/sv/cutesv/{sample}_cutesv.vcf"
    conda:
        CONDAENV + "cutesv.yaml"
    shell:
        """
        cuteSV {input.bam} {input.ref} {output.vcf} {PATH}/{wildcards.sample}/sv/cutesv --threads {THREADS} \
            --max_cluster_bias_INS 100 --diff_ratio_merging_INS 0.3 \
            --max_cluster_bias_DEL 100 --diff_ratio_merging_DEL 0.3 \
            --min_support 1 --genotype -include_bed {BED}
        """

rule jasmine_merge:
    input:
        sniffles = rules.sniffles2_sv.output.vcf,
        cutesv   = rules.cutesv.output.vcf
    output:
        list_file = PATH + "{sample}/sv/merged/{sample}_vcf_list.txt",
        vcf = PATH + "{sample}/sv/merged/{sample}_merged_SV.vcf"
    conda:
        CONDAENV + "jasmine.yaml"
    shell:
        """
        printf "%s\\n%s\\n" {input.sniffles} {input.cutesv} > {output.list_file}
        jasmine file_list={output.list_file} out_file={output.vcf} \
            threads={THREADS} --output_genotypes --dup_to_ins
        """

#####################################################################
# Insertion sequence extraction + single-pass TE/mechanism classify #
#####################################################################

rule extract_insertion_seqs:
    input:
        vcf = rules.jasmine_merge.output.vcf
    output:
        fasta = PATH + "{sample}/sv/insertions/{sample}_insertions.fasta"
    conda:
        CONDAENV + "annotsv.yaml"
    shell:
        """
        bcftools view -i 'INFO/SVTYPE="INS"' {input.vcf} | \
        bcftools query -f '>%ID\\n%ALT\\n' - | \
        sed 's/,.*$//' > {output.fasta}
        """

rule repeatmasker_classify:
    input:
        fasta = rules.extract_insertion_seqs.output.fasta
    output:
        out = PATH + "{sample}/sv/insertions/{sample}_repeatmasker.out"
    params:
        outdir = PATH + "{sample}/sv/insertions"
    conda:
        CONDAENV + "repeatmasker.yaml"
    shell:
        """
        RepeatMasker -species human -pa {THREADS} -dir {params.outdir} {input.fasta}
        mv {params.outdir}/{wildcards.sample}_insertions.fasta.out {output.out}
        """

rule gtf_to_exons_bed:
    input:
        gtf = GTF
    output:
        bed = PATH + "reference/hg38_exons.bed"
    conda:
        CONDAENV + "svan.yaml"
    shell:
        """
        mkdir -p {PATH}/reference
        awk 'BEGIN{{OFS="\\t"}} $3=="exon" {{print $1, $4-1, $5}}' {input.gtf} | \
        sort -k1,1 -k2,2n -u > {output.bed}
        """

rule trf_on_svs:
    input:
        vcf = rules.jasmine_merge.output.vcf
    output:
        dat = PATH + "{sample}/sv/svan/{sample}_indels.trf.dat"
    params:
        outdir = PATH + "{sample}/sv/svan",
        fasta = PATH + "{sample}/sv/svan/{sample}_indels.fasta"
    conda:
        CONDAENV + "svan.yaml"
    shell:
        """
        mkdir -p {params.outdir}
        bcftools view -i 'INFO/SVTYPE="INS" || INFO/SVTYPE="DEL"' {input.vcf} | \
        bcftools query -f '>%ID\\n%ALT\\n' - | sed 's/,.*$//' > {params.fasta}
        trf {params.fasta} 2 7 7 80 10 50 500 -d -h
        mv {wildcards.sample}_indels.fasta.2.7.7.80.10.50.500.dat {output.dat}
        """

rule svan_annotation:
    # SVAN is the ONLY mechanism classifier in the default run: it already
    # consumes the RepeatMasker output above, so it covers MEI/NUMT/
    # processed-pseudogene/tandem-repeat calls without needing TLDR, PALMER,
    # or xTea-long run genome-wide as well.
    input:
        vcf = rules.jasmine_merge.output.vcf,
        trf = rules.trf_on_svs.output.dat,
        vntr = VNTR_BED,
        exons = rules.gtf_to_exons_bed.output.bed,
        repeats = rules.repeatmasker_classify.output.out,
        consensus = MEI_CONSENSUS,
        ref = REF
    output:
        vcf = PATH + "{sample}/sv/svan/{sample}_SVAN.vcf"
    params:
        outdir = PATH + "{sample}/sv/svan"
    conda:
        CONDAENV + "svan.yaml"
    shell:
        """
        python {SVAN_DIR}/SVAN.py \
            --vcf {input.vcf} \
            --trf {input.trf} \
            --vntr {input.vntr} \
            --exons {input.exons} \
            --repeats {input.repeats} \
            --consensus {input.consensus} \
            --reference {input.ref} \
            --sampleId {wildcards.sample} \
            --outDir {params.outdir}
        """

##################################################################
# Repeat expansion (straglr primary; strdust dropped as default) #
##################################################################

rule straglr:
    input:
        bam = lambda wc: BAMS[wc.sample],
        ref = REF
    output:
        vvf = PATH + "{sample}/sv/straglr/{sample}_straglr.vcf",
        bed = PATH + "{sample}/sv/straglr/{sample}_straglr.bed",
        tsv = PATH + "{sample}/sv/straglr/{sample}_straglr.tsv"
    params:
        prefix = PATH + "{sample}/sv/straglr/{sample}_straglr"
    conda:
        CONDAENV + "straglr.yaml"
    shell:
        """
        python /path/to/straglr/straglr.py {input.bam} {input.ref} {params.prefix} \
            --min_str_len 2 --min_support 1 --min_ins_size 1 --include_partials \
            --nprocs {THREADS} --max_str_len 100000 --use_unpaired_clips \
            --max_num_clusters 10 --min_cluster_d 1 --regions {BED}
        """

rule sv_annotation_stranger:
    input:
        vcf = rules.straglr.output.vvf
    output:
        annotated = PATH + "{sample}/sv/straglr/{sample}_straglr.annotated.vcf"
    conda:
        CONDAENV + "stranger.yaml"
    shell:
        """
        stranger annotate --vcf {input.vcf} --output {output.annotated}
        """

#####################################################################
# needLR — population-AF filter ONLY (ONT-native 1KGP-LRSC cohort). #
# Its OMIM/HPO/GenCC gene columns are NOT used downstream — AnnotSV #
# is the single source of truth for gene/disease annotation, to     #
# avoid two competing "final" annotation tables.                    #
#####################################################################

rule needlr_annotation:
    input:
        vcf = rules.jasmine_merge.output.vcf
    output:
        tsv = PATH + "{sample}/sv/needlr/{sample}_needLR_RESULTS.tsv",
        vcf = PATH + "{sample}/sv/needlr/{sample}_needLR_RESULTS.vcf.gz"
    params:
        outdir = PATH + "{sample}/sv/needlr",
        backend_flag = lambda wc: f"-B {NEEDLR_BACKEND}" if NEEDLR_BACKEND else ""
    conda:
        CONDAENV + "needlr.yaml"
    shell:
        """
        needLR annotate -O {params.outdir} -T {THREADS} {params.backend_flag} \
            --all {input.vcf}
        cp {params.outdir}/*/*_RESULTS.tsv {output.tsv}
        cp {params.outdir}/*/*_RESULTS.vcf.gz {output.vcf}
        """

##########################################################################
# AnnotSV — single primary clinical/gene annotation + panel filter step  #
# (gene overlap, regulatory context, ClinVar-SV, gnomAD-SV, OMIM morbid  #
# gene flag, ACMG-SV ranking, candidate-gene-panel filtering)            #
##########################################################################

rule annotsv_annotation:
    input:
        vcf = rules.needlr_annotation.output.vcf   # AF-filtered upstream of clinical annotation
    output:
        tsv = PATH + "{sample}/sv/annotsv/{sample}_merged_SV.annotsv.tsv"
    params:
        outdir = PATH + "{sample}/sv/annotsv"
    conda:
        CONDAENV + "annotsv.yaml"
    shell:
        """
        AnnotSV -SVinputFile {input.vcf} \
            -outputDir {params.outdir} \
            -outputFile {wildcards.sample}_merged_SV.annotsv.tsv \
            -genomeBuild GRCh38 \
            -candidateGenesFile {GENE_LIST}
        """

##################################################################
# VEP — transcript-level consequence detail on the AnnotSV-      #
# prioritized set (which exon/intron is disrupted, frameshift    #
# likelihood, canonical-transcript hit). Complements AnnotSV      #
# rather than duplicating it.                                    #
##################################################################

rule vep_sv_annotation:
    input:
        vcf = rules.needlr_annotation.output.vcf
    output:
        txt = PATH + "{sample}/sv/vep/{sample}_SV_VEP.txt"
    conda:
        CONDAENV + "vep.yaml"
    shell:
        """
        vep --input_file {input.vcf} --format vcf \
            --output_file {output.txt} \
            --cache --offline --dir_cache {VEP_CACHE_DIR} --assembly {VEP_ASSEMBLY} \
            --canonical --overlaps --pick --symbol --biotype \
            --max_sv_size 250000000 --batch_size 100
        """

##################################################################
# Methylation                                                    #
##################################################################

rule modkit_extract:
    input:
        bam = lambda wc: BAMS[wc.sample],
        ref = REF
    output:
        tsv = PATH + "{sample}/methylation/{sample}.modkit.tsv"
    conda:
        CONDAENV + "modkit.yaml"
    shell:
        """
        {MODKITENV} extract calls -t {THREADS} --reference {input.ref} --cpg --region {CPG} {input.bam} {output.tsv}
        """

#####################################################
# mtDNA rearrangements                               #
#####################################################

rule eklipse_mtdna:
    input:
        bam = lambda wc: BAMS[wc.sample],
        ref = REF
    output:
        csv = PATH + "{sample}/mtdna/eklipse/{sample}_eKLIPse.csv"
    params:
        outdir = PATH + "{sample}/mtdna/eklipse"
    conda:
        CONDAENV + "eklipse.yaml"
    shell:
        """
        python /path/to/eKLIPse/eKLIPse.py -in {input.bam} -ref {input.ref} \
            -out {params.outdir}
        cp {params.outdir}/*_eKLIPse.csv {output.csv}
        """


########################################################################
# OPTIONAL / ON-DEMAND rules — not in rule all, not run by default.    #
# Use these only when a specific candidate SV (e.g. an OPA1 locus)     #
# needs deeper confirmation.                                           #
########################################################################

if RUN_TLDR_CONFIRMATION:

    rule longphase_phasing_ondemand:
        # SV-aware joint SNP+SV phasing, for a specific candidate locus only.
        input:
            vcf = rules.clair3_snp_calling.output.vcf,
            sv_vcf = rules.sniffles2_sv.output.vcf,
            bam = lambda wc: BAMS[wc.sample],
            ref = REF
        output:
            vcf = PATH + "{sample}/phasing_longphase/{sample}.longphase.vcf.gz"
        params:
            prefix = PATH + "{sample}/phasing_longphase/{sample}.longphase"
        conda:
            CONDAENV + "longphase.yaml"
        shell:
            """
            longphase phase -s {input.vcf} --sv-file {input.sv_vcf} \
                -b {input.bam} -r {input.ref} -t {THREADS} -o {params.prefix}
            bgzip -f {params.prefix}.vcf
            tabix -p vcf {output.vcf}
            """

    rule tldr_mei_confirmation:
        input:
            bam = lambda wc: BAMS[wc.sample],
            ref = REF
        output:
            table = PATH + "{sample}/mei/tldr/{sample}.tldr.table.txt"
        params:
            outdir = PATH + "{sample}/mei/tldr"
        conda:
            CONDAENV + "tldr.yaml"
        shell:
            """
            tldr -b {input.bam} -r {input.ref} -e {TLDR_ELTS} \
                -p {THREADS} --outdir {params.outdir}
            cp {params.outdir}/*.table.txt {output.table}
            """
