configfile: "config_lrs.yaml"

SAMPLES = list(config["samples"].keys())
BAMS = config["samples"]
PATH = config["path"].rstrip("/") + "/"
REF = config["ref"]
THREADS = config["threads"]
BED = config["bed"]
STRAGLR_BED = config.get("straglr_bed")
STRAGLR_REGIONS = f"--regions {STRAGLR_BED}" if STRAGLR_BED else ""
GENE_LIST = config["candidate_genes_list"]
CONDAENV = config["condaenv"]
MODKITENV = config["modkitenv"]
CLAIRENV = config["clair3env"]
TLDR_ELTS = config["tldr_elements"]
VNTR_BED = config["vntr_bed"]

# needLR: ONT-native population-AF filtering only
NEEDLR_BACKEND = config.get("needlr_backend_files")

# Gene/HPO discovery
MONARCH_BASE_URL = config.get(
    "monarch_base_url",
    "https://api-v3.monarchinitiative.org/v3/api",
)
DISCOVERY_HPO_FILE = config.get(
    "discovery_hpo_file",
    "reference/optic_neuropathy_hpo_terms.tsv",
)

# AnnotSV
ANNOTSV_BENIGN_AF = config.get("annotsv_benign_af", 0.01)
HPO_TERMS = config.get("hpo_terms")
ANNOTSV_ANNOTATIONS_DIR = config.get(
    "annotsv_annotations_dir",
    PATH + "reference/AnnotSV_annotations",
)

# Sniffles2 / DELLY / STRAGLR
SNIFFLES_MOSAIC = config.get("sniffles_mosaic", False)
SNIFFLES_MOSAIC_FLAG = "--mosaic" if SNIFFLES_MOSAIC else ""
DELLY_GENOME = config.get("delly_genome", "ont")
STRAGLR_SCRIPT = config.get("straglr_script", "straglr.py")

# Methylation region (optional). Use cpg_region in config for a genomic region.
CPG_REGION = config.get("cpg_region")
CPG_REGION_FLAG = f"--region {CPG_REGION}" if CPG_REGION else ""

# VEP
VEP_CACHE_DIR = config["vep_cache_dir"]
VEP_ASSEMBLY = config.get("vep_assembly", "GRCh38")

# Python scripts: anchor to the Snakefile location rather than current working directory.
SCRIPTS = os.path.abspath(os.path.join(workflow.basedir, "../../scripts"))


rule all:
    input:
        # QC
        expand(
            PATH + "{sample}/coverage/{sample}.mosdepth.global.dist.txt",
            sample=SAMPLES,
        ),

        # Small variants + phasing
        expand(
            PATH + "{sample}/snp_clair3/{sample}.vcf.gz",
            sample=SAMPLES,
        ),
        expand(
            PATH + "{sample}/phasing/{sample}.phased.vcf.gz",
            sample=SAMPLES,
        ),
        expand(
            PATH + "{sample}/phasing/{sample}.phased.bam",
            sample=SAMPLES,
        ),

        # SV calling + merge
        expand(
            PATH + "{sample}/sv/sniffles2/{sample}_sniffles.vcf",
            sample=SAMPLES,
        ),
        expand(
            PATH + "{sample}/sv/cutesv/{sample}_cutesv.vcf",
            sample=SAMPLES,
        ),
        expand(
            PATH + "{sample}/sv/delly/{sample}_delly.vcf",
            sample=SAMPLES,
        ),
        expand(
            PATH + "{sample}/sv/merged/{sample}_merged_SV.vcf",
            sample=SAMPLES,
        ),

        # Insertion / MEI mechanism classification
        expand(
            PATH + "{sample}/sv/insertions/{sample}_repeatmasker.out",
            sample=SAMPLES,
        ),

        # Repeat expansion
        expand(
            PATH + "{sample}/sv/straglr/{sample}_straglr.vcf",
            sample=SAMPLES,
        ),
        expand(
            PATH + "{sample}/sv/straglr/{sample}_straglr.bed",
            sample=SAMPLES,
        ),
        expand(
            PATH + "{sample}/sv/straglr/{sample}_straglr.tsv",
            sample=SAMPLES,
        ),
        expand(
            PATH + "{sample}/sv/straglr/{sample}_straglr.annotated.tsv",
            sample=SAMPLES,
        ),

        # Population-AF filtering
        expand(
            PATH + "{sample}/sv/needlr/{sample}_needLR_RESULTS.vcf.gz",
            sample=SAMPLES,
        ),

        # AnnotSV + panel-only view
        expand(
            PATH + "{sample}/sv/annotsv/{sample}_merged_SV.annotsv.tsv",
            sample=SAMPLES,
        ),
        expand(
            PATH + "{sample}/sv/annotsv/{sample}_merged_SV.annotsv.panel_only.tsv",
            sample=SAMPLES,
        ),

        # Gene discovery
        expand(
            PATH + "{sample}/gene_discovery/{sample}_SV_genes.txt",
            sample=SAMPLES,
        ),
        expand(
            PATH + "{sample}/gene_discovery/{sample}_nonpanel_genes.txt",
            sample=SAMPLES,
        ),
        expand(
            PATH + "{sample}/gene_discovery/{sample}_human_gene_phenotypes.tsv",
            sample=SAMPLES,
        ),
        expand(
            PATH + "{sample}/gene_discovery/{sample}_ranked_candidates.tsv",
            sample=SAMPLES,
        ),
        expand(
            PATH + "{sample}/gene_discovery/{sample}_integrated_SV_gene_analysis.tsv",
            sample=SAMPLES,
        ),

        # VEP + panel-only view
        expand(
            PATH + "{sample}/sv/vep/{sample}_SV_VEP.txt",
            sample=SAMPLES,
        ),
        expand(
            PATH + "{sample}/sv/vep/{sample}_SV_VEP.panel_only.txt",
            sample=SAMPLES,
        ),

        # Methylation
        expand(
            PATH + "{sample}/methylation/{sample}.modkit.tsv",
            sample=SAMPLES,
        ),

        # SV-aware phasing
        expand(
            PATH + "{sample}/phasing_longphase/{sample}.longphase.vcf.gz",
            sample=SAMPLES,
        ),

        # Confirmatory MEI calling
        expand(
            PATH + "{sample}/mei/tldr/{sample}.tldr.table.txt",
            sample=SAMPLES,
        )


################
# QC           #
################

rule mosdepth_coverage:
    input:
        bam=lambda wc: BAMS[wc.sample]
    output:
        PATH + "{sample}/coverage/{sample}.mosdepth.global.dist.txt"
    conda:
        CONDAENV + "mosdepth.yaml"
    shell:
        """
        mkdir -p $(dirname {output})
        mosdepth -t {THREADS} {PATH}{wildcards.sample}/coverage/{wildcards.sample} {input.bam}
        """


##################################
# Small variant calling (control)
##################################

rule clair3_snp_calling:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        vcf=PATH + "{sample}/snp_clair3/{sample}.vcf.gz"
    conda:
        CONDAENV + "clair3.yaml"
    shell:
        """
        mkdir -p {PATH}{wildcards.sample}/snp_clair3
        run_clair3.sh \
            -b {input.bam} \
            -f {input.ref} \
            -t {THREADS} \
            -p ont \
            -o {PATH}{wildcards.sample}/snp_clair3 \
            -m {CLAIRENV} \
            --bed_fn={BED}

        cp {PATH}{wildcards.sample}/snp_clair3/merge_output.vcf.gz {output.vcf}
        tabix -f -p vcf {output.vcf}
        """


rule whatsHap_phasing:
    input:
        vcf=rules.clair3_snp_calling.output.vcf,
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        phased=PATH + "{sample}/phasing/{sample}.phased.vcf.gz",
        haplotag=PATH + "{sample}/phasing/{sample}.phased.bam"
    conda:
        CONDAENV + "whatshap.yaml"
    shell:
        """
        mkdir -p {PATH}{wildcards.sample}/phasing

        whatshap phase \
            --reference {input.ref} \
            -o {output.phased} \
            {input.vcf} \
            {input.bam} \
            --ignore-read-groups

        tabix -f -p vcf {output.phased}

        whatshap haplotag \
            -o {output.haplotag} \
            --reference {input.ref} \
            {output.phased} \
            {input.bam} \
            --ignore-read-groups

        samtools index -f {output.haplotag}
        """


########################
# SV calling + merge   #
########################

rule sniffles2_sv:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        vcf=PATH + "{sample}/sv/sniffles2/{sample}_sniffles.vcf"
    conda:
        CONDAENV + "sniffles2.yaml"
    shell:
        """
        mkdir -p {PATH}{wildcards.sample}/sv/sniffles2

        sniffles \
            --input {input.bam} \
            --vcf {output.vcf} \
            --reference {input.ref} \
            --threads {THREADS} \
            --minsupport 2 \
            --no-qc \
            {SNIFFLES_MOSAIC_FLAG} \
            --allow-overwrite \
            --min-alignment-length 100 \
            --output-rnames \
            --tandem-repeats {VNTR_BED}
        """


rule cutesv:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        vcf=PATH + "{sample}/sv/cutesv/{sample}_cutesv.vcf"
    conda:
        CONDAENV + "cutesv.yaml"
    shell:
        """
        mkdir -p {PATH}{wildcards.sample}/sv/cutesv

        cuteSV \
            {input.bam} \
            {input.ref} \
            {output.vcf} \
            {PATH}{wildcards.sample}/sv/cutesv \
            --threads {THREADS} \
            --max_cluster_bias_INS 100 \
            --diff_ratio_merging_INS 0.3 \
            --max_cluster_bias_DEL 100 \
            --diff_ratio_merging_DEL 0.3 \
            --min_support 2 \
            --min_size 50 \
            --min_mapq 20 \
            --min_read_len 500 \
            --genotype
        """


rule delly_lr:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        bcf=PATH + "{sample}/sv/delly/{sample}_delly.bcf",
        vcf=PATH + "{sample}/sv/delly/{sample}_delly.vcf"
    params:
        outdir=PATH + "{sample}/sv/delly"
    conda:
        CONDAENV + "delly.yaml"
    shell:
        """
        mkdir -p {params.outdir}

        delly lr \
            -y {DELLY_GENOME} \
            -g {input.ref} \
            -o {output.bcf} \
            {input.bam}

        bcftools view \
            {output.bcf} \
            -Ov \
            -o {output.vcf}
        """


rule jasmine_merge:
    input:
        sniffles=rules.sniffles2_sv.output.vcf,
        cutesv=rules.cutesv.output.vcf,
        delly=rules.delly_lr.output.vcf
    output:
        list_file=PATH + "{sample}/sv/merged/{sample}_vcf_list.txt",
        vcf=PATH + "{sample}/sv/merged/{sample}_merged_SV.vcf"
    params:
        outdir=PATH + "{sample}/sv/merged"
    conda:
        CONDAENV + "jasmine.yaml"
    shell:
        """
        mkdir -p {params.outdir}

        printf "%s\\n%s\\n%s\\n" \
            {input.sniffles} \
            {input.cutesv} \
            {input.delly} \
            > {output.list_file}

        jasmine \
            file_list={output.list_file} \
            out_file={output.vcf} \
            threads={THREADS} \
            --allow_intrasample \
            --output_genotypes
        """


##################################################################
# Insertion sequence extraction + TE/mechanism classification
##################################################################

rule extract_insertion_seqs:
    input:
        vcf=rules.jasmine_merge.output.vcf
    output:
        fasta=PATH + "{sample}/sv/insertions/{sample}_insertions.fasta"
    conda:
        CONDAENV + "annotsv.yaml"
    shell:
        """
        mkdir -p {PATH}{wildcards.sample}/sv/insertions

        bcftools view -i 'INFO/SVTYPE="INS"' {input.vcf} | \
        bcftools query -f '>%ID\\n%ALT\\n' - | \
        sed 's/,.*$//' > {output.fasta}
        """


rule repeatmasker_classify:
    input:
        fasta=rules.extract_insertion_seqs.output.fasta
    output:
        out=PATH + "{sample}/sv/insertions/{sample}_repeatmasker.out"
    params:
        outdir=PATH + "{sample}/sv/insertions"
    conda:
        CONDAENV + "repeatmasker.yaml"
    shell:
        """
        mkdir -p {params.outdir}

        if [ ! -s {input.fasta} ]; then
            touch {output.out}
        else
            RepeatMasker \
                -species human \
                -pa {THREADS} \
                -dir {params.outdir} \
                {input.fasta}

            test -f {params.outdir}/{wildcards.sample}_insertions.fasta.out
            mv {params.outdir}/{wildcards.sample}_insertions.fasta.out {output.out}
        fi
        """


##################################################################
# Repeat expansion classification and annotation
##################################################################

rule straglr:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        vcf=PATH + "{sample}/sv/straglr/{sample}_straglr.vcf",
        bed=PATH + "{sample}/sv/straglr/{sample}_straglr.bed",
        tsv=PATH + "{sample}/sv/straglr/{sample}_straglr.tsv"
    params:
        prefix=PATH + "{sample}/sv/straglr/{sample}_straglr"
    conda:
        CONDAENV + "straglr.yaml"
    shell:
        """
        mkdir -p {PATH}{wildcards.sample}/sv/straglr

        {STRAGLR_SCRIPT} \
            {input.bam} \
            {input.ref} \
            {params.prefix} \
            --min_str_len 2 \
            --min_support 1 \
            --min_ins_size 1 \
            --include_partials \
            --nprocs {THREADS} \
            --max_str_len 100000 \
            --use_unpaired_clips \
            --max_num_clusters 10 \
            --min_cluster_d 1 \
            {STRAGLR_REGIONS}
        """


rule straglr_annotation:
    input:
        tsv=rules.straglr.output.tsv,
        bed=rules.straglr.output.bed,
        genes=config["gene_bed"]
    output:
        tsv=PATH + "{sample}/sv/straglr/{sample}_straglr.annotated.tsv"
    conda:
        CONDAENV + "straglr.yaml"
    shell:
        """
        mkdir -p {PATH}{wildcards.sample}/sv/straglr

        python {SCRIPTS}/annotate_straglr.py \
            --straglr-tsv {input.tsv} \
            --straglr-bed {input.bed} \
            --gene-bed {input.genes} \
            --output {output.tsv}
        """


#####################################################################
# needLR — ONT-native population/reference SV annotation/filtering #
#####################################################################

rule needlr_annotation:
    input:
        vcf=rules.jasmine_merge.output.vcf
    output:
        tsv=PATH + "{sample}/sv/needlr/{sample}_needLR_RESULTS.tsv",
        vcf=PATH + "{sample}/sv/needlr/{sample}_needLR_RESULTS.vcf.gz"
    params:
        outdir=PATH + "{sample}/sv/needlr",
        backend_flag=lambda wc: f"-B {NEEDLR_BACKEND}" if NEEDLR_BACKEND else ""
    conda:
        CONDAENV + "needlr.yaml"
    shell:
        """
        mkdir -p {params.outdir}

        needLR annotate \
            -O {params.outdir} \
            -T {THREADS} \
            {params.backend_flag} \
            --all \
            {input.vcf}

        results_tsv=$(find {params.outdir} -type f -name '*_RESULTS.tsv' -print -quit)
        results_vcf=$(find {params.outdir} -type f -name '*_RESULTS.vcf.gz' -print -quit)

        test -n "$results_tsv"
        test -n "$results_vcf"

        cp "$results_tsv" {output.tsv}
        cp "$results_vcf" {output.vcf}
        tabix -f -p vcf {output.vcf}
        """


##########################################################################
# AnnotSV — full annotation is the source of truth; panel-only is a view #
##########################################################################

rule annotsv_install_annotations:
    output:
        marker=ANNOTSV_ANNOTATIONS_DIR + "/.installed"
    conda:
        CONDAENV + "annotsv.yaml"
    shell:
        """
        mkdir -p {ANNOTSV_ANNOTATIONS_DIR}
        cd {ANNOTSV_ANNOTATIONS_DIR}
        INSTALL_annotations.sh
        touch {output.marker}
        """


rule annotsv_annotation:
    input:
        vcf=rules.needlr_annotation.output.vcf,
        annotations=rules.annotsv_install_annotations.output.marker
    output:
        tsv=PATH + "{sample}/sv/annotsv/{sample}_merged_SV.annotsv.tsv"
    params:
        outdir=PATH + "{sample}/sv/annotsv",
        hpo_flag=lambda wc: f"-hpo {HPO_TERMS}" if HPO_TERMS else ""
    conda:
        CONDAENV + "annotsv.yaml"
    shell:
        """
        mkdir -p {params.outdir}

        AnnotSV \
            -SVinputFile {input.vcf} \
            -annotationsDir {ANNOTSV_ANNOTATIONS_DIR} \
            -outputDir {params.outdir} \
            -outputFile {wildcards.sample}_merged_SV.annotsv.tsv \
            -genomeBuild GRCh38 \
            -candidateGenesFile {GENE_LIST} \
            -candidateGenesFiltering 0 \
            -benignAF {ANNOTSV_BENIGN_AF} \
            {params.hpo_flag}
        """


rule annotsv_annotation_panel_only:
    input:
        vcf=rules.needlr_annotation.output.vcf,
        annotations=rules.annotsv_install_annotations.output.marker,
        genes=GENE_LIST
    output:
        tsv=PATH + "{sample}/sv/annotsv/{sample}_merged_SV.annotsv.panel_only.tsv"
    params:
        outdir=PATH + "{sample}/sv/annotsv"
    conda:
        CONDAENV + "annotsv.yaml"
    shell:
        """
        mkdir -p {params.outdir}

        AnnotSV \
            -SVinputFile {input.vcf} \
            -annotationsDir {ANNOTSV_ANNOTATIONS_DIR} \
            -outputDir {params.outdir} \
            -outputFile {wildcards.sample}_merged_SV.annotsv.panel_only.tsv \
            -genomeBuild GRCh38 \
            -candidateGenesFile {input.genes} \
            -candidateGenesFiltering 1 \
            -benignAF {ANNOTSV_BENIGN_AF}
        """


#####################################
# Genome-wide human gene discovery #
#####################################

rule extract_sv_genes:
    input:
        annotsv=rules.annotsv_annotation.output.tsv
    output:
        genes=PATH + "{sample}/gene_discovery/{sample}_SV_genes.txt"
    conda:
        CONDAENV + "monarch.yaml"
    shell:
        """
        mkdir -p {PATH}{wildcards.sample}/gene_discovery
        python {SCRIPTS}/extract_annotsv_genes.py \
            --annotsv {input.annotsv} \
            --output {output.genes}
        """


rule extract_nonpanel_genes:
    input:
        genes=rules.extract_sv_genes.output.genes,
        panel=GENE_LIST
    output:
        genes=PATH + "{sample}/gene_discovery/{sample}_nonpanel_genes.txt"
    conda:
        CONDAENV + "monarch.yaml"
    shell:
        """
        python {SCRIPTS}/extract_nonpanel_genes.py \
            --genes {input.genes} \
            --panel {input.panel} \
            --output {output.genes}
        """


rule human_gene_phenotypes:
    input:
        genes=rules.extract_nonpanel_genes.output.genes,
        hpo=DISCOVERY_HPO_FILE
    output:
        tsv=PATH + "{sample}/gene_discovery/{sample}_human_gene_phenotypes.tsv"
    params:
        api=MONARCH_BASE_URL
    conda:
        CONDAENV + "monarch.yaml"
    shell:
        """
        python {SCRIPTS}/monarch_human_gene_phenotypes.py \
            --genes {input.genes} \
            --hpo-anchors {input.hpo} \
            --output {output.tsv} \
            --api-base {params.api}
        """


rule rank_genomewide_candidates:
    input:
        annotsv=rules.annotsv_annotation.output.tsv,
        genes=rules.extract_nonpanel_genes.output.genes,
        phenotypes=rules.human_gene_phenotypes.output.tsv,
        panel=GENE_LIST
    output:
        tsv=PATH + "{sample}/gene_discovery/{sample}_ranked_candidates.tsv"
    conda:
        CONDAENV + "monarch.yaml"
    shell:
        """
        python {SCRIPTS}/rank_sv_gene_candidates.py \
            --annotsv {input.annotsv} \
            --genes {input.genes} \
            --phenotypes {input.phenotypes} \
            --panel {input.panel} \
            --output {output.tsv}
        """


##############################
# INTEGRATION OF INFO
##############################

rule integrated_sv_gene_table:
    input:
        vcf=rules.jasmine_merge.output.vcf,
        annotsv=rules.annotsv_annotation.output.tsv,
        needlr=rules.needlr_annotation.output.tsv,
        ranking=rules.rank_genomewide_candidates.output.tsv,
        panel=GENE_LIST,
        sniffles=rules.sniffles2_caller_parse.output.tsv,
        cutesv=rules.cutesv_caller_parse.output.tsv,
        delly=rules.delly_caller_parse.output.tsv
    output:
        tsv=PATH + "{sample}/gene_discovery/{sample}_integrated_SV_gene_analysis.tsv"
    conda:
        CONDAENV + "monarch.yaml"
    shell:
        """
        mkdir -p $(dirname {output.tsv})

        python {SCRIPTS}/build_integrated_sv_gene_tsv.py \
            --vcf {input.vcf} \
            --annotsv {input.annotsv} \
            --needlr {input.needlr} \
            --ranking {input.ranking} \
            --panel {input.panel} \
            --caller-tsv {input.sniffles} \
            --caller-tsv {input.cutesv} \
            --caller-tsv {input.delly} \
            --output {output.tsv}
        """


##################################################################
# VEP — full transcript-level annotation + panel-only derived view
##################################################################

rule vep_sv_annotation:
    input:
        vcf=rules.needlr_annotation.output.vcf
    output:
        txt=PATH + "{sample}/sv/vep/{sample}_SV_VEP.txt"
    conda:
        CONDAENV + "vep.yaml"
    shell:
        """
        mkdir -p {PATH}{wildcards.sample}/sv/vep

        vep \
            --input_file {input.vcf} \
            --format vcf \
            --output_file {output.txt} \
            --cache \
            --offline \
            --dir_cache {VEP_CACHE_DIR} \
            --assembly {VEP_ASSEMBLY} \
            --canonical \
            --overlaps \
            --pick \
            --symbol \
            --biotype \
            --max_sv_size 250000000 \
            --batch_size 100 \
            --fork {THREADS}
        """


rule vep_sv_annotation_panel_only:
    input:
        txt=rules.vep_sv_annotation.output.txt,
        genes=GENE_LIST
    output:
        txt=PATH + "{sample}/sv/vep/{sample}_SV_VEP.panel_only.txt"
    shell:
        """
        python {SCRIPTS}/filter_vep_panel.py \
            --vep {input.txt} \
            --genes {input.genes} \
            --output {output.txt}
        """


