configfile: "config_lrs.yaml"

SAMPLES    = list(config["samples"].keys())
BAMS       = config["samples"]
PATH       = config["path"]
REF        = config["ref"]
THREADS    = config["threads"]
BED        = config["bed"]                    # panel regions (Clair3 target + optional panel-only views)
STRAGLR_BED = config.get("straglr_bed", None)
STRAGLR_REGIONS = f"--regions {STRAGLR_BED}" if STRAGLR_BED else "" # for straglr
GENE_LIST  = config["candidate_genes_list"]   # optic-neuropathy / mito-disease panel gene symbols
CPG        = config["cpg"]
CONDAENV   = config["condaenv"]
MODKITENV  = config["modkitenv"]
CLAIRENV   = config["clair3env"]

TLDR_ELTS  = config["tldr_elements"]

VNTR_BED   = config["vntr_bed"]               # reference-wide VNTR bed for Sniffles2

# --- needLR: ONT-native population-AF filtering only ---
NEEDLR_BACKEND = config.get("needlr_backend_files", None)

MONARCH_BASE_URL = config.get("monarch_base_url", "https://api-v3.monarchinitiative.org/v3/api")
DISCOVERY_HPO_FILE = config.get("discovery_hpo_file", "reference/optic_neuropathy_hpo_terms.tsv")
ANNOTSV_BENIGN_AF = config.get("annotsv_benign_af", 0.01)
SNIFFLES_MOSAIC = config.get("sniffles_mosaic", False)
SNIFFLES_MOSAIC_FLAG = "--mosaic" if SNIFFLES_MOSAIC else ""
CPG_REGION = config.get("cpg", None)
CPG_FLAG = f"--region {CPG_REGION}" if CPG_REGION else ""
STRAGLR_SCRIPT = config.get("straglr_script", "straglr.py")

# --- AnnotSV ---
HPO_TERMS = config.get("hpo_terms", None)
ANNOTSV_ANNOTATIONS_DIR = config.get(
    "annotsv_annotations_dir",
    PATH + "reference/AnnotSV_annotations"
)

# --- VEP ---
VEP_CACHE_DIR  = config["vep_cache_dir"]
VEP_ASSEMBLY   = config.get("vep_assembly", "GRCh38")


rule all:
    input:
        # QC
        expand(PATH + "{sample}/coverage/{sample}.mosdepth.global.dist.txt", sample=SAMPLES),

        # small variants + phasing (control track; Clair3 remains panel-targeted)
        expand(PATH + "{sample}/snp_clair3/{sample}.vcf.gz", sample=SAMPLES),
        expand(PATH + "{sample}/phasing/{sample}.phased.vcf.gz", sample=SAMPLES),
        expand(PATH + "{sample}/phasing/{sample}.phased.bam", sample=SAMPLES),

        # SV calling + merge
        expand(PATH + "{sample}/sv/sniffles2/{sample}_sniffles.vcf", sample=SAMPLES),
        expand(PATH + "{sample}/sv/cutesv/{sample}_cutesv.vcf", sample=SAMPLES),
        expand(PATH + "{sample}/sv/merged/{sample}_merged_SV.vcf", sample=SAMPLES),

        # insertion / MEI mechanism classification
        expand(PATH + "{sample}/sv/insertions/{sample}_repeatmasker.out", sample=SAMPLES),

       # repeat expansion
        expand(PATH + "{sample}/sv/straglr/{sample}_straglr.vcf", sample=SAMPLES),
        expand(PATH + "{sample}/sv/straglr/{sample}_straglr.bed", sample=SAMPLES),
        expand(PATH + "{sample}/sv/straglr/{sample}_straglr.tsv", sample=SAMPLES),
        expand(PATH + "{sample}/sv/straglr/{sample}_straglr.annotated.tsv", sample=SAMPLES),

        # population-AF filtering
        expand(PATH + "{sample}/sv/needlr/{sample}_needLR_RESULTS.vcf.gz", sample=SAMPLES),

        # genome-wide clinical/gene annotation + panel-only derived view
        expand(PATH + "{sample}/sv/annotsv/{sample}_merged_SV.annotsv.tsv", sample=SAMPLES),
        expand(PATH + "{sample}/sv/annotsv/{sample}_merged_SV.annotsv.panel_only.tsv", sample=SAMPLES),
        expand(PATH + "{sample}/gene_discovery/{sample}_SV_genes.txt", sample=SAMPLES),
        expand(PATH + "{sample}/gene_discovery/{sample}_nonpanel_genes.txt", sample=SAMPLES),
        expand(PATH + "{sample}/gene_discovery/{sample}_human_gene_phenotypes.tsv", sample=SAMPLES),
        expand(PATH + "{sample}/gene_discovery/{sample}_ranked_candidates.tsv", sample=SAMPLES),

        # genome-wide transcript annotation + panel-only derived view
        expand(PATH + "{sample}/sv/vep/{sample}_SV_VEP.txt", sample=SAMPLES),
        expand(PATH + "{sample}/sv/vep/{sample}_SV_VEP.panel_only.txt", sample=SAMPLES),

        # methylation
        expand(PATH + "{sample}/methylation/{sample}.modkit.tsv", sample=SAMPLES),

        # SV-aware phasing + confirmatory MEI calling
        expand(PATH + "{sample}/phasing_longphase/{sample}.longphase.vcf.gz", sample=SAMPLES),
        expand(PATH + "{sample}/mei/tldr/{sample}.tldr.table.txt", sample=SAMPLES)


################
# QC           #
################

rule mosdepth_coverage:
    input:
        lambda wc: BAMS[wc.sample]
    output:
        PATH + "{sample}/coverage/{sample}.mosdepth.global.dist.txt"
    conda:
        CONDAENV + "mosdepth.yaml"
    shell:
        """
        mosdepth -t {THREADS} {PATH}/{wildcards.sample}/coverage/{wildcards.sample} {input}
        """


##################################
# Small variant calling (control) #
##################################

rule clair3_snp_calling:
    input:
        bam = lambda wc: BAMS[wc.sample],
        ref = REF
    output:
        vcf = PATH + "{sample}/snp_clair3/{sample}.vcf.gz"
    conda:
        CONDAENV + "clair3.yaml"
    shell:
        """
        run_clair3.sh -b {input.bam} -f {input.ref} -t {THREADS} -p ont \
            -o {PATH}/{wildcards.sample}/snp_clair3 \
            -m {CLAIRENV} \
            --bed_fn={BED}

        cp {PATH}/{wildcards.sample}/snp_clair3/merge_output.vcf.gz {output.vcf}
        tabix -p vcf {output.vcf}
        """


rule whatsHap_phasing:
    input:
        vcf = rules.clair3_snp_calling.output.vcf,
        bam = lambda wc: BAMS[wc.sample],
        ref = REF
    output:
        phased = PATH + "{sample}/phasing/{sample}.phased.vcf.gz",
        haplotag = PATH + "{sample}/phasing/{sample}.phased.bam"
    conda:
        CONDAENV + "whatshap.yaml"
    shell:
        """
        whatshap phase --reference {input.ref} -o {output.phased} {input.vcf} {input.bam} --ignore-read-groups
        tabix -p vcf {output.phased}

        whatshap haplotag -o {output.haplotag} --reference {input.ref} \
            {output.phased} {input.bam} --ignore-read-groups
        samtools index {output.haplotag}
        """


########################
# SV calling + merge   #
########################

rule sniffles2_sv:
    input:
        bam = lambda wc: BAMS[wc.sample],
        ref = REF
    output:
        vcf = PATH + "{sample}/sv/sniffles2/{sample}_sniffles.vcf"
    conda:
        CONDAENV + "sniffles2.yaml"
    shell:
        """
        sniffles --input {input.bam} --vcf {output.vcf} --reference {input.ref} --threads {THREADS} \
            --minsupport 2 --no-qc {SNIFFLES_MOSAIC_FLAG} --allow-overwrite --min-alignment-length 100 \
            --output-rnames --tandem-repeats {VNTR_BED}
        """


rule cutesv:
    input:
        bam = lambda wc: BAMS[wc.sample],
        ref = REF
    output:
        vcf = PATH + "{sample}/sv/cutesv/{sample}_cutesv.vcf"
    conda:
        CONDAENV + "cutesv.yaml"
    shell:
        """
        cuteSV {input.bam} {input.ref} {output.vcf} {PATH}/{wildcards.sample}/sv/cutesv --threads {THREADS} \
            --max_cluster_bias_INS 100 --diff_ratio_merging_INS 0.3 \
            --max_cluster_bias_DEL 100 --diff_ratio_merging_DEL 0.3 \
            --min_support 2 --genotype
        """


rule jasmine_merge:
    input:
        sniffles = rules.sniffles2_sv.output.vcf,
        cutesv   = rules.cutesv.output.vcf
    output:
        list_file = PATH + "{sample}/sv/merged/{sample}_vcf_list.txt",
        vcf = PATH + "{sample}/sv/merged/{sample}_merged_SV.vcf"
    conda:
        CONDAENV + "jasmine.yaml"
    shell:
        """
        printf "%s\\n%s\\n" {input.sniffles} {input.cutesv} > {output.list_file}

        jasmine file_list={output.list_file} out_file={output.vcf} \
            threads={THREADS} --allow_intrasample --output_genotypes
        """


###########################################################################
# Insertion sequence extraction + TE/mechanism classification (RepeatMasker)
###########################################################################

rule extract_insertion_seqs:
    input:
        vcf = rules.jasmine_merge.output.vcf
    output:
        fasta = PATH + "{sample}/sv/insertions/{sample}_insertions.fasta"
    conda:
        CONDAENV + "annotsv.yaml"
    shell:
        """
        bcftools view -i 'INFO/SVTYPE="INS"' {input.vcf} | \
        bcftools query -f '>%ID\\n%ALT\\n' - | \
        sed 's/,.*$//' > {output.fasta}
        """


rule repeatmasker_classify:
    input:
        fasta = rules.extract_insertion_seqs.output.fasta
    output:
        out = PATH + "{sample}/sv/insertions/{sample}_repeatmasker.out"
    params:
        outdir = PATH + "{sample}/sv/insertions"
    conda:
        CONDAENV + "repeatmasker.yaml"
    shell:
        """
        RepeatMasker -species human -pa {THREADS} -dir {params.outdir} {input.fasta}
        mv {params.outdir}/{wildcards.sample}_insertions.fasta.out {output.out}
        """


##################################################################
# Repeat expansion classification and annotation
##################################################################
# Verify if any tandem repeats exists i the locus of genes
#
rule straglr:
    input:
        bam = lambda wc: BAMS[wc.sample],
        ref = REF
    output:
        vcf = PATH + "{sample}/sv/straglr/{sample}_straglr.vcf",
        bed = PATH + "{sample}/sv/straglr/{sample}_straglr.bed",
        tsv = PATH + "{sample}/sv/straglr/{sample}_straglr.tsv"
    params:
        prefix = PATH + "{sample}/sv/straglr/{sample}_straglr"
    conda:
        CONDAENV + "straglr.yaml"
    shell:
        """
        mkdir -p {PATH}/{wildcards.sample}/sv/straglr

        {STRAGLR_SCRIPT} {input.bam} {input.ref} {params.prefix} \
            --min_str_len 2 \
            --min_support 1 \
            --min_ins_size 1 \
            --include_partials \
            --nprocs {THREADS} \
            --max_str_len 100000 \
            --use_unpaired_clips \
            --max_num_clusters 10 \
            --min_cluster_d 1 \
            {STRAGLR_REGIONS}
        """

rule straglr_annotation:
    input:
        tsv = rules.straglr.output.tsv,
        bed = rules.straglr.output.bed,
        genes = config["gene_bed"]
    output:
        tsv = PATH + "{sample}/sv/straglr/{sample}_straglr.annotated.tsv"
    conda:
        CONDAENV + "straglr.yaml"
    shell:
        """
        python scripts/annotate_straglr.py \
            --straglr-tsv {input.tsv} \
            --straglr-bed {input.bed} \
            --gene-bed {input.genes} \
            --output {output.tsv}
        """

#####################################################################
# needLR — ONT-native population/reference SV annotation and filtering. #
#####################################################################

rule needlr_annotation:
    input:
        vcf = rules.jasmine_merge.output.vcf
    output:
        tsv = PATH + "{sample}/sv/needlr/{sample}_needLR_RESULTS.tsv",
        vcf = PATH + "{sample}/sv/needlr/{sample}_needLR_RESULTS.vcf.gz"
    params:
        outdir = PATH + "{sample}/sv/needlr",
        backend_flag = lambda wc: f"-B {NEEDLR_BACKEND}" if NEEDLR_BACKEND else ""
    conda:
        CONDAENV + "needlr.yaml"
    shell:
        """
        needLR annotate -O {params.outdir} -T {THREADS} {params.backend_flag} \
            --all {input.vcf}

        results_tsv=$(find {params.outdir} -type f -name '*_RESULTS.tsv' -print -quit)
        results_vcf=$(find {params.outdir} -type f -name '*_RESULTS.vcf.gz' -print -quit)
        test -n "$results_tsv"
        test -n "$results_vcf"
        cp "$results_tsv" {output.tsv}
        cp "$results_vcf" {output.vcf}
        tabix -f -p vcf {output.vcf}
        """


##########################################################################
# AnnotSV — full annotation is the source of truth; panel-only is a view #
##########################################################################

rule annotsv_install_annotations:
    output:
        marker = ANNOTSV_ANNOTATIONS_DIR + "/.installed"
    conda:
        CONDAENV + "annotsv.yaml"
    shell:
        """
        mkdir -p {ANNOTSV_ANNOTATIONS_DIR}
        cd {ANNOTSV_ANNOTATIONS_DIR}
        INSTALL_annotations.sh
        touch {output.marker}
        """


rule annotsv_annotation:
    input:
        vcf = rules.needlr_annotation.output.vcf,
        annotations = rules.annotsv_install_annotations.output.marker
    output:
        tsv = PATH + "{sample}/sv/annotsv/{sample}_merged_SV.annotsv.tsv"
    params:
        outdir = PATH + "{sample}/sv/annotsv",
        hpo_flag = lambda wc: f"-hpo {HPO_TERMS}" if HPO_TERMS else ""
    conda:
        CONDAENV + "annotsv.yaml"
    shell:
        """
        AnnotSV -SVinputFile {input.vcf} \
            -annotationsDir {ANNOTSV_ANNOTATIONS_DIR} \
            -outputDir {params.outdir} \
            -outputFile {wildcards.sample}_merged_SV.annotsv.tsv \
            -genomeBuild GRCh38 \
            -candidateGenesFile {GENE_LIST} \
            -candidateGenesFiltering 0 \
            -benignAF {ANNOTSV_BENIGN_AF} \
            {params.hpo_flag}
        """


rule annotsv_annotation_panel_only:
    input:
        vcf = rules.needlr_annotation.output.vcf,
        annotations = rules.annotsv_install_annotations.output.marker,
        genes = GENE_LIST
    output:
        tsv = PATH + "{sample}/sv/annotsv/{sample}_merged_SV.annotsv.panel_only.tsv"
    params:
        outdir = PATH + "{sample}/sv/annotsv"
    conda:
        CONDAENV + "annotsv.yaml"
    shell:
        """
        mkdir -p {params.outdir}
        AnnotSV -SVinputFile {input.vcf} \
            -annotationsDir {ANNOTSV_ANNOTATIONS_DIR} \
            -outputDir {params.outdir} \
            -outputFile {wildcards.sample}_merged_SV.annotsv.panel_only.tsv \
            -genomeBuild GRCh38 \
            -candidateGenesFile {input.genes} \
            -candidateGenesFiltering 1 \
            -benignAF {ANNOTSV_BENIGN_AF}
        """
#####################################
# Genome-wide human gene discovery
#####################################
rule extract_sv_genes:
    input:
        annotsv=rules.annotsv_annotation.output.tsv
    output:
        genes=PATH + "{sample}/gene_discovery/{sample}_SV_genes.txt"
    conda:
        CONDAENV + "monarch.yaml"
    shell:
        """
        mkdir -p {PATH}/{wildcards.sample}/gene_discovery
        python scripts/extract_annotsv_genes.py --annotsv {input.annotsv} --output {output.genes}
        """

rule extract_nonpanel_genes:
    input:
        genes=rules.extract_sv_genes.output.genes,
        panel=GENE_LIST
    output:
        genes=PATH + "{sample}/gene_discovery/{sample}_nonpanel_genes.txt"
    conda:
        CONDAENV + "monarch.yaml"
    shell:
        """
        python scripts/extract_nonpanel_genes.py --genes {input.genes} --panel {input.panel} --output {output.genes}
        """

rule human_gene_phenotypes:
    input:
        genes=rules.extract_nonpanel_genes.output.genes,
        hpo=DISCOVERY_HPO_FILE
    output:
        tsv=PATH + "{sample}/gene_discovery/{sample}_human_gene_phenotypes.tsv"
    params:
        api=MONARCH_BASE_URL
    conda:
        CONDAENV + "monarch.yaml"
    shell:
        """
        python scripts/monarch_human_gene_phenotypes.py \
            --genes {input.genes} --hpo-anchors {input.hpo} \
            --output {output.tsv} --api-base {params.api}
        """

rule rank_genomewide_candidates:
    input:
        annotsv=rules.annotsv_annotation.output.tsv,
        genes=rules.extract_nonpanel_genes.output.genes,
        phenotypes=rules.human_gene_phenotypes.output.tsv,
        panel=GENE_LIST
    output:
        tsv=PATH + "{sample}/gene_discovery/{sample}_ranked_candidates.tsv"
    conda:
        CONDAENV + "monarch.yaml"
    shell:
        """
        python scripts/rank_sv_gene_candidates.py \
            --annotsv {input.annotsv} --genes {input.genes} \
            --phenotypes {input.phenotypes} --panel {input.panel} \
            --output {output.tsv}
        """
##################################################################
# VEP — full transcript-level annotation + panel-only derived view
##################################################################

rule vep_sv_annotation:
    input:
        vcf = rules.needlr_annotation.output.vcf
    output:
        txt = PATH + "{sample}/sv/vep/{sample}_SV_VEP.txt"
    conda:
        CONDAENV + "vep.yaml"
    shell:
        """
        vep --input_file {input.vcf} --format vcf \
            --output_file {output.txt} \
            --cache --offline --dir_cache {VEP_CACHE_DIR} --assembly {VEP_ASSEMBLY} \
            --canonical --overlaps --pick --symbol --biotype \
            --max_sv_size 250000000 --batch_size 100 --fork {THREADS}
        """


rule vep_sv_annotation_panel_only:
    input:
        txt = rules.vep_sv_annotation.output.txt,
        genes = GENE_LIST
    output:
        txt = PATH + "{sample}/sv/vep/{sample}_SV_VEP.panel_only.txt"
    shell:
        """
        grep '^#' {input.txt} > {output.txt} || true
        grep -Fwf {input.genes} {input.txt} >> {output.txt} || true
        """


##################################################################
# Methylation
##################################################################

rule modkit_extract:
    input:
        bam = lambda wc: BAMS[wc.sample],
        ref = REF
    output:
        tsv = PATH + "{sample}/methylation/{sample}.modkit.tsv"
    conda:
        CONDAENV + "modkit.yaml"
    shell:
        """
        {MODKITENV} extract calls -t {THREADS} --reference {input.ref} --cpg {CPG_FLAG} {input.bam} {output.tsv}
        """


########################################################################
# SV-aware joint SNP+SV phasing (LongPhase)
########################################################################

rule longphase_phasing:
    input:
        vcf = rules.clair3_snp_calling.output.vcf,
        sv_vcf = rules.jasmine_merge.output.vcf,
        bam = lambda wc: BAMS[wc.sample],
        ref = REF
    output:
        vcf = PATH + "{sample}/phasing_longphase/{sample}.longphase.vcf.gz"
    params:
        prefix = PATH + "{sample}/phasing_longphase/{sample}.longphase"
    conda:
        CONDAENV + "longphase.yaml"
    shell:
        """
        longphase phase -s {input.vcf} --sv-file {input.sv_vcf} \
            -b {input.bam} -r {input.ref} -t {THREADS} -o {params.prefix} --ont

        bgzip -f {params.prefix}.vcf
        tabix -p vcf {output.vcf}
        """


########################################################################
# Confirmatory MEI calling (TLDR)
########################################################################

rule tldr_mei_confirmation:
    input:
        bam = lambda wc: BAMS[wc.sample],
        ref = REF
    output:
        table = PATH + "{sample}/mei/tldr/{sample}.tldr.table.txt"
    params:
        outdir = PATH + "{sample}/mei/tldr"
    conda:
        CONDAENV + "tldr.yaml"
    shell:
        """
        tldr -b {input.bam} -r {input.ref} -e {TLDR_ELTS} \
            -p {THREADS} --outdir {params.outdir}

        cp {params.outdir}/*.table.txt {output.table}
        """
