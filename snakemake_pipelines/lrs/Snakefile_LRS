# Methylation
##################################################################

rule modkit_extract:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        tsv=PATH + "{sample}/methylation/{sample}.modkit.tsv"
    conda:
        CONDAENV + "modkit.yaml"
    shell:
        """
        mkdir -p {PATH}{wildcards.sample}/methylation

        modkit extract calls \
            -t {THREADS} \
            --reference {input.ref} \
            {CPG_REGION_FLAG} \
            {input.bam} \
            {output.tsv}
        """


########################################################################
# SV-aware joint SNP+SV phasing (LongPhase)
########################################################################

rule longphase_phasing:
    input:
        vcf=rules.clair3_snp_calling.output.vcf,
        sv_vcf=rules.jasmine_merge.output.vcf,
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        vcf=PATH + "{sample}/phasing_longphase/{sample}.longphase.vcf.gz"
    params:
        prefix=PATH + "{sample}/phasing_longphase/{sample}.longphase"
    conda:
        CONDAENV + "longphase.yaml"
    shell:
        """
        mkdir -p {PATH}{wildcards.sample}/phasing_longphase

        longphase phase \
            -s {input.vcf} \
            --sv-file {input.sv_vcf} \
            -b {input.bam} \
            -r {input.ref} \
            -t {THREADS} \
            -o {params.prefix} \
            --ont

        bgzip -f {params.prefix}.vcf
        tabix -f -p vcf {output.vcf}
        """


########################################################################
# Confirmatory MEI calling (TLDR)
########################################################################

rule tldr_mei_confirmation:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        table=PATH + "{sample}/mei/tldr/{sample}.tldr.table.txt"
    params:
        outdir=PATH + "{sample}/mei/tldr"
    conda:
        CONDAENV + "tldr.yaml"
    shell:
        """
        mkdir -p {params.outdir}

        tldr \
            -b {input.bam} \
            -r {input.ref} \
            -e {TLDR_ELTS} \
            -p {THREADS} \
            --outdir {params.outdir}

        tables=( {params.outdir}/*.table.txt )
        test -e "${tables[0]}"
        test "${#tables[@]}" -eq 1
        cp "${tables[0]}" {output.table}
        """


