########################################################
# needLR-compatible independent population-AF branch  #
########################################################

rule sniffles2_needlr_query:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        vcf=PATH + "{sample}/sv/needlr_query/{sample}.needlr.sniffles.vcf.gz",
        tbi=PATH + "{sample}/sv/needlr_query/{sample}.needlr.sniffles.vcf.gz.tbi"
    params:
        raw=PATH + "{sample}/sv/needlr_query/{sample}.needlr.sniffles.vcf"
    threads: THREADS
    conda:
        CONDAENV + "sniffles2_needlr.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p "$(dirname {output.vcf:q})"

        # Dedicated Sniffles2 v2.6.2 query matching the caller used to build
        # the needLR ONT reference as closely as possible. Keep the Snakemake
        # output bgzipped because needLR may compress an uncompressed input
        # in place, which would otherwise make the declared .vcf disappear.
        sniffles \
            --input {input.bam:q} \
            --reference {input.ref:q} \
            --output-rnames \
            --vcf {params.raw:q} \
            --allow-overwrite \
            --tandem-repeats {VNTR_BED:q} \
            --threads {threads}

        bgzip -@ {threads} -f {params.raw:q}
        tabix -f -p vcf {output.vcf:q}

        test -s {output.vcf:q}
        test -s {output.tbi:q}
        """


rule needlr_annotation:
    input:
        vcf=rules.sniffles2_needlr_query.output.vcf,
        tbi=rules.sniffles2_needlr_query.output.tbi,
        backend=NEEDLR_BACKEND,
        cache_script=SCRIPTS + "/check_run_cache.py",
        environment=CONDAENV + "needlr.yaml"
    output:
        tsv=PATH + "{sample}/sv/needlr/{sample}_needLR_RESULTS.tsv",
        vcf=PATH + "{sample}/sv/needlr/{sample}_needLR_RESULTS.vcf.gz"
    log:
        PATH + "{sample}/logs/needlr/{sample}.needlr.log"
    params:
        outdir=PATH + "{sample}/sv/needlr/annotate_out"
    threads: THREADS
    conda:
        CONDAENV + "needlr.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {params.outdir:q} "$(dirname {log:q})"
        snapshot={params.outdir:q}/.current_inputs.json
        manifest={params.outdir:q}/.completed_run.json
        tool_binary=$(command -v needLR)
        python {input.cache_script:q} snapshot --inputs {input.backend:q} {input.environment:q} "$tool_binary" \
            --content-inputs {input.vcf:q} --tool-paths {input.vcf:q} {input.backend:q} {params.outdir:q} \
            --tags-json '{{"mode":"annotate --all"}}' --snapshot "$snapshot"

        if python {input.cache_script:q} check --snapshot "$snapshot" --manifest "$manifest"; then
            echo "[needLR] Input/backend/settings and complete outputs match; reusing native result." > {log:q}
            results_tsv=$(python {input.cache_script:q} output --manifest "$manifest" --index 0)
            results_vcf=$(python {input.cache_script:q} output --manifest "$manifest" --index 1)
        else
            echo "[needLR] No matching completed run; annotating in a fresh directory." > {log:q}
            # Only this new run can supply results. Old native outputs are kept
            # for inspection but cannot hide failure or be relabelled by mtime.
            rm -f "$manifest" {output.tsv:q} {output.vcf:q}
            run_dir=$(mktemp -d {params.outdir:q}/run.XXXXXX)
            needLR annotate -O "$run_dir" -T {threads} -B {input.backend:q} --all {input.vcf:q} >> {log:q} 2>&1
            mapfile -t matches < <(find "$run_dir" -type f -name '*_RESULTS.tsv')
            if (( ${{#matches[@]}} != 1 )); then
                echo "[ERROR] needLR must create exactly one result TSV in its fresh run directory." >&2
                exit 1
            fi
            results_tsv="${{matches[0]}}"
            results_vcf="${{results_tsv%_RESULTS.tsv}}.vcf.gz"
            python {input.cache_script:q} complete --snapshot "$snapshot" --manifest "$manifest" \
                --outputs "$results_tsv" "$results_vcf"
        fi
        cp "$results_tsv" {output.tsv:q}
        cp "$results_vcf" {output.vcf:q}
        test -s {output.tsv:q}
        test -s {output.vcf:q}
        """


