########################################################################
# SV-aware joint SNP+SV phasing
########################################################################

rule longphase_phasing:
    input:
        vcf=rules.clair3_snp_calling.output.vcf,
        sv_vcf=rules.jasmine_merge.output.vcf,
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        vcf=PATH + "{sample}/phasing_longphase/{sample}.longphase.vcf.gz",
        tbi=PATH + "{sample}/phasing_longphase/{sample}.longphase.vcf.gz.tbi"
    params:
        prefix=PATH + "{sample}/phasing_longphase/{sample}.longphase"
    conda:
        CONDAENV + "longphase.yaml"
    threads: THREADS
    shell:
        """
        set -euo pipefail
        mkdir -p {PATH}{wildcards.sample}/phasing_longphase

        longphase phase \
            -s {input.vcf} \
            --sv-file {input.sv_vcf} \
            -b {input.bam} \
            -r {input.ref} \
            -t {threads} \
            -o {params.prefix} \
            --ont

        test -s {params.prefix}.vcf
        bgzip -f {params.prefix}.vcf
        test -s {output.vcf}
        tabix -f -p vcf {output.vcf}
        test -s {output.tbi}
        """


