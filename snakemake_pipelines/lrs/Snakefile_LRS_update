# Genome-wide SV callers
########################################################################

rule sniffles2_sv:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        vcf=PATH + "{sample}/sv/sniffles2/{sample}_sniffles.vcf"
    conda:
        CONDAENV + "sniffles2.yaml"
    threads: THREADS
    shell:
        """
        set -euo pipefail
        mkdir -p {PATH}{wildcards.sample}/sv/sniffles2

        sniffles \
            --input {input.bam} \
            --vcf {output.vcf} \
            --reference {input.ref} \
            --threads {threads} \
            --minsupport 2 \
            --no-qc \
            {SNIFFLES_MOSAIC_FLAG} \
            --allow-overwrite \
            --min-alignment-length 100 \
            --output-rnames \
            --tandem-repeats {VNTR_BED}
        test -s {output.vcf}
        """


rule sniffles2_caller_parse:
    input:
        vcf=rules.sniffles2_sv.output.vcf
    output:
        tsv=PATH + "{sample}/parsed/{sample}.sniffles.caller.tsv"
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.tsv})
        python {SCRIPTS}/parse_sv_caller_vcf.py \
            --vcf {input.vcf} \
            --caller Sniffles2 \
            --output {output.tsv}
        """


rule cutesv:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        vcf=PATH + "{sample}/sv/cutesv/{sample}_cutesv.vcf"
    params:
        workdir=PATH + "{sample}/sv/cutesv"
    conda:
        CONDAENV + "cutesv.yaml"
    threads: THREADS
    shell:
        """
        set -euo pipefail
        mkdir -p {params.workdir}

        cuteSV \
            {input.bam} \
            {input.ref} \
            {output.vcf} \
            {params.workdir} \
            --threads {threads} \
            --max_cluster_bias_INS 100 \
            --diff_ratio_merging_INS 0.3 \
            --max_cluster_bias_DEL 100 \
            --diff_ratio_merging_DEL 0.3 \
            --min_support 2 \
            --min_size 50 \
            --min_mapq 20 \
            --min_read_len 500 \
            --genotype
