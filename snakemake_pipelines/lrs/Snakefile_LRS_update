rule filter_sniffles_sv:
    input:
        filter_script=FILTER_SV_EVIDENCE_SCRIPT,
        filter_common=SCRIPTS + "/sv_evidence_common.py",
        caller_vcf=rules.sniffles2_sv.output.vcf,
        caller_tsv=rules.sniffles2_caller_parse.output.tsv
    output:
        tsv=PATH + "{sample}/parsed/{sample}.sniffles.evidence.filtered.tsv",
        ids=PATH + "{sample}/parsed/{sample}.sniffles.pass.ids.txt",
        vcf=PATH + "{sample}/sv/sniffles2/{sample}_sniffles.filtered.vcf"
    params:
        min_gq=lambda wc: f"--min-gq {EVIDENCE_MIN_GQ}" if EVIDENCE_MIN_GQ is not None else "",
        max_svlen=lambda wc: f"--max-svlen {EVIDENCE_MAX_SVLEN}" if EVIDENCE_MAX_SVLEN is not None else "",
        blacklist=lambda wc: f"--blacklist-bed {EVIDENCE_BLACKLIST_BED}" if EVIDENCE_BLACKLIST_BED else ""
    conda:
        CONDAENV + "annotsv.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p "$(dirname {output.tsv:q})" "$(dirname {output.vcf:q})"

        python {FILTER_SV_EVIDENCE_SCRIPT} \
            --caller-tsv {input.caller_tsv:q} \
            --caller Sniffles2 \
            --min-support {EVIDENCE_MIN_SUPPORT} \
            --min-svlen {EVIDENCE_MIN_SVLEN} \
            {SNIFFLES_COV_VAR_RESCUE_FLAG} \
            {params.max_svlen} \
            {params.min_gq} \
            {params.blacklist} \
            {EVIDENCE_CANONICAL_FLAG} \
            --output-tsv {output.tsv:q} \
            --output-ids {output.ids:q}

        bcftools view -i "ID=@{output.ids:q}" -Ov -o {output.vcf:q} {input.caller_vcf:q}
        """


rule filter_cutesv_sv:
