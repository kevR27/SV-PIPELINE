        delly=rules.delly_evidence_filter.output.tsv
    output:
        tsv=PATH + "{sample}/gene_discovery/{sample}_integrated_SV_gene_analysis.tsv"
    conda:
        CONDAENV + "monarch.yaml"
    shell:
        """
        mkdir -p $(dirname {output.tsv})

        python {SCRIPTS}/build_integrated_sv_gene_tsv.py \
            --vcf {input.vcf} \
            --annotsv {input.annotsv} \
            --needlr {input.needlr} \
            --ranking {input.ranking} \
            --panel {input.panel} \
            --caller-tsv {input.sniffles} \
            --caller-tsv {input.cutesv} \
            --caller-tsv {input.delly} \
            --output {output.tsv}
        """

##################################################################
# VEP — full transcript-level annotation + panel-only derived view
##################################################################

rule vep_sv_annotation:
    input:
        vcf=rules.needlr_annotation.output.vcf
    output:
        txt=PATH + "{sample}/sv/vep/{sample}_SV_VEP.txt"
    conda:
        CONDAENV + "vep.yaml"
    shell:
        """
        mkdir -p {PATH}{wildcards.sample}/sv/vep

        vep \
            --input_file {input.vcf} \
            --format vcf \
            --vcf \
            --output_file {output.txt} \
            --cache \
            --offline \
            --dir_cache {VEP_CACHE_DIR} \
            --assembly {VEP_ASSEMBLY} \
            --canonical \
            --overlaps \
            --pick \
            --symbol \
            --biotype \
            --max_sv_size 250000000 \
            --buffer_size 100 \
            --force_overwrite \
            --fork {THREADS}
        """
        # NOTE: --vcf added so the output carries a ##INFO=<ID=CSQ,...> header
        # and per-record CSQ= field, which is what filter_vep_panel.py parses.
        # Without --vcf, VEP emits its own default tabular format and the
        # downstream panel filter would silently match nothing.

rule vep_sv_annotation_panel_only:
    input:
        txt=rules.vep_sv_annotation.output.txt,
        genes=GENE_LIST
    output:
        txt=PATH + "{sample}/sv/vep/{sample}_SV_VEP.panel_only.txt"
    shell:
        """
        mkdir -p {PATH}{wildcards.sample}/sv/vep

        python {SCRIPTS}/filter_vep_panel.py \
            --vep {input.txt} \
            --genes {input.genes} \
            --output {output.txt}
        """

##################################################################
# Methylation
##################################################################

rule modkit_extract:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        tsv=PATH + "{sample}/methylation/{sample}.modkit.tsv"
    conda:
        CONDAENV + "modkit.yaml"
    shell:
        """
        mkdir -p {PATH}{wildcards.sample}/methylation

        modkit extract calls \
            -t {THREADS} \
            --reference {input.ref} \
            {CPG_REGION_FLAG} \
            {input.bam} \
            {output.tsv}
        """

########################################################################
# SV-aware joint SNP+SV phasing (LongPhase)
########################################################################

rule longphase_phasing:
    input:
        vcf=rules.clair3_snp_calling.output.vcf,
        sv_vcf=rules.jasmine_merge.output.vcf,
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        vcf=PATH + "{sample}/phasing_longphase/{sample}.longphase.vcf.gz"
    params:
        prefix=PATH + "{sample}/phasing_longphase/{sample}.longphase"
    conda:
        CONDAENV + "longphase.yaml"
    shell:
        """
        mkdir -p {PATH}{wildcards.sample}/phasing_longphase

        longphase phase \
            -s {input.vcf} \
            --sv-file {input.sv_vcf} \
            -b {input.bam} \
            -r {input.ref} \
            -t {THREADS} \
            -o {params.prefix} \
            --ont

        test -s {params.prefix}.vcf
        bgzip -f {params.prefix}.vcf
        test -s {output.vcf}
        tabix -f -p vcf {output.vcf}
        """

########################################################################
# Confirmatory MEI calling (TLDR)
########################################################################

rule tldr_mei_confirmation:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        table=PATH + "{sample}/mei/tldr/{sample}.tldr.table.txt"
    params:
        outbase=PATH + "{sample}/mei/tldr/{sample}"
    conda:
        CONDAENV + "tldr.yaml"
    shell:
        """
        set -euo pipefail

        mkdir -p {PATH}{wildcards.sample}/mei/tldr

        tldr \
            -b {input.bam} \
            -r {input.ref} \
            -e {TLDR_ELTS} \
            -p {THREADS} \
            --color_consensus \
            -o {params.outbase}

        cp {params.outbase}.table.txt {output.table}
        """
