# SV calling + merge   #
########################

rule sniffles2_sv:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        vcf=PATH + "{sample}/sv/sniffles2/{sample}_sniffles.vcf"
    conda:
        CONDAENV + "sniffles2.yaml"
    shell:
        """
        mkdir -p {PATH}{wildcards.sample}/sv/sniffles2

        sniffles \
            --input {input.bam} \
            --vcf {output.vcf} \
            --reference {input.ref} \
            --threads {THREADS} \
            --minsupport 2 \
            --no-qc \
            {SNIFFLES_MOSAIC_FLAG} \
            --allow-overwrite \
            --min-alignment-length 100 \
            --output-rnames \
            --tandem-repeats {VNTR_BED}
        """

rule sniffles2_caller_parse:
    input:
        vcf=rules.sniffles2_sv.output.vcf
    output:
        tsv=PATH + "{sample}/parsed/{sample}.sniffles.caller.tsv"
    shell:
        """
        mkdir -p $(dirname {output.tsv})
        python {SCRIPTS}/parse_sv_caller_vcf.py \
            --vcf {input.vcf} \
            --caller Sniffles2 \
            --output {output.tsv}
        """

rule cutesv:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        vcf=PATH + "{sample}/sv/cutesv/{sample}_cutesv.vcf"
    conda:
        CONDAENV + "cutesv.yaml"
    threads: THREADS
    shell:
        """
        mkdir -p {PATH}{wildcards.sample}/sv/cutesv

        cuteSV \
            {input.bam} \
            {input.ref} \
            {output.vcf} \
            {PATH}{wildcards.sample}/sv/cutesv \
            --threads {threads} \
            --max_cluster_bias_INS 100 \
            --diff_ratio_merging_INS 0.3 \
            --max_cluster_bias_DEL 100 \
            --diff_ratio_merging_DEL 0.3 \
            --min_support 2 \
            --min_size 50 \
            --min_mapq 20 \
            --min_read_len 500 \
            --genotype \
            -include_bed {BEDCUTESV}
        """

rule cutesv_caller_parse:
    input:
        vcf=rules.cutesv.output.vcf
    output:
        tsv=PATH + "{sample}/parsed/{sample}.cutesv.caller.tsv"
    shell:
        """
        mkdir -p $(dirname {output.tsv})
        python {SCRIPTS}/parse_sv_caller_vcf.py \
            --vcf {input.vcf} \
            --caller cuteSV \
            --output {output.tsv}
        """

rule delly_lr:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        bcf=PATH + "{sample}/sv/delly/{sample}_delly.bcf",
        vcf=PATH + "{sample}/sv/delly/{sample}_delly.vcf"
    params:
        outdir=PATH + "{sample}/sv/delly"
    conda:
        CONDAENV + "delly.yaml"
    shell:
        """
        mkdir -p {params.outdir}

        delly lr \
            -y {DELLY_GENOME} \
            -g {input.ref} \
            -o {output.bcf} \
            {input.bam}

        bcftools view \
            {output.bcf} \
            -Ov \
            -o {output.vcf}
        """

rule delly_caller_parse:
    input:
        vcf=rules.delly_lr.output.vcf
    output:
        tsv=PATH + "{sample}/parsed/{sample}.delly.caller.tsv"
    shell:
        """
        mkdir -p $(dirname {output.tsv})
        python {SCRIPTS}/parse_sv_caller_vcf.py \
            --vcf {input.vcf} \
            --caller delly \
            --output {output.tsv}
        """

rule filter_sniffles_sv:
    input:
        caller_vcf=rules.sniffles2_sv.output.vcf,
        caller_tsv=rules.sniffles2_caller_parse.output.tsv
    output:
        tsv=PATH + "{sample}/parsed/{sample}.sniffles.evidence.filtered.tsv",
        ids=PATH + "{sample}/parsed/{sample}.sniffles.pass.ids.txt",
        vcf=PATH + "{sample}/sv/sniffles2/{sample}_sniffles.filtered.vcf.gz",
        tbi=PATH + "{sample}/sv/sniffles2/{sample}_sniffles.filtered.vcf.gz.tbi"
    conda:
        CONDAENV + "annotsv.yaml"
    params:
        min_gq_flag=lambda wc: f"--min-gq {EVIDENCE_MIN_GQ}" if EVIDENCE_MIN_GQ is not None else "",
        blacklist_flag=lambda wc: f"--blacklist-bed {EVIDENCE_BLACKLIST_BED}" if EVIDENCE_BLACKLIST_BED else ""
    shell:
        """
        set -euo pipefail

        mkdir -p $(dirname {output.tsv})
        mkdir -p $(dirname {output.vcf})

        python {FILTER_SV_EVIDENCE_SCRIPT} \
            --caller-tsv {input.caller_tsv} \
            --caller Sniffles2 \
            --min-support {EVIDENCE_MIN_SUPPORT} \
            --min-svlen {EVIDENCE_MIN_SVLEN} \
            --max-svlen {EVIDENCE_MAX_SVLEN} \
            {params.min_gq_flag} \
            {params.blacklist_flag} \
            --output-tsv {output.tsv} \
            --output-ids {output.ids}

        bcftools view -i "ID=@{output.ids}" \
            -Oz \
            -o {output.vcf} \
            {input.caller_vcf}

        tabix -f -p vcf {output.vcf}
        """


