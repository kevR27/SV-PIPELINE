rule mosdepth_coverage:
    input:
        bam=lambda wc: BAMS[wc.sample]
    output:
        global_dist=PATH + "{sample}/coverage/{sample}.mosdepth.global.dist.txt",
        summary=PATH + "{sample}/coverage/{sample}.mosdepth.summary.txt"
    params:
        prefix=PATH + "{sample}/coverage/{sample}"
    threads: THREADS
    conda:
        CONDAENV + "mosdepth.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p "$(dirname {output.global_dist:q})"
        mosdepth -t {threads} {params.prefix:q} {input.bam:q}
        test -s {output.global_dist:q}
        test -s {output.summary:q}
        """

rule dorado_summary:
    input:
        bam=lambda wc: DORADO_SUMMARY_BAMS[wc.sample]
    output:
        tsv=PATH + "{sample}/qc/{sample}.dorado_summary.tsv"
    log:
        PATH + "{sample}/logs/dorado/{sample}.dorado_summary.log"
    shell:
        """
        set -euo pipefail
        mkdir -p "$(dirname {output.tsv:q})" "$(dirname {log:q})"
        {DORADO_BIN:q} summary {input.bam:q} > {output.tsv:q} 2> {log:q}
        test -s {output.tsv:q}
        """


rule summarize_dorado_qc:
    input:
        summary=rules.dorado_summary.output.tsv,
        script=SCRIPTS + "/summarize_dorado_qc.py"
    output:
        tsv=PATH + "{sample}/qc/{sample}.dorado_qc.tsv"
    conda:
        CONDAENV + "plots.yaml"
    shell:
        """
        set -euo pipefail
        python {input.script:q} \
            --input {input.summary:q} \
            --sample {wildcards.sample} \
            --output {output.tsv:q}
        test -s {output.tsv:q}
        """


rule read_length_n50:
    input:
        bam=lambda wc: BAMS[wc.sample],
        script=SCRIPTS + "/calc_bam_n50.py"
    output:
        tsv=PATH + "{sample}/qc/{sample}.n50.tsv"
    conda:
        CONDAENV + "read_qc.yaml"
    shell:
        """
        set -euo pipefail
        python {input.script:q} \
            --bam {input.bam:q} \
            --min-length {N50_MIN_LENGTH} \
            --out {output.tsv:q}
        test -s {output.tsv:q}
        """


