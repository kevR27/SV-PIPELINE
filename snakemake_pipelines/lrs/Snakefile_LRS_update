rule sniffles2_needlr_query:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        vcf=PATH + "{sample}/sv/needlr/{sample}_needLR_query.sniffles.vcf"
    threads: THREADS
    conda:
        CONDAENV + "sniffles2.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.vcf})

        # Separate reference-compatible query call for needLR. Discovery-only
        # sensitivity flags from sniffles2_sv are deliberately not reused here.
        sniffles \
            --input {input.bam} \
            --reference {input.ref} \
            --output-rnames \
            --vcf {output.vcf} \
            --allow-overwrite \
            --tandem-repeats {VNTR_BED} \
            --threads {threads}
        """


rule needlr_annotation:
    input:
        vcf=rules.sniffles2_needlr_query.output.vcf
    output:
        tsv=PATH + "{sample}/sv/needlr/{sample}_needLR_RESULTS.tsv",
        vcf=PATH + "{sample}/sv/needlr/{sample}_needLR_RESULTS.vcf.gz",
        tbi=PATH + "{sample}/sv/needlr/{sample}_needLR_RESULTS.vcf.gz.tbi"
    params:
        run_dir=PATH + "{sample}/sv/needlr/annotate_run",
        backend_flag=lambda wc: f"-B {NEEDLR_BACKEND}" if NEEDLR_BACKEND else ""
    threads: THREADS
    conda:
        CONDAENV + "needlr.yaml"
    shell:
        """
        set -euo pipefail

        rm -rf {params.run_dir}
        mkdir -p {params.run_dir}

        needLR annotate \
            -O {params.run_dir} \
            -T {threads} \
            {params.backend_flag} \
            --all \
            {input.vcf}

        tsv_count=$(find {params.run_dir} -type f -name '*_RESULTS.tsv' | wc -l)
        vcf_count=$(find {params.run_dir} -type f -name '*_RESULTS.vcf.gz' | wc -l)

        test "$tsv_count" -eq 1 || {{ echo "ERROR: expected exactly one needLR *_RESULTS.tsv, found $tsv_count" >&2; exit 1; }}
        test "$vcf_count" -eq 1 || {{ echo "ERROR: expected exactly one needLR *_RESULTS.vcf.gz, found $vcf_count" >&2; exit 1; }}

        results_tsv=$(find {params.run_dir} -type f -name '*_RESULTS.tsv' -print -quit)
        results_vcf=$(find {params.run_dir} -type f -name '*_RESULTS.vcf.gz' -print -quit)

        cp "$results_tsv" {output.tsv}
        bcftools sort -Oz -o {output.vcf} "$results_vcf"
        tabix -f -p vcf {output.vcf}
        """


##########################################################################
# AnnotSV — Jasmine master VCF is the source of truth                    #
##########################################################################

rule annotsv_annotations_check:
    output:
        marker=ANNOTSV_ANNOTATIONS_DIR + "/.installed"
    shell:
        """
        set -euo pipefail
        test -d {ANNOTSV_ANNOTATIONS_DIR}/Annotations_Human
        test -d {ANNOTSV_ANNOTATIONS_DIR}/Annotations_Exomiser
        touch {output.marker}
        """


rule annotsv_annotation:
    input:
        vcf=rules.jasmine_merge.output.vcf,
        annotations=rules.annotsv_annotations_check.output.marker
    output:
        tsv=PATH + "{sample}/sv/annotsv/{sample}_merged_SV.annotsv.tsv"
    params:
        outdir=PATH + "{sample}/sv/annotsv",
        hpo_flag=lambda wc: f"-hpo {HPO_TERMS}" if HPO_TERMS else ""
    conda:
        CONDAENV + "annotsv.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {params.outdir}

        AnnotSV \
            -SVinputFile {input.vcf} \
            -annotationsDir {ANNOTSV_ANNOTATIONS_DIR} \
            -outputDir {params.outdir} \
            -outputFile {wildcards.sample}_merged_SV.annotsv.tsv \
            -genomeBuild GRCh38 \
            -candidateGenesFile {GENE_LIST} \
            -candidateGenesFiltering 0 \
            -tx ENSEMBL \
            -REreport 1 \
            -benignAF {ANNOTSV_BENIGN_AF} \
            {params.hpo_flag}
        """


