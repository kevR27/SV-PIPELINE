########################################
# Jasmine per-patient caller merge     #
########################################

rule jasmine_merge:
    input:
        sniffles=rules.filter_sniffles_sv.output.vcf,
        cutesv=rules.filter_cutesv_sv.output.vcf,
        delly=rules.filter_delly_sv.output.vcf,
        fai=REF + ".fai"
    output:
        list_file=PATH + "{sample}/sv/merged/{sample}_vcf_list.txt",
        raw_vcf=temp(PATH + "{sample}/sv/merged/{sample}_merged_SV.raw.vcf"),
        vcf=PATH + "{sample}/sv/merged/{sample}_merged_SV.vcf.gz",
        tbi=PATH + "{sample}/sv/merged/{sample}_merged_SV.vcf.gz.tbi"
    params:
        outdir=PATH + "{sample}/sv/merged",
        sort_tmpdir=PATH + "{sample}/sv/merged/.bcftools_sort_tmp",
        sanitized_vcf=PATH + "{sample}/sv/merged/{sample}_merged_SV.sanitized.vcf"
    threads: THREADS
    conda:
        CONDAENV + "jasmine.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {params.outdir:q}
        rm -rf {params.sort_tmpdir:q}
        mkdir -p {params.sort_tmpdir:q}

        # This order defines the meaning of Jasmine SUPP_VEC.
        printf "%s\\n%s\\n%s\\n" \
            {input.sniffles:q} \
            {input.cutesv:q} \
            {input.delly:q} \
            > {output.list_file:q}

        jasmine \
            file_list={output.list_file:q} \
            out_file={output.raw_vcf:q} \
            threads={threads} \
            --allow_intrasample

        python {SCRIPTS:q}/sanitize_jasmine_vcf.py \
            --input {output.raw_vcf:q} \
            --output {params.sanitized_vcf:q} \
            --reference-fai {input.fai:q}

        bcftools sort \
            -T {params.sort_tmpdir:q} \
            -Oz \
            -o {output.vcf:q} \
            {params.sanitized_vcf:q}

        tabix -f -p vcf {output.vcf:q}
        test -s {output.vcf:q}
        test -s {output.tbi:q}

        rm -rf {params.sort_tmpdir:q}
        rm -f {params.sanitized_vcf:q}
        """


