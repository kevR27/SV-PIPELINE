        python {STRAGLR_SCRIPT} \
            {input.bam} \
            {input.ref} \
            {params.prefix} \
            --min_str_len 2 \
            --min_support 2 \
            --min_ins_size 100 \
            --nprocs {THREADS} \
            {STRAGLR_REGIONS} \
            --max_str_len 100000 \
            --max_num_clusters 2 \
            --min_cluster_d 1
