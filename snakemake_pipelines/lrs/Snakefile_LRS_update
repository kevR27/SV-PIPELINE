rule jasmine_merge:
    input:
        sniffles=rules.filter_sniffles_sv.output.vcf,
        cutesv=rules.filter_cutesv_sv.output.vcf,
        delly=rules.filter_delly_sv.output.vcf
    output:
        list_file=PATH + "{sample}/sv/merged/{sample}_vcf_list.txt",
        vcf=PATH + "{sample}/sv/merged/{sample}_merged_SV.vcf.gz"
    params:
        outdir=PATH + "{sample}/sv/merged"
    conda:
        CONDAENV + "jasmine.yaml"
    shell:
        """
        mkdir -p {params.outdir}

        printf "%s\\n%s\\n%s\\n" \
            {input.sniffles} \
            {input.cutesv} \
            {input.delly} \
            > {output.list_file}

        jasmine \
            file_list={output.list_file} \
            out_file={output.vcf} \
            threads={THREADS} \
            --allow_intrasample \
            --output_genotypes

        tabix -f -p vcf {output.vcf}
        """

rule summarize_caller_support:
    input:
        vcf=rules.jasmine_merge.output.vcf
    output:
        summary=PATH + "{sample}/sv/merged/{sample}_caller_support_summary.tsv",
        high_conf_vcf=PATH + "{sample}/sv/merged/{sample}_merged_SV.high_confidence.vcf.gz"
    params:
        raw_vcf=PATH + "{sample}/sv/merged/{sample}_merged_SV.high_confidence.vcf"
    conda:
        CONDAENV + "annotsv.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.summary})

        python {SCRIPTS}/summarize_sv_caller_support.py \
            --vcf {input.vcf} \
            --output {output.summary} \
            --min-callers {HIGH_CONFIDENCE_MIN_SUPP} \
            --high-confidence-vcf {params.raw_vcf}

        bgzip -f {params.raw_vcf}
        tabix -f -p vcf {output.high_conf_vcf}
        """

rule prepare_needlr_vcf:
    input:
        vcf=rules.jasmine_merge.output.vcf,
        fai=REF + ".fai"
    output:
        vcf=PATH + "{sample}/sv/needlr/{sample}_needLR_input.vcf.gz",
        tbi=PATH + "{sample}/sv/needlr/{sample}_needLR_input.vcf.gz.tbi"
    threads: 32
    conda:
        CONDAENV + "annotsv.yaml"
    shell:
        """
        mkdir -p $(dirname {output.vcf})

        python {SCRIPTS}/prepare_needlr_vcf.py \
            --input {input.vcf} \
            --output {output.vcf} \
            --reference-fai {input.fai}
        """

##################################################################
# Repeat expansion classification and annotation
##################################################################

rule straglr:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        vcf=PATH + "{sample}/sv/straglr/{sample}_straglr.vcf",
        bed=PATH + "{sample}/sv/straglr/{sample}_straglr.bed",
        tsv=PATH + "{sample}/sv/straglr/{sample}_straglr.tsv"
    params:
        prefix=PATH + "{sample}/sv/straglr/{sample}_straglr"
    conda:
        CONDAENV + "straglr.yaml"
    shell:
        """
        mkdir -p {PATH}{wildcards.sample}/sv/straglr

        python {STRAGLR_SCRIPT} \
            {input.bam} \
            {input.ref} \
            {params.prefix} \
            --min_str_len 2 \
            --min_support 2 \
            --min_ins_size 100 \
            --nprocs {THREADS} \
            {STRAGLR_REGIONS} \
            --max_str_len 100000 \
            --max_num_clusters 2 \
            --min_cluster_d 1
        """

rule straglr_annotation:
    input:
        tsv=rules.straglr.output.tsv,
        bed=rules.straglr.output.bed,
        genes=GENEBED

    output:
        tsv=PATH + "{sample}/sv/straglr/{sample}_straglr.annotated.tsv"
    conda:
        CONDAENV + "straglr.yaml"
    shell:
        """
        mkdir -p {PATH}{wildcards.sample}/sv/straglr

        python {SCRIPTS}/annotate_straglr.py \
            --straglr-tsv {input.tsv} \
            --straglr-bed {input.bed} \
            --gene-bed {input.genes} \
            --output {output.tsv} \
            --min-overlap {STRAGLR_MIN_OVERLAP}
        """


#####################################################################
# needLR — ONT-native population/reference SV annotation/filtering #
#####################################################################

rule needlr_annotation:
    input:
        vcf=rules.prepare_needlr_vcf.output.vcf
    output:
        tsv=PATH + "{sample}/sv/needlr/{sample}_needLR_RESULTS.tsv",
        vcf=PATH + "{sample}/sv/needlr/{sample}_needLR_RESULTS.vcf.gz"
    params:
        outdir=PATH + "{sample}/sv/needlr",
        backend_flag=lambda wc: f"-B {NEEDLR_BACKEND}" if NEEDLR_BACKEND else ""
    conda:
        CONDAENV + "needlr.yaml"
    shell:
        """
        set -euo pipefail

        needLR annotate \
            -O {params.outdir} \
            -T {THREADS} \
            {params.backend_flag} \
            --all \
            {input.vcf}

        results_tsv=$(find {params.outdir} -type f -name '*_RESULTS.tsv' -print -quit)
        results_vcf=$(find {params.outdir} -type f -name '*_RESULTS.vcf.gz' -print -quit)

        test -n "$results_tsv"
        test -n "$results_vcf"

        cp "$results_tsv" {output.tsv}
        cp "$results_vcf" {output.vcf}

        tabix -f -p vcf {output.vcf}
        """

##########################################################################
# Validate/repair NeedLR VCF before AnnotSV                              #
##########################################################################
# This rule NEVER modifies the original NeedLR RESULTS VCF.
# This writes a new repaired VCF and then creates a separate sorted/indexed VCF for AnnotSV

rule fix_needlrvcf_for_annotsv:
    input:
        vcf=rules.needlr_annotation.output.vcf
    output:
        repaired=PATH + "{sample}/sv/needlr/{sample}_needLR_repaired.vcf.gz",
        vcf=PATH + "{sample}/sv/needlr/{sample}_needLR_repaired.vcf.sorted.vcf.gz",
        csi=PATH + "{sample}/sv/needlr/{sample}_needLR_repaired.vcf.sorted.vcf.gz.csi"
    params:
        tmpdir=PATH + "{sample}/sv/needlr/.fix_needlrvcf",
        tmp_output=PATH + "{sample}/sv/needlr/.fix_needlrvcf/{sample}_needLR_repaired.vcf.gz"
    conda:
        CONDAENV + "annotsv.yaml"
    shell:
        """
        set -euo pipefail

        mkdir -p {params.tmpdir}
        rm -f {params.tmp_output} {params.tmp_output}.sorted.vcf.gz {params.tmp_output}.sorted.vcf.gz.csi

        python {SCRIPTS}/fix_needlrvcf_for_annotsv.py \
            --input {input.vcf} \
            --output {params.tmp_output}

        test -s {params.tmp_output}
        test -s {params.tmp_output}.sorted.vcf.gz
        test -s {params.tmp_output}.sorted.vcf.gz.csi

        mv {params.tmp_output} {output.repaired}
        mv {params.tmp_output}.sorted.vcf.gz {output.vcf}
        mv {params.tmp_output}.sorted.vcf.gz.csi {output.csi}
        """
##########################################################################
# AnnotSV — genome-wide is the source of truth; panel-only is a filtered #
# post-hoc view (no second AnnotSV execution)                            #
##########################################################################

rule annotsv_annotations_check:
    output:
        marker=ANNOTSV_ANNOTATIONS_DIR + "/.installed"
    shell:
        """
        set -euo pipefail

        test -d {ANNOTSV_ANNOTATIONS_DIR}/Annotations_Human
        test -d {ANNOTSV_ANNOTATIONS_DIR}/Annotations_Exomiser

        touch {output.marker}
        """

rule annotsv_annotation:
    input:
        vcf=rules.fix_needlrvcf_for_annotsv.output.vcf,
        annotations=rules.annotsv_annotations_check.output.marker
    output:
        tsv=PATH + "{sample}/sv/annotsv/{sample}_merged_SV.annotsv.tsv"
    params:
        outdir=PATH + "{sample}/sv/annotsv",
        hpo_flag=lambda wc: f"-hpo {HPO_TERMS}" if HPO_TERMS else ""
    conda:
        CONDAENV + "annotsv.yaml"
    shell:
        """
        mkdir -p {params.outdir}

        AnnotSV \
            -SVinputFile {input.vcf} \
            -annotationsDir {ANNOTSV_ANNOTATIONS_DIR} \
            -outputDir {params.outdir} \
            -outputFile {wildcards.sample}_merged_SV.annotsv.tsv \
            -genomeBuild GRCh38 \
            -candidateGenesFile {GENE_LIST} \
            -candidateGenesFiltering 0 \
            -tx ENSEMBL \
            -REreport 1\
            -benignAF {ANNOTSV_BENIGN_AF} \
            {params.hpo_flag}
        """

rule annotsv_annotation_panel_only:
    input:
        tsv=rules.annotsv_annotation.output.tsv,
        genes=GENE_LIST
    output:
        tsv=PATH + "{sample}/sv/annotsv/{sample}_merged_SV.annotsv.panel_only.tsv"
    conda:
        CONDAENV + "annotsv.yaml"
    shell:
        """
        python {SCRIPTS}/filter_annotsv_panel.py \
            --annotsv {input.tsv} \
            --genes {input.genes} \
            --output {output.tsv}
        """


