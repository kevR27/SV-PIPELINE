rule filter_sniffles_sv:
    input:
        caller_vcf=rules.sniffles2_sv.output.vcf,
        caller_tsv=rules.sniffles2_caller_parse.output.tsv
    output:
        tsv=PATH + "{sample}/parsed/{sample}.sniffles.evidence.filtered.tsv",
        ids=PATH + "{sample}/parsed/{sample}.sniffles.pass.ids.txt",
        vcf=PATH + "{sample}/sv/sniffles2/{sample}_sniffles.filtered.vcf"
    conda:
        CONDAENV + "annotsv.yaml"
    params:
        min_gq_flag=lambda wc: f"--min-gq {EVIDENCE_MIN_GQ}" if EVIDENCE_MIN_GQ is not None else "",
        blacklist_flag=lambda wc: f"--blacklist-bed {EVIDENCE_BLACKLIST_BED}" if EVIDENCE_BLACKLIST_BED else ""
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.tsv}) $(dirname {output.vcf})

        python {FILTER_SV_EVIDENCE_SCRIPT} \
            --caller-tsv {input.caller_tsv} \
            --caller Sniffles2 \
            --min-support {EVIDENCE_MIN_SUPPORT} \
            --min-svlen {EVIDENCE_MIN_SVLEN} \
            --max-svlen {EVIDENCE_MAX_SVLEN} \
            {params.min_gq_flag} \
            {params.blacklist_flag} \
            --output-tsv {output.tsv} \
            --output-ids {output.ids}

        bcftools view -i "ID=@{output.ids}" -Ov -o {output.vcf} {input.caller_vcf}
        """


