    conda:
        CONDAENV + "cutesv.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {PATH}{wildcards.sample}/sv/cutesv

        cuteSV \
            {input.bam} \
            {input.ref} \
            {output.vcf} \
            {PATH}{wildcards.sample}/sv/cutesv \
            --threads {threads} \
            --max_cluster_bias_INS 100 \
            --diff_ratio_merging_INS 0.3 \
            --max_cluster_bias_DEL 100 \
            --diff_ratio_merging_DEL 0.3 \
            --min_support 2 \
            --min_size 50 \
