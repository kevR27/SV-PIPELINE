rule clair3_snp_calling:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        vcf=PATH + "{sample}/snp_clair3/{sample}.vcf.gz",
        tbi=PATH + "{sample}/snp_clair3/{sample}.vcf.gz.tbi"
    threads: THREADS
    conda:
        CONDAENV + "clair3.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {PATH}{wildcards.sample}/snp_clair3

        run_clair3.sh \
            -b {input.bam:q} \
            -f {input.ref:q} \
            -t {threads} \
            -p ont \
            -o {PATH}{wildcards.sample}/snp_clair3 \
            --model_path={CLAIRENV:q}

        cp {PATH}{wildcards.sample}/snp_clair3/merge_output.vcf.gz {output.vcf:q}
        tabix -f -p vcf {output.vcf:q}
        test -s {output.vcf:q}
        test -s {output.tbi:q}
        """


rule secondary_mtdna_candidate_review:
    input:
        vcf=rules.clair3_snp_calling.output.vcf,
        tbi=rules.clair3_snp_calling.output.tbi,
        script=SCRIPTS + "/summarize_secondary_mtdna_vcf.py"
    output:
        vcf=PATH + "{sample}/mtDNA/{sample}.clair3.secondary.vcf.gz",
        tbi=PATH + "{sample}/mtDNA/{sample}.clair3.secondary.vcf.gz.tbi",
        tsv=PATH + "{sample}/mtDNA/{sample}.clair3.secondary.tsv"
    conda:
        CONDAENV + "mtdna_review.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p "$(dirname {output.vcf:q})"

        # Keep this as a separate secondary review file. The complete Clair3
        # VCF remains unchanged and continues into the normal LRS workflow.
        bcftools view -r {MT_CONTIG:q} -f 'PASS,.' -Oz -o {output.vcf:q} {input.vcf:q}
        tabix -f -p vcf {output.vcf:q}

        python {input.script:q} \
            --vcf {output.vcf:q} \
            --source "Clair3 long-read candidate review" \
            --output {output.tsv:q}
        """


rule whatsHap_phasing:
    input:
        vcf=rules.clair3_snp_calling.output.vcf,
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        phased=PATH + "{sample}/phasing/{sample}.phased.vcf.gz",
        phased_index=PATH + "{sample}/phasing/{sample}.phased.vcf.gz.tbi",
        haplotag=PATH + "{sample}/phasing/{sample}.phased.bam",
        haplotag_index=PATH + "{sample}/phasing/{sample}.phased.bam.bai"
    conda:
        CONDAENV + "whatshap.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {PATH}{wildcards.sample}/phasing

        whatshap phase \
            --reference {input.ref:q} \
            -o {output.phased:q} \
            {input.vcf:q} \
            {input.bam:q} \
            --ignore-read-groups

        tabix -f -p vcf {output.phased:q}

        whatshap haplotag \
            -o {output.haplotag:q} \
            --reference {input.ref:q} \
            {output.phased:q} \
            {input.bam:q} \
            --ignore-read-groups

        samtools index {output.haplotag:q}
        """


