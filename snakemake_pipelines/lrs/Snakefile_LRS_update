rule sniffles2_sv:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        vcf=PATH + "{sample}/sv/sniffles2/{sample}_sniffles.vcf"
    threads: THREADS
    conda:
        CONDAENV + "sniffles2.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {PATH}{wildcards.sample}/sv/sniffles2

        sniffles \
            --input {input.bam} \
            --vcf {output.vcf} \
            --reference {input.ref} \
            --threads {threads} \
            --minsupport 2 \
            {SNIFFLES_NO_QC_FLAG} \
            {SNIFFLES_MOSAIC_FLAG} \
            --allow-overwrite \
            --min-alignment-length 100 \
            --output-rnames \
            --tandem-repeats {VNTR_BED}
        """


rule cutesv:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        vcf=PATH + "{sample}/sv/cutesv/{sample}_cutesv.vcf"
    threads: THREADS
    conda:
        CONDAENV + "cutesv.yaml"
    params:
        workdir=PATH + "{sample}/sv/cutesv/tmp"
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.vcf})
        rm -rf {params.workdir}
        mkdir -p {params.workdir}

        cuteSV \
            {input.bam} \
            {input.ref} \
            {output.vcf} \
            {params.workdir} \
            --threads {threads} \
            --max_cluster_bias_INS 100 \
            --diff_ratio_merging_INS 0.3 \
            --max_cluster_bias_DEL 100 \
            --diff_ratio_merging_DEL 0.3 \
            --min_support 2 \
            --min_size 50 \
            --min_mapq 20 \
            --min_read_len 500 \
            --genotype
        """


rule delly_lr:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        bcf=PATH + "{sample}/sv/delly/{sample}_delly.bcf",
        vcf=PATH + "{sample}/sv/delly/{sample}_delly.vcf"
    params:
        outdir=PATH + "{sample}/sv/delly"
    conda:
        CONDAENV + "delly.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {params.outdir}

        delly lr \
            -y {DELLY_GENOME} \
            -g {input.ref} \
            -o {output.bcf} \
            {input.bam}

        bcftools view {output.bcf} -Ov -o {output.vcf}
        """


