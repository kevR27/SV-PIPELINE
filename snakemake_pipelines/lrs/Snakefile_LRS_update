########################################################################
# Jasmine: caller consensus for one biological patient
#
# Each file represents one caller. We intentionally DO NOT use
# --allow_intrasample: a merged cluster should contain at most one record from
# each caller input, so SUPP is interpretable as distinct-caller concordance.
# --output_genotypes is also omitted; caller-specific genotype/evidence remains
# in the parsed caller tables and does not need to be duplicated as pseudo-samples.
########################################################################

rule jasmine_merge:
    input:
        sniffles=rules.filter_sniffles_sv.output.vcf,
        cutesv=rules.filter_cutesv_sv.output.vcf,
        delly=rules.filter_delly_sv.output.vcf,
        fai=REF + ".fai"
    output:
        list_file=PATH + "{sample}/sv/merged/{sample}_vcf_list.txt",
        raw_vcf=PATH + "{sample}/sv/merged/{sample}_merged_SV.raw.vcf",
        sanitized_vcf=PATH + "{sample}/sv/merged/{sample}_merged_SV.sanitized.vcf",
        vcf=PATH + "{sample}/sv/merged/{sample}_merged_SV.vcf.gz",
        tbi=PATH + "{sample}/sv/merged/{sample}_merged_SV.vcf.gz.tbi"
    params:
        outdir=PATH + "{sample}/sv/merged",
        sort_tmpdir=PATH + "{sample}/sv/merged/.bcftools_sort_tmp"
    conda:
        CONDAENV + "jasmine.yaml"
    threads: THREADS
    shell:
        """
        set -euo pipefail
        mkdir -p {params.outdir}
        rm -rf {params.sort_tmpdir}
        mkdir -p {params.sort_tmpdir}

        # IMPORTANT: this order must remain synchronized with
        # jasmine_caller_order in config_lrs.yaml.
        printf "%s\\n%s\\n%s\\n" \
            {input.sniffles} \
            {input.cutesv} \
            {input.delly} \
            > {output.list_file}

        jasmine \
            file_list={output.list_file} \
            out_file={output.raw_vcf} \
            threads={threads}

        test -s {output.raw_vcf}

        python {SCRIPTS}/sanitize_jasmine_vcf.py \
            --input {output.raw_vcf} \
            --output {output.sanitized_vcf} \
            --reference-fai {input.fai}

        # Parse the complete sanitized VCF before sorting so header/record
        # incompatibilities fail here rather than much later in AnnotSV/LongPhase.
        bcftools view -h {output.sanitized_vcf} >/dev/null
        bcftools view -Ov -o /dev/null {output.sanitized_vcf}

        bcftools sort \
            -T {params.sort_tmpdir} \
            -Oz \
            -o {output.vcf} \
            {output.sanitized_vcf}

        bcftools index -t -f {output.vcf}
        test -s {output.tbi}
        rm -rf {params.sort_tmpdir}
        """


rule summarize_caller_support:
    input:
        vcf=rules.jasmine_merge.output.vcf
    output:
        summary=PATH + "{sample}/sv/merged/{sample}_caller_support_summary.tsv",
        high_conf_vcf=PATH + "{sample}/sv/merged/{sample}_merged_SV.high_confidence.vcf.gz",
        tbi=PATH + "{sample}/sv/merged/{sample}_merged_SV.high_confidence.vcf.gz.tbi"
    params:
        raw_vcf=PATH + "{sample}/sv/merged/{sample}_merged_SV.high_confidence.raw.vcf"
    conda:
        CONDAENV + "annotsv.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.summary})

        python {SCRIPTS}/summarize_sv_caller_support.py \
            --vcf {input.vcf} \
            --output {output.summary} \
            --caller-order {JASMINE_CALLER_ORDER_CSV} \
            --min-callers {HIGH_CONFIDENCE_MIN_SUPP} \
            --high-confidence-vcf {params.raw_vcf}

        bcftools sort -Oz -o {output.high_conf_vcf} {params.raw_vcf}
        bcftools index -t -f {output.high_conf_vcf}
        test -s {output.tbi}
        """


########################################################################
# needLR v4.1 population annotation — side branch
#
# The RAW Sniffles VCF is the query. This preserves the exact original Sniffles
# IDs that Jasmine stores in IDLIST, allowing a safe variant-level AF join.
# needLR itself removes BNDs and >=10 Mb SVs; those remain in the Jasmine master
# set and are explicitly marked as not evaluated in the integrated table.
########################################################################

rule needlr_annotation:
    input:
        vcf=rules.sniffles2_sv.output.vcf
    output:
        tsv=PATH + "{sample}/sv/needlr/{sample}_needLR_RESULTS.tsv",
        vcf=PATH + "{sample}/sv/needlr/{sample}_needLR_RESULTS.vcf.gz",
        tbi=PATH + "{sample}/sv/needlr/{sample}_needLR_RESULTS.vcf.gz.tbi"
    params:
        run_dir=PATH + "{sample}/sv/needlr/run_v4_1",
        backend_flag=lambda wc: f"-B {NEEDLR_BACKEND}" if NEEDLR_BACKEND else ""
    conda:
        CONDAENV + "needlr.yaml"
    threads: THREADS
    shell:
        """
        set -euo pipefail

        # Avoid stale-file selection from earlier needLR runs.
        rm -rf {params.run_dir}
        mkdir -p {params.run_dir}

        needLR annotate \
            -O {params.run_dir} \
            -T {threads} \
            {params.backend_flag} \
            --all \
            {input.vcf}

        results_tsv=$(find {params.run_dir} -type f -name '*_RESULTS.tsv' | sort | head -n 1)
        test -n "$results_tsv" || {{ echo "ERROR: no needLR *_RESULTS.tsv found under {params.run_dir}" >&2; exit 1; }}

        results_dir=$(dirname "$results_tsv")
        results_vcf=$(find "$results_dir" -maxdepth 1 -type f -name '*.vcf.gz' | sort | head -n 1)
        test -n "$results_vcf" || {{ echo "ERROR: no final needLR VCF found beside $results_tsv" >&2; exit 1; }}

        cp "$results_tsv" {output.tsv}
        cp "$results_vcf" {output.vcf}

        bcftools index -t -f {output.vcf}
        test -s {output.tbi}
        """


