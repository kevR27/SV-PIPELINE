########################################################################
# AnnotSV — the complete Jasmine master callset is the source of truth.
# The panel-only output is a derived view, not a second discovery analysis.
########################################################################

rule annotsv_annotations_check:
    output:
        marker=ANNOTSV_ANNOTATIONS_DIR + "/.installed"
    shell:
        """
        set -euo pipefail
        test -d {ANNOTSV_ANNOTATIONS_DIR}/Annotations_Human
        test -d {ANNOTSV_ANNOTATIONS_DIR}/Annotations_Exomiser
        touch {output.marker}
        """


rule annotsv_annotation:
    input:
        vcf=rules.jasmine_merge.output.vcf,
        annotations=rules.annotsv_annotations_check.output.marker
    output:
        tsv=PATH + "{sample}/sv/annotsv/{sample}_merged_SV.annotsv.tsv"
    params:
        outdir=PATH + "{sample}/sv/annotsv",
        hpo_flag=lambda wc: f"-hpo {HPO_TERMS}" if HPO_TERMS else ""
    conda:
        CONDAENV + "annotsv.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {params.outdir}

        AnnotSV \
            -SVinputFile {input.vcf} \
            -annotationsDir {ANNOTSV_ANNOTATIONS_DIR} \
            -outputDir {params.outdir} \
            -outputFile {wildcards.sample}_merged_SV.annotsv.tsv \
            -genomeBuild GRCh38 \
            -candidateGenesFile {GENE_LIST} \
            -candidateGenesFiltering 0 \
            -tx ENSEMBL \
            -REreport 1 \
            -benignAF {ANNOTSV_BENIGN_AF} \
            {params.hpo_flag}
        """


rule annotsv_annotation_panel_only:
    input:
        tsv=rules.annotsv_annotation.output.tsv,
        genes=GENE_LIST
    output:
        tsv=PATH + "{sample}/sv/annotsv/{sample}_merged_SV.annotsv.panel_only.tsv"
    shell:
        """
        set -euo pipefail
        python {SCRIPTS}/filter_annotsv_panel.py \
            --annotsv {input.tsv} \
            --genes {input.genes} \
            --output {output.tsv}
        """


########################################################################
# Genome-wide HUMAN gene / phenotype discovery
########################################################################

rule extract_sv_genes:
    input:
        annotsv=rules.annotsv_annotation.output.tsv
    output:
        genes=PATH + "{sample}/gene_discovery/{sample}_SV_genes.txt"
    shell:
        """
        set -euo pipefail
        mkdir -p {PATH}{wildcards.sample}/gene_discovery
        python {SCRIPTS}/extract_annotsv_genes.py \
            --annotsv {input.annotsv} \
            --output {output.genes}
        """


rule extract_nonpanel_genes:
    input:
        genes=rules.extract_sv_genes.output.genes,
        panel=GENE_LIST
    output:
        genes=PATH + "{sample}/gene_discovery/{sample}_nonpanel_genes.txt"
    shell:
        """
        set -euo pipefail
        python {SCRIPTS}/extract_nonpanel_genes.py \
            --genes {input.genes} \
            --panel {input.panel} \
            --output {output.genes}
        """


rule human_gene_phenotypes:
    input:
        # All SV-overlapped genes are evaluated. Panel membership is retained
        # as a flag rather than excluding known genes from phenotype analysis.
        genes=rules.extract_sv_genes.output.genes,
        hpo=DISCOVERY_HPO_FILE,
        nodes=MONARCH_NODES,
        edges=MONARCH_EDGES
    output:
        tsv=PATH + "{sample}/gene_discovery/{sample}_human_gene_phenotypes.tsv"
    shell:
        """
        set -euo pipefail
        mkdir -p {PATH}{wildcards.sample}/gene_discovery
        python {SCRIPTS}/monarch_human_gene_phenotypes_offline.py \
            --genes {input.genes} \
            --hpo-anchors {input.hpo} \
            --nodes {input.nodes} \
            --edges {input.edges} \
            --output {output.tsv}
        """


rule rank_genomewide_candidates:
    input:
        annotsv=rules.annotsv_annotation.output.tsv,
        genes=rules.extract_sv_genes.output.genes,
        phenotypes=rules.human_gene_phenotypes.output.tsv,
        panel=GENE_LIST
    output:
        tsv=PATH + "{sample}/gene_discovery/{sample}_ranked_candidates.tsv"
    shell:
        """
        set -euo pipefail
        python {SCRIPTS}/rank_sv_gene_candidates.py \
            --annotsv {input.annotsv} \
            --genes {input.genes} \
            --phenotypes {input.phenotypes} \
            --panel {input.panel} \
            --output {output.tsv}
        """


########################################################################
# Integrated master evidence table
########################################################################

rule integrated_sv_gene_table:
    input:
        vcf=rules.jasmine_merge.output.vcf,
        annotsv=rules.annotsv_annotation.output.tsv,
        needlr=rules.needlr_annotation.output.tsv,
        ranking=rules.rank_genomewide_candidates.output.tsv,
        panel=GENE_LIST,
        # Use the evidence tables that actually determined Jasmine membership,
        # not the unfiltered/raw parsed TSVs.
        sniffles=rules.filter_sniffles_sv.output.tsv,
        cutesv=rules.filter_cutesv_sv.output.tsv,
        delly=rules.filter_delly_sv.output.tsv
    output:
        tsv=PATH + "{sample}/gene_discovery/{sample}_integrated_SV_gene_analysis.tsv"
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.tsv})

        python {SCRIPTS}/build_integrated_sv_gene_tsv.py \
            --vcf {input.vcf} \
            --annotsv {input.annotsv} \
            --needlr {input.needlr} \
            --ranking {input.ranking} \
            --panel {input.panel} \
            --caller-order {JASMINE_CALLER_ORDER_CSV} \
            --caller-tsv {input.sniffles} \
            --caller-tsv {input.cutesv} \
            --caller-tsv {input.delly} \
            --output {output.tsv}
        """


