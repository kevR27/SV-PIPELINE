################
# Methylation  #
################

rule modkit_pileup:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        bed=PATH + "{sample}/methylation/{sample}.cpg.bedmethyl.gz",
        tbi=PATH + "{sample}/methylation/{sample}.cpg.bedmethyl.gz.tbi"
    threads: THREADS
    conda:
        CONDAENV + "modkit.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.bed})

        # Main methylation product for downstream regional plots and cohort
        # comparisons. Keep 5mC and 5hmC as separate modification classes.
        modkit pileup \
            {input.bam} \
            {output.bed} \
            --ref {input.ref} \
            {CPG_REGION_FLAG} \
            --cpg \
            --combine-strands \
            --modified-bases 5mC 5hmC \
            --bgzf \
            --threads {threads}

        tabix -f -p bed {output.bed}

        test -s {output.bed}
        test -s {output.tbi}
        """


# Optional read-level methylation output.
# Run this rule only when individual-read information is needed, for example
# for haplotype-specific or read-level follow-up of an interesting locus.
rule modkit_extract:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        tsv=PATH + "{sample}/methylation/{sample}.modkit.calls.tsv"
    threads: THREADS
    conda:
        CONDAENV + "modkit.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.tsv})

        modkit extract calls \
            -t {threads} \
            --reference {input.ref} \
            {CPG_REGION_FLAG} \
            {input.bam} \
            {output.tsv}

        test -s {output.tsv}
        """


####################################################
# SV-aware SNP + SV phasing with LongPhase         #
####################################################

rule longphase_phasing:
    input:
        vcf=rules.clair3_snp_calling.output.vcf,
        # Use the same-patient genotyped Sniffles VCF for phasing. Jasmine is
        # the annotation/master consensus, but its cross-caller merge is not a
        # genotype source for LongPhase.
        sv_vcf=rules.filter_sniffles_sv.output.vcf,
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        vcf=PATH + "{sample}/phasing_longphase/{sample}.longphase.vcf.gz"
    params:
        prefix=PATH + "{sample}/phasing_longphase/{sample}.longphase"
    threads: THREADS
    conda:
        CONDAENV + "longphase.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.vcf})

        longphase phase \
            -s {input.vcf} \
            --sv-file {input.sv_vcf} \
            -b {input.bam} \
            -r {input.ref} \
            -t {threads} \
            -o {params.prefix} \
            --ont

        test -s {params.prefix}.vcf
        bgzip -f {params.prefix}.vcf
        test -s {output.vcf}
        tabix -f -p vcf {output.vcf}
        """


############################
# Confirmatory MEI — TLDR  #
############################

rule tldr_mei_confirmation:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        table=PATH + "{sample}/mei/tldr/{sample}.tldr.table.txt"
    params:
        outbase=PATH + "{sample}/mei/tldr/{sample}"
    threads: THREADS
    conda:
        CONDAENV + "tldr.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.table})

        tldr \
            -b {input.bam} \
            -r {input.ref} \
            -e {TLDR_ELTS} \
            -p {threads} \
            --color_consensus \
            -o {params.outbase}

        cp {params.outbase}.table.txt {output.table}
        test -s {output.table}
        """
