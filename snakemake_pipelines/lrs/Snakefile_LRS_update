rule sniffles2_sv:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        vcf=PATH + "{sample}/sv/sniffles2/{sample}_sniffles.vcf"
    threads: THREADS
    conda:
        CONDAENV + "sniffles2.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {PATH}{wildcards.sample}/sv/sniffles2

        sniffles \
            --input {input.bam:q} \
            --vcf {output.vcf:q} \
            --reference {input.ref:q} \
            --threads {threads} \
            --minsupport 2 \
            {SNIFFLES_NO_QC_FLAG} \
            {SNIFFLES_QC_OUTPUT_ALL_FLAG} \
            {SNIFFLES_MOSAIC_FLAG} \
            --allow-overwrite \
            --min-alignment-length {SNIFFLES_MIN_ALIGNMENT_LENGTH} \
            --output-rnames \
            --tandem-repeats {VNTR_BED:q}
        """


rule cutesv:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        vcf=PATH + "{sample}/sv/cutesv/{sample}_cutesv.vcf"
    threads: THREADS
    conda:
        CONDAENV + "cutesv.yaml"
    params:
        workdir=PATH + "{sample}/sv/cutesv/tmp"
    shell:
        """
        set -euo pipefail
        mkdir -p "$(dirname {output.vcf:q})"
        rm -rf {params.workdir:q}
        mkdir -p {params.workdir:q}

        cuteSV \
            {input.bam:q} \
            {input.ref:q} \
            {output.vcf:q} \
            {params.workdir:q} \
            --threads {threads} \
            --max_cluster_bias_INS 100 \
            --diff_ratio_merging_INS 0.3 \
            --max_cluster_bias_DEL 100 \
            --diff_ratio_merging_DEL 0.3 \
            --min_support 2 \
            --min_size 50 \
            --max_size -1 \
            --min_mapq 20 \
            --min_read_len 500 \
            --genotype
        """


rule delly_lr:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        bcf=PATH + "{sample}/sv/delly/{sample}_delly.bcf",
        vcf=PATH + "{sample}/sv/delly/{sample}_delly.vcf"
    params:
        outdir=PATH + "{sample}/sv/delly"
    conda:
        CONDAENV + "delly.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {params.outdir:q}

        delly lr \
            -y {DELLY_GENOME} \
            -g {input.ref:q} \
            -o {output.bcf:q} \
            {input.bam:q}

        bcftools view {output.bcf:q} -Ov -o {output.vcf:q}
        """


