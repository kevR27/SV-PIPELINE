################
# QC           #
################

rule mosdepth_coverage:
    input:
        bam=lambda wc: BAMS[wc.sample]
    output:
        global_dist=PATH + "{sample}/coverage/{sample}.mosdepth.global.dist.txt",
        summary=PATH + "{sample}/coverage/{sample}.mosdepth.summary.txt"
    params:
        prefix=PATH + "{sample}/coverage/{sample}"
    threads: THREADS
    conda:
        CONDAENV + "mosdepth.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.global_dist})
        mosdepth -t {threads} {params.prefix} {input.bam}
        test -s {output.global_dist}
        test -s {output.summary}
        """


##################################
# Small variant calling (control)
##################################

rule clair3_snp_calling:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        vcf=PATH + "{sample}/snp_clair3/{sample}.vcf.gz"
    threads: THREADS
    conda:
        CONDAENV + "clair3.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {PATH}{wildcards.sample}/snp_clair3

        run_clair3.sh \
            -b {input.bam} \
            -f {input.ref} \
            -t {threads} \
            -p ont \
            -o {PATH}{wildcards.sample}/snp_clair3 \
            --model_path={CLAIRENV} \
            --bed_fn={BED}

        cp {PATH}{wildcards.sample}/snp_clair3/merge_output.vcf.gz {output.vcf}
        tabix -f -p vcf {output.vcf}
        test -s {output.vcf}
        """


rule whatsHap_phasing:
    input:
        vcf=rules.clair3_snp_calling.output.vcf,
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        phased=PATH + "{sample}/phasing/{sample}.phased.vcf.gz",
        haplotag=PATH + "{sample}/phasing/{sample}.phased.bam"
    conda:
        CONDAENV + "whatshap.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {PATH}{wildcards.sample}/phasing

        whatshap phase \
            --reference {input.ref} \
            -o {output.phased} \
            {input.vcf} \
            {input.bam} \
            --ignore-read-groups

        tabix -f -p vcf {output.phased}

        whatshap haplotag \
            -o {output.haplotag} \
            --reference {input.ref} \
            {output.phased} \
            {input.bam} \
            --ignore-read-groups

        samtools index {output.haplotag}
        """


