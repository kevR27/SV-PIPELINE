# Jasmine per-patient caller merge     #
########################################

rule jasmine_merge:
    input:
        sniffles=rules.filter_sniffles_sv.output.vcf,
        cutesv=rules.filter_cutesv_sv.output.vcf,
        delly=rules.filter_delly_sv.output.vcf,
        fai=REF + ".fai"
    output:
        list_file=PATH + "{sample}/sv/merged/{sample}_vcf_list.txt",
        raw_vcf=temp(PATH + "{sample}/sv/merged/{sample}_merged_SV.raw.vcf"),
        vcf=PATH + "{sample}/sv/merged/{sample}_merged_SV.vcf.gz",
        tbi=PATH + "{sample}/sv/merged/{sample}_merged_SV.vcf.gz.tbi"
    params:
        outdir=PATH + "{sample}/sv/merged",
        sort_tmpdir=PATH + "{sample}/sv/merged/.bcftools_sort_tmp",
        sanitized_vcf=PATH + "{sample}/sv/merged/{sample}_merged_SV.sanitized.vcf"
    threads: THREADS
    conda:
        CONDAENV + "jasmine.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {params.outdir}
        rm -rf {params.sort_tmpdir}
        mkdir -p {params.sort_tmpdir}

        # This order defines the meaning of Jasmine SUPP_VEC.
        printf "%s\\n%s\\n%s\\n" \
            {input.sniffles} \
            {input.cutesv} \
            {input.delly} \
            > {output.list_file}

        jasmine \
            file_list={output.list_file} \
            out_file={output.raw_vcf} \
            threads={threads} \
            --allow_intrasample

        python {SCRIPTS}/sanitize_jasmine_vcf.py \
            --input {output.raw_vcf} \
            --output {params.sanitized_vcf} \
            --reference-fai {input.fai}

        bcftools sort \
            -T {params.sort_tmpdir} \
            -Oz \
            -o {output.vcf} \
            {params.sanitized_vcf}

        tabix -f -p vcf {output.vcf}
        test -s {output.vcf}
        test -s {output.tbi}

        rm -rf {params.sort_tmpdir}
        rm -f {params.sanitized_vcf}
        """


rule summarize_caller_support:
    input:
        vcf=rules.jasmine_merge.output.vcf
    output:
        summary=PATH + "{sample}/sv/merged/{sample}_caller_support_summary.tsv",
        high_conf_vcf=PATH + "{sample}/sv/merged/{sample}_merged_SV.high_confidence.vcf.gz",
        tbi=PATH + "{sample}/sv/merged/{sample}_merged_SV.high_confidence.vcf.gz.tbi"
    params:
        raw_vcf=PATH + "{sample}/sv/merged/{sample}_merged_SV.high_confidence.vcf"
    conda:
        CONDAENV + "annotsv.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.summary})

        python {SCRIPTS}/summarize_sv_caller_support.py \
            --vcf {input.vcf} \
            --output {output.summary} \
            --caller-order "{JASMINE_CALLER_ORDER}" \
            --min-callers {HIGH_CONFIDENCE_MIN_SUPP} \
            --high-confidence-vcf {params.raw_vcf}

        bgzip -f {params.raw_vcf}
        tabix -f -p vcf {output.high_conf_vcf}
        """


########################################################
# needLR-compatible independent population-AF branch  #
########################################################

rule sniffles2_needlr_query:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        vcf=PATH + "{sample}/sv/needlr_query/{sample}.needlr.sniffles.vcf"
    threads: THREADS
    conda:
        CONDAENV + "sniffles2.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.vcf})

        # Dedicated Sniffles2 v2.6.2 query matching the caller used to build
        # the needLR ONT reference as closely as possible. Do not substitute
        # the cross-caller Jasmine consensus here.
        sniffles \
            --input {input.bam} \
            --reference {input.ref} \
            --output-rnames \
            --vcf {output.vcf} \
            --allow-overwrite \
            --tandem-repeats {VNTR_BED} \
            --threads {threads}
        """


rule needlr_annotation:
    input:
        vcf=rules.sniffles2_needlr_query.output.vcf
    output:
        tsv=PATH + "{sample}/sv/needlr/{sample}_needLR_RESULTS.tsv",
        vcf=PATH + "{sample}/sv/needlr/{sample}_needLR_RESULTS.vcf.gz"
    log:
        PATH + "{sample}/logs/needlr/{sample}.needlr.log"
    params:
        outdir=PATH + "{sample}/sv/needlr/annotate_out"
    threads: THREADS
    conda:
        CONDAENV + "needlr.yaml"
    shell:
        """
        set -eu

        rm -rf {params.outdir}
        mkdir -p {params.outdir}
        mkdir -p $(dirname {log})

        needLR annotate \
            -O {params.outdir} \
            -T {threads} \
            -B {NEEDLR_BACKEND} \
            --all \
            {input.vcf} \
            > {log} 2>&1

        results_tsv=$(find {params.outdir} \
            -type f \
            -name '*_RESULTS.tsv' \
            -print -quit)

        results_vcf=$(find {params.outdir} \
            -type f \
            -name '*_RESULTS.vcf.gz' \
            -print -quit)

        test -n "$results_tsv"
        test -n "$results_vcf"

        cp "$results_tsv" {output.tsv}
        cp "$results_vcf" {output.vcf}

        test -s {output.tsv}
        test -s {output.vcf}
        """

##################################################
# Tandem-repeat expansion discovery / annotation #
##################################################

rule straglr:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        vcf=PATH + "{sample}/sv/straglr/{sample}_straglr.vcf",
        bed=PATH + "{sample}/sv/straglr/{sample}_straglr.bed",
        tsv=PATH + "{sample}/sv/straglr/{sample}_straglr.tsv"
    params:
        prefix=PATH + "{sample}/sv/straglr/{sample}_straglr"
    threads: THREADS
    conda:
        CONDAENV + "straglr.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {PATH}{wildcards.sample}/sv/straglr

        python {STRAGLR_SCRIPT} \
            {input.bam} \
            {input.ref} \
            {params.prefix} \
            --min_str_len 2 \
            --min_support 2 \
            --min_ins_size 100 \
            --nprocs {threads} \
            {STRAGLR_REGIONS} \
            --max_str_len 100000 \
            --max_num_clusters 2 \
            --min_cluster_d 1
        """

rule straglr_annotation:
    input:
        tsv=rules.straglr.output.tsv,
        bed=rules.straglr.output.bed,
        genes=GENEBED
    output:
        tsv=PATH + "{sample}/sv/straglr/{sample}_straglr.annotated.tsv"
    conda:
        CONDAENV + "straglr.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.tsv})
        python {SCRIPTS}/annotate_straglr.py \
            --straglr-tsv {input.tsv} \
            --straglr-bed {input.bed} \
            --gene-bed {input.genes} \
            --output {output.tsv} \
            --min-overlap {STRAGLR_MIN_OVERLAP}
        """


###############################################################
# AnnotSV — master genome-wide annotation from Jasmine VCF    #
###############################################################

rule annotsv_annotations_check:
    output:
        marker=ANNOTSV_ANNOTATIONS_DIR + "/.installed"
    shell:
        """
        set -euo pipefail
        test -d {ANNOTSV_ANNOTATIONS_DIR}/Annotations_Human
        test -d {ANNOTSV_ANNOTATIONS_DIR}/Annotations_Exomiser
        touch {output.marker}
        """


rule annotsv_annotation:
    input:
        vcf=rules.jasmine_merge.output.vcf,
        annotations=rules.annotsv_annotations_check.output.marker
    output:
        tsv=PATH + "{sample}/sv/annotsv/{sample}_merged_SV.annotsv.tsv"
    params:
        outdir=PATH + "{sample}/sv/annotsv",
        hpo_flag=lambda wc: f"-hpo {HPO_TERMS}" if HPO_TERMS else ""
    conda:
        CONDAENV + "annotsv.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {params.outdir}

        AnnotSV \
            -SVinputFile {input.vcf} \
            -annotationsDir {ANNOTSV_ANNOTATIONS_DIR} \
            -outputDir {params.outdir} \
            -outputFile {wildcards.sample}_merged_SV.annotsv.tsv \
            -genomeBuild GRCh38 \
            -candidateGenesFile {GENE_LIST} \
            -candidateGenesFiltering 0 \
            -tx ENSEMBL \
            -REreport 1 \
            -benignAF {ANNOTSV_BENIGN_AF} \
            {params.hpo_flag}

        test -s {output.tsv}
        """


rule annotsv_annotation_panel_only:
    input:
        tsv=rules.annotsv_annotation.output.tsv,
        genes=GENE_LIST
    output:
        tsv=PATH + "{sample}/sv/annotsv/{sample}_merged_SV.annotsv.panel_only.tsv"
    conda:
        CONDAENV + "annotsv.yaml"
    shell:
        """
        python {SCRIPTS}/filter_annotsv_panel.py \
            --annotsv {input.tsv} \
            --genes {input.genes} \
            --output {output.tsv}
        """


####################################
# Genome-wide human gene discovery #
####################################

rule extract_sv_genes:
    input:
        annotsv=rules.annotsv_annotation.output.tsv
    output:
        genes=PATH + "{sample}/gene_discovery/{sample}_SV_genes.txt"
    conda:
        CONDAENV + "monarch.yaml"
    shell:
        """
        mkdir -p $(dirname {output.genes})
        python {SCRIPTS}/extract_annotsv_genes.py \
            --annotsv {input.annotsv} \
            --output {output.genes}
        """


rule extract_nonpanel_genes:
    input:
        genes=rules.extract_sv_genes.output.genes,
        panel=GENE_LIST
    output:
        genes=PATH + "{sample}/gene_discovery/{sample}_nonpanel_genes.txt"
    conda:
        CONDAENV + "monarch.yaml"
    shell:
        """
        python {SCRIPTS}/extract_nonpanel_genes.py \
            --genes {input.genes} \
            --panel {input.panel} \
            --output {output.genes}
        """


rule human_gene_phenotypes:
    input:
        # Use ALL SV-overlapping genes. Panel membership is an annotation, not
        # an exclusion criterion for phenotype retrieval.
        genes=rules.extract_sv_genes.output.genes,
        hpo=DISCOVERY_HPO_FILE,
        nodes=MONARCH_NODES,
        edges=MONARCH_EDGES
    output:
        tsv=PATH + "{sample}/gene_discovery/{sample}_human_gene_phenotypes.tsv"
    conda:
        CONDAENV + "monarch.yaml"
    shell:
        """
        mkdir -p $(dirname {output.tsv})
        python {SCRIPTS}/monarch_human_gene_phenotypes_offline.py \
            --genes {input.genes} \
            --hpo-anchors {input.hpo} \
            --nodes {input.nodes} \
            --edges {input.edges} \
            --output {output.tsv}
        """


rule rank_genomewide_candidates:
    input:
        annotsv=rules.annotsv_annotation.output.tsv,
        genes=rules.extract_sv_genes.output.genes,
        phenotypes=rules.human_gene_phenotypes.output.tsv,
        panel=GENE_LIST
    output:
        tsv=PATH + "{sample}/gene_discovery/{sample}_ranked_candidates.tsv"
    conda:
        CONDAENV + "monarch.yaml"
    shell:
        """
        python {SCRIPTS}/rank_sv_gene_candidates.py \
            --annotsv {input.annotsv} \
            --genes {input.genes} \
            --phenotypes {input.phenotypes} \
            --panel {input.panel} \
            --output {output.tsv}
        """


############################################
# Integrated master SV / gene evidence TSV #
############################################

rule integrated_sv_gene_table:
    input:
        vcf=rules.jasmine_merge.output.vcf,
        annotsv=rules.annotsv_annotation.output.tsv,
        needlr=rules.needlr_annotation.output.tsv,
