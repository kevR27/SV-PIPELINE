import os

configfile: "config_lrs.yaml"

SAMPLES = list(config["samples"].keys())
BAMS = config["samples"]
PATH = config["path"].rstrip("/") + "/"
REF = config["ref"]
THREADS = config["threads"]
BED = config["bed"]
GENEBED = config["gene_bed"]
GENE_LIST = config["candidate_genes_list"]
CONDAENV = config["condaenv"]
CLAIRENV = config["clair3env"]
TLDR_ELTS = config["tldr_elements"]
VNTR_BED = config["vntr_bed"]

# ------------------------------------------------------------------
# Repeat expansions / methylation
# ------------------------------------------------------------------
STRAGLR_BED = config.get("straglr_bed")
STRAGLR_REGIONS = f"--regions {STRAGLR_BED}" if STRAGLR_BED else ""
STRAGLR_SCRIPT = config.get("straglr_script", "straglr.py")
STRAGLR_MIN_OVERLAP = config.get("straglr_annotation_min_overlap", 1)

CPG_REGION = config.get("cpg_region")
CPG_REGION_FLAG = f"--region {CPG_REGION}" if CPG_REGION else ""

# ------------------------------------------------------------------
# needLR population/reference annotation
# ------------------------------------------------------------------
NEEDLR_BACKEND = config.get("needlr_backend_files")

# ------------------------------------------------------------------
# Offline human gene/HPO discovery
# ------------------------------------------------------------------
MONARCH_NODES = config["monarch_nodes"]
MONARCH_EDGES = config["monarch_edges"]
DISCOVERY_HPO_FILE = config.get(
    "discovery_hpo_file",
    "reference/optic_neuropathy_hpo_terms.tsv",
)

# ------------------------------------------------------------------
# AnnotSV / VEP
# ------------------------------------------------------------------
ANNOTSV_BENIGN_AF = config.get("annotsv_benign_af", 0.01)
HPO_TERMS = config.get("hpo_terms")
ANNOTSV_ANNOTATIONS_DIR = config.get(
    "annotsv_annotations_dir",
    PATH + "reference/AnnotSV_annotations",
)
VEP_CACHE_DIR = config["vep_cache_dir"]
VEP_ASSEMBLY = config.get("vep_assembly", "GRCh38")

# ------------------------------------------------------------------
# Caller options
# ------------------------------------------------------------------
SNIFFLES_MOSAIC = config.get("sniffles_mosaic", False)
SNIFFLES_MOSAIC_FLAG = "--mosaic" if SNIFFLES_MOSAIC else ""
DELLY_GENOME = config.get("delly_genome", "ont")

# ------------------------------------------------------------------
# Pre-Jasmine caller evidence filtering
# ------------------------------------------------------------------
FILTER_SV_EVIDENCE_SCRIPT = config["filter_sv_evidence_script"]
EVIDENCE_MIN_SUPPORT = config.get("evidence_min_support", 2)
EVIDENCE_MIN_SVLEN = config.get("evidence_min_svlen", 50)
EVIDENCE_MAX_SVLEN = config.get("evidence_max_svlen", 250_000_000)
EVIDENCE_MIN_GQ = config.get("evidence_min_gq")
EVIDENCE_BLACKLIST_BED = config.get("evidence_blacklist_bed")

# ------------------------------------------------------------------
# Jasmine caller provenance
# SUPP_VEC/IDLIST are decoded according to this exact file-list order.
# ------------------------------------------------------------------
JASMINE_CALLER_ORDER = config.get(
    "jasmine_caller_order",
    ["Sniffles2", "cuteSV", "delly"],
)
JASMINE_CALLER_ORDER_CSV = ",".join(JASMINE_CALLER_ORDER)
HIGH_CONFIDENCE_MIN_SUPP = config.get("high_confidence_min_supp", 2)

# Python scripts are anchored to the Snakefile rather than current cwd.
SCRIPTS = os.path.abspath(os.path.join(workflow.basedir, "../../scripts"))


rule all:
    input:
        # QC
        expand(PATH + "{sample}/coverage/{sample}.mosdepth.global.dist.txt", sample=SAMPLES),
        expand(PATH + "{sample}/coverage/{sample}.mosdepth.summary.txt", sample=SAMPLES),

        # Complementary panel-targeted small variants + phasing
        expand(PATH + "{sample}/snp_clair3/{sample}.vcf.gz", sample=SAMPLES),
        expand(PATH + "{sample}/snp_clair3/{sample}.vcf.gz.tbi", sample=SAMPLES),
        expand(PATH + "{sample}/phasing/{sample}.phased.vcf.gz", sample=SAMPLES),
        expand(PATH + "{sample}/phasing/{sample}.phased.vcf.gz.tbi", sample=SAMPLES),
        expand(PATH + "{sample}/phasing/{sample}.phased.bam", sample=SAMPLES),
        expand(PATH + "{sample}/phasing/{sample}.phased.bam.bai", sample=SAMPLES),

        # Raw genome-wide SV caller outputs
        expand(PATH + "{sample}/sv/sniffles2/{sample}_sniffles.vcf", sample=SAMPLES),
        expand(PATH + "{sample}/sv/cutesv/{sample}_cutesv.vcf", sample=SAMPLES),
        expand(PATH + "{sample}/sv/delly/{sample}_delly.vcf", sample=SAMPLES),

        # Caller-aware raw evidence
        expand(PATH + "{sample}/parsed/{sample}.sniffles.caller.tsv", sample=SAMPLES),
        expand(PATH + "{sample}/parsed/{sample}.cutesv.caller.tsv", sample=SAMPLES),
        expand(PATH + "{sample}/parsed/{sample}.delly.caller.tsv", sample=SAMPLES),

        # Pre-merge filtered evidence + PASS IDs + the actual Jasmine inputs
        expand(PATH + "{sample}/parsed/{sample}.sniffles.evidence.filtered.tsv", sample=SAMPLES),
        expand(PATH + "{sample}/parsed/{sample}.sniffles.pass.ids.txt", sample=SAMPLES),
        expand(PATH + "{sample}/sv/sniffles2/{sample}_sniffles.filtered.vcf", sample=SAMPLES),
        expand(PATH + "{sample}/parsed/{sample}.cutesv.evidence.filtered.tsv", sample=SAMPLES),
        expand(PATH + "{sample}/parsed/{sample}.cutesv.pass.ids.txt", sample=SAMPLES),
        expand(PATH + "{sample}/sv/cutesv/{sample}_cutesv.filtered.vcf", sample=SAMPLES),
        expand(PATH + "{sample}/parsed/{sample}.delly.evidence.filtered.tsv", sample=SAMPLES),
        expand(PATH + "{sample}/parsed/{sample}.delly.pass.ids.txt", sample=SAMPLES),
        expand(PATH + "{sample}/sv/delly/{sample}_delly.filtered.vcf", sample=SAMPLES),

        # Jasmine audit trail + validated master callset
        expand(PATH + "{sample}/sv/merged/{sample}_vcf_list.txt", sample=SAMPLES),
        expand(PATH + "{sample}/sv/merged/{sample}_merged_SV.raw.vcf", sample=SAMPLES),
        expand(PATH + "{sample}/sv/merged/{sample}_merged_SV.sanitized.vcf", sample=SAMPLES),
        expand(PATH + "{sample}/sv/merged/{sample}_merged_SV.vcf.gz", sample=SAMPLES),
        expand(PATH + "{sample}/sv/merged/{sample}_merged_SV.vcf.gz.tbi", sample=SAMPLES),
        expand(PATH + "{sample}/sv/merged/{sample}_caller_support_summary.tsv", sample=SAMPLES),
        expand(PATH + "{sample}/sv/merged/{sample}_merged_SV.high_confidence.vcf.gz", sample=SAMPLES),
        expand(PATH + "{sample}/sv/merged/{sample}_merged_SV.high_confidence.vcf.gz.tbi", sample=SAMPLES),

        # needLR is a side population-frequency/annotation branch from raw Sniffles.
