    threads: THREADS
    shell:
        """
        set -euo pipefail
        mkdir -p {PATH}{wildcards.sample}/mei/tldr

        tldr \
            -b {input.bam} \
            -r {input.ref} \
            -e {TLDR_ELTS} \
            -p {threads} \
            --color_consensus \
            -o {params.outbase}

        cp {params.outbase}.table.txt {output.table}
        test -s {output.table}
        """
