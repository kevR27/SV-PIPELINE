rule modkit_pileup:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        bed=PATH + "{sample}/methylation/{sample}.cpg.bedmethyl.gz",
        tbi=PATH + "{sample}/methylation/{sample}.cpg.bedmethyl.gz.tbi"
    log:
        PATH + "{sample}/logs/modkit/{sample}.modkit.log"
    threads: THREADS
    conda:
        CONDAENV + "modkit.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p "$(dirname {output.bed:q})"
        mkdir -p "$(dirname {log:q})"

        # modkit 0.6.4: explicitly retain 5mC and 5hmC as separate
        # modification classes, restrict to CpG sites, combine CpG strands,
        # and write BGZF-compressed bedMethyl directly for tabix indexing.
        {MODKIT:q} pileup \
            {input.bam:q} \
            {output.bed:q} \
            --reference {input.ref:q} \
            {CPG_REGION_FLAG} \
            --cpg \
            --modified-bases 5mC 5hmC \
            --combine-strands \
            --bgzf \
            --threads {threads} \
            --io-threads {MODKIT_IO_THREADS} \
            --sampling-threads {MODKIT_SAMPLING_THREADS} \
            --bgzf-threads {MODKIT_BGZF_THREADS} \
            --log-filepath {log:q}

        tabix -f -p bed {output.bed:q}

        test -s {output.bed:q}
        test -s {output.tbi:q}
        """

# Optional read-level methylation output.
# Run this rule only when individual-read information is needed, for example
# for haplotype-specific or read-level follow-up of an interesting locus.
rule modkit_extract:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        tsv=PATH + "{sample}/methylation/{sample}.modkit.calls.tsv"
    threads: THREADS
    conda:
        CONDAENV + "modkit.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p "$(dirname {output.tsv:q})"

        {MODKIT:q} extract calls \
            -t {threads} \
            --reference {input.ref:q} \
            {CPG_REGION_FLAG} \
            {input.bam:q} \
            {output.tsv:q}

        test -s {output.tsv:q}
        """


####################################################
# SV-aware SNP + SV phasing with LongPhase         #
####################################################

rule longphase_phasing:
    input:
        vcf=rules.clair3_snp_calling.output.vcf,
        # Use the same-patient genotyped Sniffles VCF for phasing. Jasmine is
        # the annotation/master consensus, but its cross-caller merge is not a
        # genotype source for LongPhase.
        sv_vcf=rules.filter_sniffles_sv.output.vcf,
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        vcf=PATH + "{sample}/phasing_longphase/{sample}.longphase.vcf.gz",
        vcf_index=PATH + "{sample}/phasing_longphase/{sample}.longphase.vcf.gz.tbi",
        sv=PATH + "{sample}/phasing_longphase/{sample}.longphase_SV.vcf.gz",
        sv_index=PATH + "{sample}/phasing_longphase/{sample}.longphase_SV.vcf.gz.tbi"
    params:
        prefix=PATH + "{sample}/phasing_longphase/{sample}.longphase"
    threads: THREADS
    conda:
        CONDAENV + "longphase.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p "$(dirname {output.vcf:q})"

        longphase phase \
            -s {input.vcf:q} \
            --sv-file {input.sv_vcf:q} \
            -b {input.bam:q} \
            -r {input.ref:q} \
            -t {threads} \
            -o {params.prefix:q} \
            --ont

        test -s {params.prefix:q}.vcf
        bgzip -f {params.prefix:q}.vcf
        test -s {output.vcf:q}
        tabix -f -p vcf {output.vcf:q}
        test -s {params.prefix:q}_SV.vcf
        bgzip -@ {threads} -f {params.prefix:q}_SV.vcf
        tabix -f -p vcf {output.sv:q}
        """


############################
# Complementary MEI — TLDR  #
############################

rule tldr_mei_confirmation:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        table=PATH + "{sample}/mei/tldr/{sample}.tldr.table.txt"
    params:
        outbase=PATH + "{sample}/mei/tldr/{sample}"
    threads: THREADS
    conda:
        CONDAENV + "tldr.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p "$(dirname {output.table:q})"

        tldr \
            -b {input.bam:q} \
            -r {input.ref:q} \
            -e {TLDR_ELTS:q} \
            -p {threads} \
            --color_consensus \
            -o {params.outbase:q}

        test -s {output.table:q}
        """


