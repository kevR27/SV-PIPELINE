rule rank_sv_gene_events:
    input:
        integrated=PATH + "{sample}/gene_discovery/{sample}_allele_assessment.tsv",
        gnomad=PATH + "{sample}/gene_discovery/.postprocess_tmp/{sample}.gnomad.delta.tsv.gz",
        phenotypes=PATH + "{sample}/gene_discovery/{sample}_human_gene_phenotypes.tsv",
        hpo_seeds=HON_HPO_SEEDS,
        edges=MONARCH_EDGES,
        script=SCRIPTS + "/rank_sv_gene_events.py",
        ranking_common=SCRIPTS + "/ranking_common.py"
    output:
        tsv=temp(PATH + "{sample}/gene_discovery/.postprocess_tmp/{sample}.ranked.compact.tsv.gz")
    params:
        breakpoint_tolerance=SV_GENE_BREAKPOINT_TOLERANCE,
        rare_af=config.get("ranking_rare_af", 0.001),
        max_af=config.get("ranking_max_af", 0.01)
    conda:
        CONDAENV + "plots.yaml"
    shell:
        """
        set -euo pipefail

        python {input.script} \
            --input {input.integrated} \
            --gnomad-delta {input.gnomad} \
            --phenotypes {input.phenotypes} \
            --hpo-seeds {input.hpo_seeds} \
            --edges {input.edges} \
            --output {output.tsv} \
            --breakpoint-gene-tolerance {params.breakpoint_tolerance} \
            --rare-af {params.rare_af} \
            --max-af {params.max_af} \
            --compact-output

        test -s {output.tsv}
        """


rule integrate_complementary_sv_evidence:
    input:
        integrated=rules.rank_sv_gene_events.output.tsv,
        longphase=lambda wc: [longphase_path(wc.sample)] if longphase_path(wc.sample) else [],
        common=SCRIPTS + "/sv_evidence_common.py",
        straglr=PATH + "{sample}/sv/straglr/{sample}_straglr.annotated.tsv",
        tldr=PATH + "{sample}/mei/tldr/{sample}.tldr.table.txt",
        script=PLOTS + "/intersect_complementary_sv_evidence.py"
    output:
        delta=temp(PATH + "{sample}/gene_discovery/.postprocess_tmp/{sample}.complementary.delta.tsv.gz"),
        independent=PATH + "{sample}/gene_discovery/{sample}_independent_complementary_findings.tsv"
    params:
        straglr_tol=COMPLEMENTARY_STRAGLR_BP_TOL,
        tldr_tol=COMPLEMENTARY_TLDR_BP_TOL,
        longphase_tol=COMPLEMENTARY_LONGPHASE_BP_TOL,
        longphase_arg=lambda wc: longphase_arg(wc.sample)
    conda:
        CONDAENV + "plots.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.delta})

        python {input.script} \
            --integrated {input.integrated} \
            --straglr {input.straglr} \
            --tldr {input.tldr} \
            {params.longphase_arg} \
            --straglr-breakpoint-tol {params.straglr_tol} \
            --tldr-breakpoint-tol {params.tldr_tol} \
            --longphase-breakpoint-tol {params.longphase_tol} \
            --independent-output {output.independent} \
            --annotation-only \
            --output {output.delta}

        test -s {output.delta}
        test -e {output.independent}
        """


