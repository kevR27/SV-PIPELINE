import os

configfile: "config_lrs.yaml"

# ============================================================
# LRS DOWNSTREAM / THESIS POST-PROCESSING
# ============================================================
#
# This workflow intentionally does NOT perform variant calling.
# Run Snakefile_LRS_update first. This Snakefile only:
#   1. attaches orthogonal Straglr/TLDR evidence to the completed
#      integrated Jasmine SV-gene table; and
#   2. generates thesis plots on request.
#
# Plotting is intentionally excluded from this Snakefile's rule all.

SAMPLES = list(config["samples"].keys())
PATH = config["path"].rstrip("/") + "/"
CONDAENV = config["condaenv"]

PLOTS = os.path.abspath(os.path.join(workflow.basedir, "../../plots"))

ORTHOGONAL_STRAGLR_BP_TOL = config.get(
    "orthogonal_straglr_breakpoint_tolerance",
    500,
)
ORTHOGONAL_TLDR_BP_TOL = config.get(
    "orthogonal_tldr_breakpoint_tolerance",
    500,
)
ORTHOGONAL_LONGPHASE_BP_TOL = config.get(
    "orthogonal_longphase_breakpoint_tolerance",
    500,
)

THESIS_METHYLATION_REGION = config.get("thesis_methylation_region")


def integration_source_files(sample):
    """Files required to build the extended orthogonal-evidence table."""
    return [
        PATH + f"{sample}/gene_discovery/{sample}_integrated_SV_gene_analysis.tsv",
        PATH + f"{sample}/sv/straglr/{sample}_straglr.annotated.tsv",
        PATH + f"{sample}/mei/tldr/{sample}.tldr.table.txt",
    ]


def extended_table(sample):
    return (
        PATH
        + f"{sample}/gene_discovery/"
        + f"{sample}_integrated_SV_gene_with_orthogonal_evidence.tsv"
    )


def independent_findings_table(sample):
    return (
        PATH
        + f"{sample}/gene_discovery/"
        + f"{sample}_independent_orthogonal_findings.tsv"
    )


def gene_summary_table(sample):
    return (
        PATH
        + f"{sample}/gene_discovery/"
        + f"{sample}_gene_multimodal_evidence_summary.tsv"
    )


def first_existing_path(paths):
    for path in paths:
        if os.path.exists(path):
            return path
    return None


def longphase_path(sample):
    return first_existing_path([
        PATH + f"{sample}/phasing_longphase/{sample}.longphase.vcf.gz",
        PATH + f"{sample}/phasing_longphase/{sample}.longphase_SV.vcf",
        PATH + f"{sample}/phasing_longphase/{sample}.longphase.vcf",
    ])


def longphase_arg(sample):
    path = longphase_path(sample)
    return f"--longphase-vcf {path}" if path else ""


def whatshap_path(sample):
    return first_existing_path([
        PATH + f"{sample}/phasing/{sample}.phased.vcf.gz",
        PATH + f"{sample}/phasing/{sample}.phased.vcf",
    ])


def methylation_path(sample):
    return first_existing_path([
        PATH + f"{sample}/methylation/{sample}.cpg.bedmethyl.gz",
        PATH + f"{sample}/methylation/{sample}.bedmethyl.gz",
        PATH + f"{sample}/methylation/{sample}.bed.gz",
    ])


def multimodal_context_table(sample):
    return (
        PATH
        + f"{sample}/gene_discovery/"
        + f"{sample}_integrated_SV_gene_with_multimodal_context.tsv"
    )


def sample_ready_for_postprocess(sample):
    """A sample is ready if the extended table already exists or all source files exist."""
    if os.path.exists(extended_table(sample)):
        return True
    return all(os.path.exists(path) for path in integration_source_files(sample))


# Optional explicit subset in config_lrs.yaml:
#
# postprocess_samples:
#   - "21930"
#
# If omitted/null, automatically use only samples whose upstream LRS outputs
# required by this independent downstream workflow are already complete.
CONFIG_POSTPROCESS_SAMPLES = config.get("postprocess_samples")

if CONFIG_POSTPROCESS_SAMPLES:
    POSTPROCESS_SAMPLES = [str(sample) for sample in CONFIG_POSTPROCESS_SAMPLES]
else:
    POSTPROCESS_SAMPLES = [
        sample for sample in SAMPLES
        if sample_ready_for_postprocess(sample)
    ]

SKIPPED_POSTPROCESS_SAMPLES = [
    sample for sample in SAMPLES
    if sample not in POSTPROCESS_SAMPLES
]

print(
    "[LRS postprocess] ready samples: "
    + (", ".join(POSTPROCESS_SAMPLES) if POSTPROCESS_SAMPLES else "none")
)

if SKIPPED_POSTPROCESS_SAMPLES:
    print(
        "[LRS postprocess] skipped incomplete samples: "
        + ", ".join(SKIPPED_POSTPROCESS_SAMPLES)
    )


# Default post-processing target:
# build the extended interpretation table for every completed sample.
# Thesis plots remain a separate explicit target.
rule all:
    input:
        expand(
            PATH + "{sample}/gene_discovery/{sample}_integrated_SV_gene_with_orthogonal_evidence.tsv",
            sample=POSTPROCESS_SAMPLES,
        ),
        expand(
            PATH + "{sample}/gene_discovery/{sample}_independent_orthogonal_findings.tsv",
            sample=POSTPROCESS_SAMPLES,
        ),
        expand(
            PATH + "{sample}/gene_discovery/{sample}_gene_multimodal_evidence_summary.tsv",
            sample=POSTPROCESS_SAMPLES,
        ),
        expand(
            PATH + "{sample}/gene_discovery/{sample}_integrated_SV_gene_with_multimodal_context.tsv",
            sample=POSTPROCESS_SAMPLES,
        )


############################################################
# Orthogonal evidence integration                          #
############################################################

rule integrate_orthogonal_sv_evidence:
    input:
        integrated=PATH + "{sample}/gene_discovery/{sample}_integrated_SV_gene_analysis.tsv",
        straglr=PATH + "{sample}/sv/straglr/{sample}_straglr.annotated.tsv",
        tldr=PATH + "{sample}/mei/tldr/{sample}.tldr.table.txt",
        script=PLOTS + "/intersect_orthogonal_sv_evidence.py"
    output:
        tsv=PATH + "{sample}/gene_discovery/{sample}_integrated_SV_gene_with_orthogonal_evidence.tsv",
        independent=PATH + "{sample}/gene_discovery/{sample}_independent_orthogonal_findings.tsv"
    params:
        straglr_tol=ORTHOGONAL_STRAGLR_BP_TOL,
        tldr_tol=ORTHOGONAL_TLDR_BP_TOL,
        longphase_tol=ORTHOGONAL_LONGPHASE_BP_TOL,
        longphase_arg=lambda wc: longphase_arg(wc.sample)
    conda:
        CONDAENV + "plots.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.tsv})

        python {input.script} \
            --integrated {input.integrated} \
            --straglr {input.straglr} \
            --tldr {input.tldr} \
            {params.longphase_arg} \
            --straglr-breakpoint-tol {params.straglr_tol} \
            --tldr-breakpoint-tol {params.tldr_tol} \
            --longphase-breakpoint-tol {params.longphase_tol} \
            --independent-output {output.independent} \
            --output {output.tsv}

        test -s {output.tsv}
        test -e {output.independent}
        """


rule integrate_candidate_context:
    input:
        integrated=rules.integrate_candidate_context.output.tsv,
        script=PLOTS + "/integrate_candidate_context.py"
    output:
        tsv=PATH + "{sample}/gene_discovery/{sample}_integrated_SV_gene_with_multimodal_context.tsv"
    params:
        methylation_arg=lambda wc: (
            f"--methylation-bed {methylation_path(wc.sample)}"
            if methylation_path(wc.sample)
            else ""
        ),
        whatshap_arg=lambda wc: (
            f"--whatshap-vcf {whatshap_path(wc.sample)}"
            if whatshap_path(wc.sample)
            else ""
        )
    conda:
        CONDAENV + "plots.yaml"
    shell:
        """
        set -euo pipefail

        python {input.script} \
            --integrated {input.integrated} \
            {params.methylation_arg} \
            {params.whatshap_arg} \
            --output {output.tsv}

        test -s {output.tsv}
        """


rule build_gene_multimodal_summary:
    input:
        integrated=rules.integrate_orthogonal_sv_evidence.output.tsv,
        ranking=PATH + "{sample}/gene_discovery/{sample}_ranked_candidates.tsv",
        phenotypes=PATH + "{sample}/gene_discovery/{sample}_human_gene_phenotypes.tsv",
        script=PLOTS + "/build_gene_evidence_summary.py"
    output:
        tsv=PATH + "{sample}/gene_discovery/{sample}_gene_multimodal_evidence_summary.tsv"
    conda:
        CONDAENV + "plots.yaml"
    shell:
        """
        set -euo pipefail
        python {input.script} \
            --integrated {input.integrated} \
            --ranking {input.ranking} \
            --phenotypes {input.phenotypes} \
            --output {output.tsv}

        test -s {output.tsv}
        """


############################################################
# Plot dependency discovery                                #
############################################################

def existing_plot_inputs(wc):
    """Track completed plot inputs without making optional branches mandatory."""
    sample = wc.sample

    candidates = [
        PATH + f"{sample}/coverage/{sample}.mosdepth.global.dist.txt",
        PATH + f"{sample}/coverage/{sample}.mosdepth.summary.txt",
        PATH + f"{sample}/sv/merged/{sample}_caller_support_summary.tsv",
        PATH + f"{sample}/sv/needlr/{sample}_needLR_RESULTS.tsv",
        PATH + f"{sample}/gene_discovery/{sample}_ranked_candidates.tsv",
        PATH + f"{sample}/gene_discovery/{sample}_human_gene_phenotypes.tsv",
        PATH + f"{sample}/sv/straglr/{sample}_straglr.annotated.tsv",
        PATH + f"{sample}/mei/tldr/{sample}.tldr.table.txt",
        PATH + f"{sample}/phasing/{sample}.phased.vcf.gz",
        PATH + f"{sample}/phasing_longphase/{sample}.longphase.vcf.gz",
        PATH + f"{sample}/phasing_longphase/{sample}.longphase_SV.vcf",
        PATH + f"{sample}/methylation/{sample}.cpg.bedmethyl.gz",
        PATH + f"{sample}/methylation/{sample}.bedmethyl.gz",
        PATH + f"{sample}/methylation/{sample}.bed.gz",
    ]

    return [path for path in candidates if os.path.exists(path)]


############################################################
# Manual thesis plotting target                            #
############################################################

rule thesis_plots_sample:
    input:
        integrated=rules.integrate_orthogonal_sv_evidence.output.tsv,
        gene_summary=rules.build_gene_multimodal_summary.output.tsv,
        available=existing_plot_inputs,
        plot_scripts=[
            PLOTS + "/run_thesis_plots.py",
            PLOTS + "/plot_utils.py",
            PLOTS + "/plot_lrs_qc.py",
            PLOTS + "/plot_caller_concordance.py",
            PLOTS + "/plot_sv_landscape.py",
            PLOTS + "/plot_needlr_population.py",
            PLOTS + "/plot_candidate_evidence_matrix.py",
            PLOTS + "/plot_candidate_genes.py",
            PLOTS + "/plot_gene_hpo_heatmap.py",
            PLOTS + "/plot_straglr.py",
            PLOTS + "/plot_mei.py",
            PLOTS + "/plot_phasing_qc.py",
            PLOTS + "/plot_methylation.py",
            PLOTS + "/plot_gene_multimodal_summary.py",
            PLOTS + "/integrate_candidate_context.py",
        ]
    output:
        marker=touch(PATH + "{sample}/plots/.thesis_plots.done")
    params:
        methylation_arg=lambda wc: (
            f"--methylation-region {THESIS_METHYLATION_REGION}"
            if THESIS_METHYLATION_REGION
            else ""
        )
    conda:
        CONDAENV + "plots.yaml"
    shell:
        """
        set -euo pipefail

        python {PLOTS}/run_thesis_plots.py \
            --root {PATH} \
            --sample {wildcards.sample} \
            --platform lrs \
            {params.methylation_arg}

        touch {output.marker}
        """


# Explicit target only. It is NOT part of rule all.
rule all_thesis_plots:
    input:
        expand(
            PATH + "{sample}/plots/.thesis_plots.done",
            sample=POSTPROCESS_SAMPLES,
        )
