rule prepare_samplot_gene_annotation:
    input:
        bed=GENE_BED
    output:
        bed=PATH + "reference_checks/samplot_genes.bed.gz",
        index=PATH + "reference_checks/samplot_genes.bed.gz.tbi"
    conda:
        CONDAENV + "samplot.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.bed})
        awk 'BEGIN{{OFS="\t"}} NF >= 4 && $1 ~ /^chr([1-9]|1[0-9]|2[0-2]|X|Y|M)$/ {{print}}' {input.bed} \
            | sort -k1,1V -k2,2n \
            | bgzip -c > {output.bed}
        tabix -f -p bed {output.bed}
        test -s {output.bed}
        test -s {output.index}
        """


rule samplot_candidate_breakpoints:
    input:
        # Use the mechanism-aware event ranking so read-level review includes
        # small, large and breakpoint-defined candidates rather than only the
        # highest generic gene scores.
        integrated=PATH + "{sample}/gene_discovery/final/{sample}_sv_gene_candidates.ranked.tsv",
        bam=lambda wc: BAMS[wc.sample],
        genes=rules.prepare_samplot_gene_annotation.output.bed,
        gene_index=rules.prepare_samplot_gene_annotation.output.index,
        script=PLOTS + "/run_samplot_candidates.py"
    output:
        manifest=PATH + "{sample}/plots/13_breakpoint_evidence/" + SAMPLOT_RUN_NAME + "/samplot_manifest.tsv",
        marker=touch(PATH + "{sample}/plots/13_breakpoint_evidence/" + SAMPLOT_RUN_NAME + "/.samplot.done")
    params:
        outdir=PATH + "{sample}/plots/13_breakpoint_evidence/" + SAMPLOT_RUN_NAME,
        top_n=SAMPLOT_TOP_N,
        min_mapq=SAMPLOT_MIN_MAPQ,
        long_read_min=SAMPLOT_LONG_READ_MIN,
        zoom=SAMPLOT_ZOOM_BP,
        window=SAMPLOT_WINDOW_BP,
        large_threshold=SAMPLOT_LARGE_SV_THRESHOLD
    conda:
        CONDAENV + "samplot.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {params.outdir}

        python {input.script} \
            --input {input.integrated} \
            --bam {input.bam} \
            --reference {REF} \
            --sample {wildcards.sample} \
            --out-dir {params.outdir} \
            --top-n {params.top_n} \
            --min-mapq {params.min_mapq} \
            --long-read-min {params.long_read_min} \
            --zoom {params.zoom} \
            --window {params.window} \
            --large-sv-threshold {params.large_threshold} \
            --gene-annotation {input.genes}

        test -s {output.manifest}
        touch {output.marker}
        """


