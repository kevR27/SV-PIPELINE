        png=PATH + "cohort_plots/lrs_sample_comparison.png",
        summary=PATH + "cohort_plots/lrs_sample_comparison_summary.tsv",
        svtypes=PATH + "cohort_plots/lrs_sample_comparison_svtypes.tsv"
    params:
        sample_args=lambda wc: cohort_sample_args()
    conda:
        CONDAENV + "plots.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {PATH}cohort_plots

        python {input.script} \
            {params.sample_args} \
            --out-prefix {PATH}cohort_plots/lrs_sample_comparison

        test -s {output.pdf}
        test -s {output.svg}
        test -s {output.png}
        test -s {output.summary}
        test -s {output.svtypes}
        """


