import os
import shlex

configfile: "config_lrs.yaml"

# ============================================================
# LRS DOWNSTREAM / THESIS POST-PROCESSING
# ============================================================
#
# This workflow intentionally does NOT perform variant calling.
# Run Snakefile_LRS_update first. This Snakefile:
#   1. derives mechanism-aware SV-gene event ranking;
#   2. attaches complementary, multimodal, MitoCarta and optional exact
#      gnomAD-SV evidence; and
#   3. retains one compressed final integrated SV-gene table.
#
# Large intermediate annotation tables are temporary Snakemake outputs.
# Plotting is intentionally excluded from this Snakefile's rule all.

SAMPLES = list(config["samples"].keys())
BAMS = config["samples"]
PATH = config["path"].rstrip("/") + "/"
REF = config["ref"]

REPO_ROOT = os.path.abspath(os.path.join(workflow.basedir, "../.."))
CONDAENV = os.path.join(REPO_ROOT, "envs") + "/"
SCRIPTS = os.path.join(REPO_ROOT, "scripts")
PLOTS = os.path.join(REPO_ROOT, "plots")

COMPLEMENTARY_STRAGLR_BP_TOL = config.get(
    "complementary_straglr_breakpoint_tolerance",
    config.get("orthogonal_straglr_breakpoint_tolerance", 500),
)
COMPLEMENTARY_TLDR_BP_TOL = config.get(
    "complementary_tldr_breakpoint_tolerance",
    config.get("orthogonal_tldr_breakpoint_tolerance", 500),
)
COMPLEMENTARY_LONGPHASE_BP_TOL = config.get(
    "complementary_longphase_breakpoint_tolerance",
    config.get("orthogonal_longphase_breakpoint_tolerance", 500),
)

THESIS_METHYLATION_REGION = config.get("thesis_methylation_region")
GENE_BED = config.get("gene_bed")
GENEBED = GENE_BED
GENE_LIST = config["candidate_genes_list"]
MONARCH_NODES = config["monarch_nodes"]
MONARCH_EDGES = config["monarch_edges"]
HON_HPO_SEEDS = config.get(
    "discovery_hpo_file",
    os.path.join(REPO_ROOT, "reference", "hon_hpo_seed_terms.tsv"),
)
MITOCARTA_FILE = config.get("mitocarta_file")
MITOCARTA_PATHWAYS_FILE = config.get("mitocarta_pathways_file")
GNOMAD_SV_VCF = config.get("gnomad_sv_vcf")


def gnomad_sv_inputs(wc):
    if not GNOMAD_SV_VCF:
        return []
    return [GNOMAD_SV_VCF, GNOMAD_SV_VCF + ".tbi"]


def gnomad_sv_arg(wc):
    return (
        f"--gnomad-vcf {shlex.quote(GNOMAD_SV_VCF)}"
        if GNOMAD_SV_VCF
        else ""
    )

SAMPLOT_TOP_N = config.get("samplot_top_n", 20)
SAMPLOT_RUN_NAME = f"top_{SAMPLOT_TOP_N}"
SAMPLOT_MIN_MAPQ = config.get("samplot_min_mapq", 20)
SAMPLOT_LONG_READ_MIN = config.get("samplot_long_read_min_length", 1000)
SAMPLOT_ZOOM_BP = config.get("samplot_zoom_bp", 20000)
SAMPLOT_WINDOW_BP = config.get("samplot_window_bp", 5000)
SAMPLOT_LARGE_SV_THRESHOLD = config.get("samplot_large_sv_threshold", 1000000)
SV_GENE_BREAKPOINT_TOLERANCE = config.get("sv_gene_breakpoint_tolerance", 10000)
THESIS_TOP_GENES = config.get("thesis_top_genes", 25)


def postprocess_required_files(sample):
    """Upstream files required by the active downstream interpretation DAG."""
    return [
        PATH + f"{sample}/gene_discovery/{sample}_allele_assessment.tsv",
        PATH + f"{sample}/gene_discovery/{sample}_ranked_candidates.tsv",
        PATH + f"{sample}/gene_discovery/{sample}_human_gene_phenotypes.tsv",
        PATH + f"{sample}/sv/straglr/{sample}_straglr.annotated.tsv",
        PATH + f"{sample}/mei/tldr/{sample}.tldr.table.txt",
        PATH + f"{sample}/phasing_longphase/{sample}.longphase.vcf.gz",
        PATH + f"{sample}/phasing_longphase/{sample}.longphase_SV.vcf.gz",
    ]


def independent_findings_table(sample):
    return (
        PATH
        + f"{sample}/gene_discovery/"
        + f"{sample}_independent_complementary_findings.tsv"
    )


def gene_summary_table(sample):
    return (
        PATH
        + f"{sample}/gene_discovery/"
        + f"{sample}_gene_multimodal_evidence_summary.tsv"
    )


def first_existing_path(paths):
    for path in paths:
        if os.path.exists(path):
            return path
    return None


def longphase_path(sample):
    return first_existing_path([
        PATH + f"{sample}/phasing_longphase/{sample}.longphase_SV.vcf.gz",
        PATH + f"{sample}/phasing_longphase/{sample}.longphase_SV.vcf",
    ])


def longphase_arg(sample):
    path = longphase_path(sample)
    return f"--longphase-vcf {shlex.quote(path)}" if path else ""


def whatshap_path(sample):
    return first_existing_path([
        PATH + f"{sample}/phasing/{sample}.phased.vcf.gz",
        PATH + f"{sample}/phasing/{sample}.phased.vcf",
    ])


def methylation_path(sample):
    return first_existing_path([
        PATH + f"{sample}/methylation/{sample}.cpg.bedmethyl.gz",
        PATH + f"{sample}/methylation/{sample}.bedmethyl.gz",
        PATH + f"{sample}/methylation/{sample}.bed.gz",
    ])


def final_integrated_table(sample):
    """Single persistent post-processing SV-gene table."""
    return (
        PATH
        + f"{sample}/gene_discovery/"
        + f"{sample}_integrated_SV_gene_analysis.final.tsv.gz"
    )


def sample_ready_for_postprocess(sample):
    """A sample is ready only when the current downstream prerequisites exist."""
    return all(
        os.path.exists(path)
        for path in postprocess_required_files(sample)
    )


# Optional explicit subset in config_lrs.yaml:
#
# postprocess_samples:
#   - "21930"
#
# If omitted/null, automatically use only samples whose upstream LRS outputs
# required by this independent downstream workflow are already complete.
CONFIG_POSTPROCESS_SAMPLES = config.get("postprocess_samples")

if CONFIG_POSTPROCESS_SAMPLES:
    POSTPROCESS_SAMPLES = [str(sample) for sample in CONFIG_POSTPROCESS_SAMPLES]
else:
    POSTPROCESS_SAMPLES = [
        sample for sample in SAMPLES
        if sample_ready_for_postprocess(sample)
    ]

SKIPPED_POSTPROCESS_SAMPLES = [
    sample for sample in SAMPLES
    if sample not in POSTPROCESS_SAMPLES
]

print(
    "[LRS postprocess] ready samples: "
    + (", ".join(POSTPROCESS_SAMPLES) if POSTPROCESS_SAMPLES else "none")
)

if SKIPPED_POSTPROCESS_SAMPLES:
    print(
        "[LRS postprocess] skipped incomplete samples: "
        + ", ".join(SKIPPED_POSTPROCESS_SAMPLES)
    )


# Default post-processing target:
# retain one compressed, authoritative SV-gene table per completed sample.
# Large intermediate annotation copies are temporary and removed by Snakemake.
# Thesis plots remain a separate explicit target.
rule all:
    input:
        expand(
            PATH + "{sample}/gene_discovery/{sample}_integrated_SV_gene_analysis.final.tsv.gz",
            sample=POSTPROCESS_SAMPLES,
        ),
        expand(
            PATH + "{sample}/gene_discovery/{sample}_independent_complementary_findings.tsv",
            sample=POSTPROCESS_SAMPLES,
        ),
        expand(
            PATH + "{sample}/gene_discovery/{sample}_mitocarta_annotation_summary.tsv",
            sample=POSTPROCESS_SAMPLES,
        ),
        expand(
            PATH + "{sample}/gene_discovery/{sample}_gene_multimodal_evidence_summary.tsv",
            sample=POSTPROCESS_SAMPLES,
        ),
        expand(
            PATH + "{sample}/gene_discovery/{sample}_mitochondrial_gene_ranking.tsv",
            sample=POSTPROCESS_SAMPLES,
        )


