# Jasmine per-patient caller merge     #
########################################

rule jasmine_merge:
    input:
        manta=rules.filter_manta_sv.output.vcf,
        delly=rules.filter_delly_sv.output.vcf,
        fai=REF + ".fai"
    output:
        list_file=PATH + "{sample}/sv/merged/{sample}_vcf_list.txt",
        raw_vcf=temp(PATH + "{sample}/sv/merged/{sample}_merged_SV.raw.vcf"),
        vcf=PATH + "{sample}/sv/merged/{sample}_merged_SV.vcf.gz",
        tbi=PATH + "{sample}/sv/merged/{sample}_merged_SV.vcf.gz.tbi"
    params:
        outdir=PATH + "{sample}/sv/merged",
        sanitized_vcf=PATH + "{sample}/sv/merged/{sample}_merged_SV.sanitized.vcf",
        sort_tmpdir=PATH + "{sample}/sv/merged/.bcftools_sort_tmp"
    threads: THREADS
    conda:
        CONDAENV + "jasmine.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {params.outdir}
        rm -rf {params.sort_tmpdir}
        mkdir -p {params.sort_tmpdir}

        # Input order defines Jasmine IDLIST/SUPP_VEC provenance.
        printf "%s\n%s\n" {input.manta} {input.delly} > {output.list_file}

        jasmine \
            file_list={output.list_file} \
            out_file={output.raw_vcf} \
            threads={threads} \
            max_dist={JASMINE_MAX_DIST} \
            max_dist_linear={JASMINE_MAX_DIST_LINEAR} \
            min_dist={JASMINE_MIN_DIST} \
            --mutual_distance \
            --normalize_type \
            --allow_intrasample

        python {SCRIPTS}/sanitize_jasmine_vcf.py \
            --input {output.raw_vcf} \
            --output {params.sanitized_vcf} \
            --reference-fai {input.fai}

        bcftools sort \
            -T {params.sort_tmpdir} \
            -Oz \
            -o {output.vcf} \
            {params.sanitized_vcf}
        tabix -f -p vcf {output.vcf}
        test -s {output.vcf}
        test -s {output.tbi}

        rm -rf {params.sort_tmpdir}
        rm -f {params.sanitized_vcf}
        """


rule summarize_caller_support:
