    params:
        raw_vcf=PATH + "{sample}/sv/merged/{sample}_merged_SV.caller_concordant.vcf"
    conda:
        CONDAENV + "annotsv.yaml"
    shell:
        """
        set -euo pipefail
        python {SCRIPTS}/summarize_sv_caller_support.py \
            --vcf {input.vcf} \
            --output {output.summary} \
