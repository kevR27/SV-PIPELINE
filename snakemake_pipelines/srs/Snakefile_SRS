configfile: "config_srs.yaml"

SAMPLES    = list(config["samples"].keys())
BAMS       = config["samples"]
PATH       = config["path"]
REF        = config["ref"]
THREADS    = config["threads"]
BED        = config["bed"]                     # panel/target regions (DeepVariant only)
GENE_LIST  = config["candidate_genes_list"]    # optic-neuropathy panel, one symbol per line
EXCLUDE    = config["exclude_bed"]
EH_CATALOG = config["expansionhunter_catalog"]

# --- MELT: Mobile Element Insertions ---
melt_dir = config["melt_dir"]
MELT_DIR = melt_dir
MELT_TRANSPOSONS = config["melt_transposons"]
MELT_GENES_BED = config["melt_genes_bed"]

# --- VEP ---
VEP_CACHE_DIR = config["vep_cache_dir"]
VEP_ASSEMBLY = config.get("vep_assembly", "GRCh38")

# --- AnnotSV ---
ANNOTSV_ANNOTATIONS_DIR = config.get(
    "annotsv_annotations_dir",
    PATH + "reference/AnnotSV_annotations"
)

# Optional: only used if you intentionally provide patient HPO terms.
# This is NOT required for genome-wide discovery.
HPO_TERMS = config.get("hpo_terms", None)
ANNOTSV_BENIGN_AF = config.get("annotsv_benign_af", 0.01)

# --- Genome-wide human phenotype discovery ---
MONARCH_BASE_URL = config.get(
    "monarch_base_url",
    "https://api-v3.monarchinitiative.org/v3/api"
)
DISCOVERY_HPO_TERMS = config.get(
    "discovery_hpo_terms",
    [
        "HP:0000648",  # Optic atrophy
        "HP:0007663",  # Reduced visual acuity
        "HP:0000543",  # Optic disc pallor
        "HP:0000649",  # Abnormality of visual evoked potentials
    ]
)
DISCOVERY_HPO_FILE = config.get(
    "discovery_hpo_file",
    "reference/optic_neuropathy_hpo_terms.tsv"
)

# --- DeepVariant ---
DEEPVARIANT_VERSION = config.get("deepvariant_version", "1.6.1")
DEEPVARIANT_USE_CONDA = config.get("deepvariant_use_conda", False)

CONDAENV = config["condaenv"]


rule all:
    input:
        expand(PATH + "{sample}/coverage/{sample}.mosdepth.global.dist.txt", sample=SAMPLES),

        # Genome-wide SV discovery
        expand(PATH + "{sample}/sv/manta/{sample}_manta.vcf.gz", sample=SAMPLES),
        expand(PATH + "{sample}/sv/delly/{sample}_delly.vcf.gz", sample=SAMPLES),
        expand(PATH + "{sample}/sv/merged/{sample}_merged_SV.vcf", sample=SAMPLES),

        # Genome-wide AnnotSV
        expand(PATH + "{sample}/sv/merged/{sample}_merged_SV.annotsv.tsv", sample=SAMPLES),

        # Panel-focused AnnotSV
        expand(PATH + "{sample}/sv/merged/{sample}_merged_SV.annotsv.panel_only.tsv", sample=SAMPLES),

        # Genome-wide VEP + panel view
        expand(PATH + "{sample}/sv/vep/{sample}_SV_VEP.txt", sample=SAMPLES),
        expand(PATH + "{sample}/sv/vep/{sample}_SV_VEP.panel_only.txt", sample=SAMPLES),

        # Genome-wide non-panel gene discovery
        expand(PATH + "{sample}/gene_discovery/{sample}_SV_genes.txt", sample=SAMPLES),
        expand(PATH + "{sample}/gene_discovery/{sample}_nonpanel_genes.txt", sample=SAMPLES),
        expand(PATH + "{sample}/gene_discovery/{sample}_human_gene_phenotypes.tsv", sample=SAMPLES),
        expand(PATH + "{sample}/gene_discovery/{sample}_ranked_candidates.tsv", sample=SAMPLES),

        # Other existing analyses
        expand(PATH + "{sample}/mei/melt/{sample}.MEI.merged.vcf", sample=SAMPLES),
        expand(PATH + "{sample}/str/expansionhunter/{sample}_EH.vcf", sample=SAMPLES),
        expand(PATH + "{sample}/snp_deepvariant/{sample}.vcf.gz", sample=SAMPLES),
        expand(PATH + "{sample}/phasing/{sample}.phased.vcf.gz", sample=SAMPLES),
        expand(PATH + "{sample}/phasing/{sample}.phased.bam", sample=SAMPLES)


#####################################
# QC
#####################################

rule mosdepth_coverage:
    input:
        bam=lambda wc: BAMS[wc.sample]
    output:
        PATH + "{sample}/coverage/{sample}.mosdepth.global.dist.txt"
    conda:
        CONDAENV + "mosdepth.yaml"
    shell:
        """
        mkdir -p {PATH}/{wildcards.sample}/coverage
        mosdepth -t {THREADS} {PATH}/{wildcards.sample}/coverage/{wildcards.sample} {input.bam}
        """


#####################################
# SV CALLING - Manta + Delly
#####################################

rule manta_sv:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        vcf=PATH + "{sample}/sv/manta/{sample}_manta.vcf.gz"
    params:
        rundir=PATH + "{sample}/sv/manta/rundir"
    conda:
        CONDAENV + "manta.yaml"
    shell:
        """
        mkdir -p {PATH}/{wildcards.sample}/sv/manta
        configManta.py --bam {input.bam} --referenceFasta {input.ref} --runDir {params.rundir}
        {params.rundir}/runWorkflow.py -m local -j {THREADS}
        cp {params.rundir}/results/variants/diploidSV.vcf.gz {output.vcf}
        tabix -p vcf {output.vcf}
        """


rule delly_sv:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF,
        excl=EXCLUDE
    output:
        vcf=PATH + "{sample}/sv/delly/{sample}_delly.vcf.gz"
    params:
        bcf=PATH + "{sample}/sv/delly/{sample}_delly.bcf"
    conda:
        CONDAENV + "delly.yaml"
    shell:
        """
        mkdir -p {PATH}/{wildcards.sample}/sv/delly
        delly call -x {input.excl} -g {input.ref} -o {params.bcf} {input.bam}
        bcftools view {params.bcf} -O z -o {output.vcf}
        tabix -p vcf {output.vcf}
        """


#####################################
# WITHIN SV MERGE
#####################################

rule survivor_merge:
    input:
        manta=rules.manta_sv.output.vcf,
        delly=rules.delly_sv.output.vcf
    output:
        list_file=PATH + "{sample}/sv/merged/{sample}_vcf_list.txt",
        vcf=PATH + "{sample}/sv/merged/{sample}_merged_SV.vcf"
    conda:
        CONDAENV + "survivor.yaml"
    shell:
        """
        mkdir -p {PATH}/{wildcards.sample}/sv/merged

        zcat {input.manta} > {PATH}/{wildcards.sample}/sv/merged/manta.vcf
        zcat {input.delly} > {PATH}/{wildcards.sample}/sv/merged/delly.vcf

        printf "%s\\n" \
            {PATH}/{wildcards.sample}/sv/merged/manta.vcf \
            {PATH}/{wildcards.sample}/sv/merged/delly.vcf \
            > {output.list_file}

        SURVIVOR merge {output.list_file} 1000 1 1 1 0 50 {output.vcf}
        """


#####################################
# High-confidence SV companion set
#####################################
rule survivor_high_confidence:
    input:
        vcf=rules.survivor_merge.output.vcf
    output:
        vcf=PATH + "{sample}/sv/merged/{sample}_merged_SV.SUPP2.vcf"
    conda:
        CONDAENV + "annotsv.yaml"
    shell:
        """
        bcftools view -i 'INFO/SUPP>=2' -Ov {input.vcf} -o {output.vcf}
        """
#####################################
# AnnotSV
#####################################

rule annotsv_install_annotations:
    output:
        marker=ANNOTSV_ANNOTATIONS_DIR + "/.installed"
    conda:
        CONDAENV + "annotsv.yaml"
    shell:
        """
        mkdir -p {ANNOTSV_ANNOTATIONS_DIR}
        cd {ANNOTSV_ANNOTATIONS_DIR}
        INSTALL_annotations.sh
        touch {output.marker}
        """


# Full genome-wide annotation.
# candidateGenesFiltering 0 means candidate genes do not restrict annotation.
rule annotsv_annotation:
    input:
        vcf=rules.survivor_merge.output.vcf,
        annotations=rules.annotsv_install_annotations.output.marker
    output:
        tsv=PATH + "{sample}/sv/merged/{sample}_merged_SV.annotsv.tsv"
    params:
        outdir=PATH + "{sample}/sv/merged",
        hpo_flag=lambda wc: f"-hpo {HPO_TERMS}" if HPO_TERMS else ""
    conda:
        CONDAENV + "annotsv.yaml"
    shell:
        """
        mkdir -p {params.outdir}

        AnnotSV -SVinputFile {input.vcf} \
            -annotationsDir {ANNOTSV_ANNOTATIONS_DIR} \
            -outputDir {params.outdir} \
            -outputFile {wildcards.sample}_merged_SV.annotsv.tsv \
            -genomeBuild GRCh38 \
            -candidateGenesFile {GENE_LIST} \
            -candidateGenesFiltering 0 \
            -benignAF {ANNOTSV_BENIGN_AF} \
            {params.hpo_flag}
        """


# Explicit panel-focused AnnotSV run.
# This uses the same genome-wide SV VCF but filters annotation to the panel
rule annotsv_annotation_panel_only:
    input:
        vcf=rules.survivor_merge.output.vcf,
        annotations=rules.annotsv_install_annotations.output.marker,
        genes=GENE_LIST
    output:
        tsv=PATH + "{sample}/sv/merged/{sample}_merged_SV.annotsv.panel_only.tsv"
    params:
        outdir=PATH + "{sample}/sv/merged"
    conda:
        CONDAENV + "annotsv.yaml"
    shell:
        """
        mkdir -p {params.outdir}

        AnnotSV -SVinputFile {input.vcf} \
            -annotationsDir {ANNOTSV_ANNOTATIONS_DIR} \
            -outputDir {params.outdir} \
            -outputFile {wildcards.sample}_merged_SV.annotsv.panel_only.tsv \
            -genomeBuild GRCh38 \
            -candidateGenesFile {input.genes} \
            -candidateGenesFiltering 1 \
            -benignAF {ANNOTSV_BENIGN_AF}
        """


#####################################
# Extract genes from genome-wide AnnotSV
#####################################

rule extract_sv_genes:
    input:
        annotsv=rules.annotsv_annotation.output.tsv
    output:
        genes=PATH + "{sample}/gene_discovery/{sample}_SV_genes.txt"
    conda:
        CONDAENV + "monarch.yaml"
    shell:
        """
        mkdir -p {PATH}/{wildcards.sample}/gene_discovery

        python scripts/extract_annotsv_genes.py \
            --annotsv {input.annotsv} \
            --output {output.genes}
        """


rule extract_nonpanel_genes:
    input:
        genes=rules.extract_sv_genes.output.genes,
        panel=GENE_LIST
    output:
        genes=PATH + "{sample}/gene_discovery/{sample}_nonpanel_genes.txt"
    conda:
        CONDAENV + "monarch.yaml"
    shell:
        """
        python scripts/extract_nonpanel_genes.py \
            --genes {input.genes} \
            --panel {input.panel} \
            --output {output.genes}
        """


#####################################
# Human gene -> HPO phenotype layer
#
# Uses Monarch KG human gene/phenotype associations.
# No patient HPO list is required.
#
# The script deliberately queries human HGNC gene entities and does
# not traverse ortholog/model-organism associations.
#####################################

rule human_gene_phenotypes:
    input:
        genes=rules.extract_nonpanel_genes.output.genes,
        hpo=DISCOVERY_HPO_FILE
    output:
        tsv=PATH + "{sample}/gene_discovery/{sample}_human_gene_phenotypes.tsv"
    params:
        api=MONARCH_BASE_URL
    conda:
        CONDAENV + "monarch.yaml"
    shell:
        """
        python scripts/monarch_human_gene_phenotypes.py \
            --genes {input.genes} \
            --hpo-anchors {input.hpo} \
            --output {output.tsv} \
            --api-base {params.api}
        """


#####################################
# Integrated genome-wide candidate ranking
#####################################

rule rank_genomewide_candidates:
    input:
        annotsv=rules.annotsv_annotation.output.tsv,
        genes=rules.extract_nonpanel_genes.output.genes,
        phenotypes=rules.human_gene_phenotypes.output.tsv,
        panel=GENE_LIST
    output:
        tsv=PATH + "{sample}/gene_discovery/{sample}_ranked_candidates.tsv"
    conda:
        CONDAENV + "monarch.yaml"
    shell:
        """
        python scripts/rank_sv_gene_candidates.py \
            --annotsv {input.annotsv} \
            --genes {input.genes} \
            --phenotypes {input.phenotypes} \
            --panel {input.panel} \
            --output {output.tsv}
        """


#####################################
# VEP
#####################################

rule vep_sv_annotation:
    input:
        vcf=rules.survivor_merge.output.vcf
    output:
        txt=PATH + "{sample}/sv/vep/{sample}_SV_VEP.txt"
    conda:
        CONDAENV + "vep.yaml"
    shell:
        """
        mkdir -p {PATH}/{wildcards.sample}/sv/vep

        vep --input_file {input.vcf} --format vcf \
            --output_file {output.txt} \
            --cache --offline --dir_cache {VEP_CACHE_DIR} --assembly {VEP_ASSEMBLY} \
            --canonical --overlaps --pick --symbol --biotype \
            --max_sv_size 250000000 --batch_size 100 --fork {THREADS}
        """


rule vep_sv_annotation_panel_only:
    input:
        txt=rules.vep_sv_annotation.output.txt,
        genes=GENE_LIST
    output:
        txt=PATH + "{sample}/sv/vep/{sample}_SV_VEP.panel_only.txt"
    conda:
        CONDAENV + "vep.yaml"
    shell:
        """
        grep '^#' {input.txt} > {output.txt} || true
        grep -Fwf {input.genes} {input.txt} >> {output.txt} || true
        """


#####################################
# MEI (MELT)
#####################################

rule melt_mei:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF,
        transposons=MELT_TRANSPOSONS,
        genes=MELT_GENES_BED
    output:
        vcf=PATH + "{sample}/mei/melt/{sample}.MEI.merged.vcf"
    params:
        outdir=PATH + "{sample}/mei/melt"
    conda:
        CONDAENV + "melt.yaml"
    shell:
        """
        mkdir -p {params.outdir}

        java -Xmx8G -jar {MELT_DIR}/MELT.jar Single \
            -bamfile {input.bam} \
            -h {input.ref} \
            -n {input.genes} \
            -t {input.transposons} \
            -w {params.outdir}

        bcftools concat -a \
            {params.outdir}/*.final_comp.vcf \
            -O v \
            -o {output.vcf}
        """


#####################################
# REPEAT EXPANSION (EH)
#####################################

rule expansionhunter_str:
    input:
        bam=lambda wc: BAMS[wc.sample],
        ref=REF,
        catalog=EH_CATALOG
    output:
        vcf=PATH + "{sample}/str/expansionhunter/{sample}_EH.vcf"
    params:
        prefix=PATH + "{sample}/str/expansionhunter/{sample}_EH"
    conda:
        CONDAENV + "expansionhunter.yaml"
    shell:
        """
        mkdir -p {PATH}/{wildcards.sample}/str/expansionhunter

        ExpansionHunter --reads {input.bam} --reference {input.ref} \
            --variant-catalog {input.catalog} --output-prefix {params.prefix} \
            --threads {THREADS}
        """


#####################################
# SMALL VARIANTS (DeepVariant)
#####################################

if DEEPVARIANT_USE_CONDA:

    rule deepvariant_snp:
        input:
            bam=lambda wc: BAMS[wc.sample],
            ref=REF
        output:
            vcf=PATH + "{sample}/snp_deepvariant/{sample}.vcf.gz"
        params:
            outdir=PATH + "{sample}/snp_deepvariant"
        conda:
            CONDAENV + "deepvariant.yaml"
        shell:
            """
            mkdir -p {params.outdir}

            run_deepvariant --model_type=WGS \
                --ref={input.ref} --reads={input.bam} \
                --output_vcf={output.vcf} \
                --num_shards={THREADS} \
                --intermediate_results_dir={params.outdir}/intermediate \
                --regions={BED}
            """

else:

    rule deepvariant_snp:
        input:
            bam=lambda wc: BAMS[wc.sample],
            ref=REF
        output:
            vcf=PATH + "{sample}/snp_deepvariant/{sample}.vcf.gz"
        params:
            outdir=PATH + "{sample}/snp_deepvariant"
        container:
            f"docker://google/deepvariant:{DEEPVARIANT_VERSION}"
        shell:
            """
            mkdir -p {params.outdir}

            /opt/deepvariant/bin/run_deepvariant --model_type=WGS \
                --ref={input.ref} --reads={input.bam} \
                --output_vcf={output.vcf} \
                --num_shards={THREADS} \
                --intermediate_results_dir={params.outdir}/intermediate \
                --regions={BED}
            """


#####################################
# PHASING (WhatsHap)
#####################################

rule whatshap_phasing:
    input:
        vcf=rules.deepvariant_snp.output.vcf,
        bam=lambda wc: BAMS[wc.sample],
        ref=REF
    output:
        phased=PATH + "{sample}/phasing/{sample}.phased.vcf.gz",
        haplotag=PATH + "{sample}/phasing/{sample}.phased.bam"
    conda:
        CONDAENV + "whatshap.yaml"
    shell:
        """
        mkdir -p {PATH}/{wildcards.sample}/phasing

        whatshap phase --reference {input.ref} -o {output.phased} \
            {input.vcf} {input.bam} --ignore-read-groups

        tabix -p vcf {output.phased}

        whatshap haplotag -o {output.haplotag} --reference {input.ref} \
            {output.phased} {input.bam} --ignore-read-groups

        samtools index {output.haplotag}
        """
