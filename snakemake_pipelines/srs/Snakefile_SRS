rule mosdepth_coverage:
    input:
        bam=lambda wc: BAMS[wc.sample],
        bai=lambda wc: bam_index_for(wc.sample)
    output:
        global_dist=PATH + "{sample}/coverage/{sample}.mosdepth.global.dist.txt",
        summary=PATH + "{sample}/coverage/{sample}.mosdepth.summary.txt"
    params:
        prefix=PATH + "{sample}/coverage/{sample}"
    threads: THREADS
    conda:
        CONDAENV + "mosdepth.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.global_dist})
        mosdepth -t {threads} {params.prefix} {input.bam}
        test -s {output.global_dist}
        test -s {output.summary}
        """


#################################
# Genome-wide SV calling        #
#################################

rule manta_sv:
    input:
        bam=lambda wc: BAMS[wc.sample],
        bai=lambda wc: bam_index_for(wc.sample),
        ref=REF,
        fai=REF + ".fai"
    output:
        vcf=PATH + "{sample}/sv/manta/{sample}_manta.vcf.gz",
        tbi=PATH + "{sample}/sv/manta/{sample}_manta.vcf.gz.tbi"
    params:
        rundir=PATH + "{sample}/sv/manta/rundir"
    threads: THREADS
    conda:
        CONDAENV + "manta.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.vcf})
        rm -rf {params.rundir}
        configManta.py \
            --bam {input.bam} \
            --referenceFasta {input.ref} \
            --runDir {params.rundir}
        {params.rundir}/runWorkflow.py -m local -j {threads}
        cp {params.rundir}/results/variants/diploidSV.vcf.gz {output.vcf}
        tabix -f -p vcf {output.vcf}
        test -s {output.vcf}
        test -s {output.tbi}
        """


rule delly_sv:
    input:
        bam=lambda wc: BAMS[wc.sample],
        bai=lambda wc: bam_index_for(wc.sample),
        ref=REF,
        fai=REF + ".fai",
        exclude=EXCLUDE_BED
    output:
        bcf=temp(PATH + "{sample}/sv/delly/{sample}_delly.bcf"),
        vcf=PATH + "{sample}/sv/delly/{sample}_delly.vcf.gz",
        tbi=PATH + "{sample}/sv/delly/{sample}_delly.vcf.gz.tbi"
    threads: THREADS
    conda:
        CONDAENV + "delly.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.vcf})
        delly call \
            -x {input.exclude} \
            -g {input.ref} \
            -o {output.bcf} \
            {input.bam}
        bcftools view {output.bcf} -Oz -o {output.vcf}
        tabix -f -p vcf {output.vcf}
        test -s {output.vcf}
        test -s {output.tbi}
        """


