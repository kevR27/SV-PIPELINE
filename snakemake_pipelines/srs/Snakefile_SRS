############################################################
# Independent Illumina mobile-element insertion branch      #
############################################################

rule melt_mei_family:
    input:
        bam=lambda wc: BAMS[wc.sample],
        bai=lambda wc: bam_index_for(wc.sample),
        ref=REF,
        fai=REF + ".fai",
        transposon=lambda wc: MELT_TRANSPOSONS[wc.family],
        genes=lambda wc: MELT_GENES_BED,
        jar=lambda wc: MELT_JAR
    output:
        vcf=PATH + "{sample}/mei/melt/families/{sample}.{family}.final_comp.vcf"
    params:
        workdir=PATH + "{sample}/mei/melt/work/{family}",
        memory=MELT_JAVA_MEMORY_GB
    conda:
        CONDAENV + "melt.yaml"
    shell:
        """
        set -euo pipefail
        python {SCRIPTS}/run_melt_single.py \
            --jar {input.jar} \
            --bam {input.bam} \
            --reference {input.ref} \
            --genes-bed {input.genes} \
            --transposon {input.transposon} \
            --workdir {params.workdir} \
            --memory-gb {params.memory} \
            --output {output.vcf}
        """


rule melt_merge_families:
    input:
        vcfs=lambda wc: [
            PATH
            + f"{wc.sample}/mei/melt/families/{wc.sample}.{family}.final_comp.vcf"
            for family in MELT_FAMILIES
        ]
    output:
        vcf=PATH + "{sample}/mei/melt/{sample}.MEI.merged.vcf.gz",
        tbi=PATH + "{sample}/mei/melt/{sample}.MEI.merged.vcf.gz.tbi"
    params:
        tmpdir=PATH + "{sample}/mei/melt/.bcftools_sort_tmp"
    conda:
        CONDAENV + "melt.yaml"
    shell:
        """
        set -euo pipefail
        rm -rf {params.tmpdir}
        mkdir -p {params.tmpdir}
        bcftools concat -a -Ov {input.vcfs} \
            | bcftools sort -T {params.tmpdir} -Oz -o {output.vcf}
        tabix -f -p vcf {output.vcf}
        rm -rf {params.tmpdir}
        test -s {output.vcf}
        test -s {output.tbi}
        """


