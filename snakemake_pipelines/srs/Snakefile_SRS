            --reads={input.bam} \
            --output_vcf={output.vcf} \
            --num_shards={threads} \
            --intermediate_results_dir={params.outdir}/intermediate \
            {params.regions}
        test -s {output.vcf}
        test -s {output.tbi}
        """


rule whatshap_phasing:
    input:
        vcf=rules.deepvariant_snp.output.vcf,
        tbi=rules.deepvariant_snp.output.tbi,
        bam=lambda wc: BAMS[wc.sample],
        bai=lambda wc: bam_index_for(wc.sample),
        ref=REF,
        fai=REF + ".fai"
    output:
        phased=PATH + "{sample}/phasing/{sample}.phased.vcf.gz",
        phased_tbi=PATH + "{sample}/phasing/{sample}.phased.vcf.gz.tbi",
        haplotag=PATH + "{sample}/phasing/{sample}.phased.bam",
        haplotag_bai=PATH + "{sample}/phasing/{sample}.phased.bam.bai"
    conda:
        CONDAENV + "whatshap.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.phased})
        whatshap phase \
            --reference {input.ref} \
            -o {output.phased} \
            {input.vcf} \
            {input.bam} \
            --ignore-read-groups
        tabix -f -p vcf {output.phased}
        whatshap haplotag \
            -o {output.haplotag} \
            --reference {input.ref} \
            {output.phased} \
            {input.bam} \
            --ignore-read-groups
        samtools index {output.haplotag}
        test -s {output.phased}
        test -s {output.phased_tbi}
        test -s {output.haplotag}
        test -s {output.haplotag_bai}
        """


