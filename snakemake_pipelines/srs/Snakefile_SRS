rule filter_manta_sv:
    input:
        caller_vcf=rules.manta_sv.output.vcf,
        caller_tsv=rules.manta_caller_parse.output.tsv
    output:
        tsv=PATH + "{sample}/parsed/{sample}.manta.evidence.filtered.tsv",
        ids=PATH + "{sample}/parsed/{sample}.manta.pass.ids.txt",
        vcf=PATH + "{sample}/sv/manta/{sample}_manta.filtered.vcf"
    params:
        min_gq=lambda wc: f"--min-gq {EVIDENCE_MIN_GQ}" if EVIDENCE_MIN_GQ is not None else "",
        blacklist=lambda wc: f"--blacklist-bed {EVIDENCE_BLACKLIST_BED}" if EVIDENCE_BLACKLIST_BED else ""
    conda:
        CONDAENV + "annotsv.yaml"
    shell:
        """
        set -euo pipefail
        python {FILTER_SV_EVIDENCE_SCRIPT} \
            --caller-tsv {input.caller_tsv} \
            --caller Manta \
            --min-support {EVIDENCE_MIN_SUPPORT} \
            --min-svlen {EVIDENCE_MIN_SVLEN} \
            --max-svlen {EVIDENCE_MAX_SVLEN} \
            {params.min_gq} \
            {params.blacklist} \
            --output-tsv {output.tsv} \
            --output-ids {output.ids}
        bcftools view -i "ID=@{output.ids}" -Ov -o {output.vcf} {input.caller_vcf}
        test -s {output.vcf}
        """


