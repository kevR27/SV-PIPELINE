rule vep_sv_annotation:
    input:
        vcf=rules.survivor_merge.output.vcf
    output:
        txt=PATH + "{sample}/sv/vep/{sample}_SV_VEP.txt"
    threads: THREADS
    conda:
        CONDAENV + "vep.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.txt})
        vep \
            --input_file {input.vcf} \
            --format vcf \
            --output_file {output.txt} \
            --cache \
