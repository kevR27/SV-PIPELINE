rule annotsv_annotations_check:
    input:
        script=SCRIPTS + "/check_annotsv_gene_resource.py",
        common=SCRIPTS + "/sv_evidence_common.py",
        genes=lambda wc: [str(p) for p in (Path(ANNOTSV_ANNOTATIONS_DIR) / "Annotations_Human" / "Genes" / "GRCh38").glob("genes.ENSEMBL.sorted*.bed")]
    output:
        marker=PATH + "reference_checks/annotsv_annotations.ok"
    params:
        annotations=ANNOTSV_ANNOTATIONS_DIR
    shell:
        """
        set -euo pipefail
        test -d {params.annotations}/Annotations_Human
        test -d {params.annotations}/Annotations_Exomiser
        python {input.script:q} --annotations-dir {params.annotations:q}
        mkdir -p $(dirname {output.marker})
        touch {output.marker}
        """


rule annotsv_annotation:
    input:
        vcf=rules.jasmine_merge.output.vcf,
        annotations=rules.annotsv_annotations_check.output.marker
    output:
        tsv=PATH + "{sample}/sv/annotsv/{sample}_merged_SV.annotsv.tsv",
        unannotated=PATH + "{sample}/sv/annotsv/{sample}_merged_SV.annotsv.unannotated.tsv"
    params:
        outdir=PATH + "{sample}/sv/annotsv",
        hpo_flag=lambda wc: f"-hpo {HPO_TERMS}" if HPO_TERMS else ""
    conda:
        CONDAENV + "annotsv.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {params.outdir}
        : > {output.unannotated:q}
        AnnotSV \
            -SVinputFile {input.vcf} \
            -annotationsDir {ANNOTSV_ANNOTATIONS_DIR} \
            -outputDir {params.outdir} \
            -outputFile {wildcards.sample}_merged_SV.annotsv.tsv \
            -genomeBuild GRCh38 \
            -candidateGenesFile {GENE_LIST} \
            -candidateGenesFiltering 0 \
            -tx ENSEMBL \
            -REreport 1 \
            -benignAF {ANNOTSV_BENIGN_AF} \
            {params.hpo_flag}
        test -s {output.tsv}
        """


