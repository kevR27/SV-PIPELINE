########################################
# SURVIVOR per-patient caller merge    #
########################################

rule survivor_merge:
    input:
        manta=rules.filter_manta_sv.output.vcf,
        delly=rules.filter_delly_sv.output.vcf,
        fai=REF + ".fai"
    output:
        list_file=PATH + "{sample}/sv/merged/{sample}_vcf_list.txt",
        raw_vcf=temp(PATH + "{sample}/sv/merged/{sample}_merged_SV.raw.vcf"),
        vcf=PATH + "{sample}/sv/merged/{sample}_merged_SV.vcf.gz",
        tbi=PATH + "{sample}/sv/merged/{sample}_merged_SV.vcf.gz.tbi"
    params:
        outdir=PATH + "{sample}/sv/merged",
        sanitized_vcf=PATH + "{sample}/sv/merged/{sample}_merged_SV.sanitized.vcf",
        sort_tmpdir=PATH + "{sample}/sv/merged/.bcftools_sort_tmp"
    conda:
        CONDAENV + "survivor.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {params.outdir}
        rm -rf {params.sort_tmpdir}
        mkdir -p {params.sort_tmpdir}

        # This order defines the meaning of SURVIVOR SUPP_VEC.
        printf "%s\n%s\n" {input.manta} {input.delly} > {output.list_file}

        SURVIVOR merge \
            {output.list_file} \
            {SURVIVOR_MAX_DISTANCE} \
            {SURVIVOR_MIN_SUPPORT} \
            {SURVIVOR_REQUIRE_SAME_TYPE} \
            {SURVIVOR_REQUIRE_SAME_STRAND} \
            {SURVIVOR_USE_SIZE_RATIO} \
            {SURVIVOR_MIN_SIZE} \
            {output.raw_vcf}

        python {SCRIPTS}/sanitize_jasmine_vcf.py \
            --input {output.raw_vcf} \
            --output {params.sanitized_vcf} \
            --reference-fai {input.fai}

        bcftools sort \
            -T {params.sort_tmpdir} \
            -Oz \
            -o {output.vcf} \
            {params.sanitized_vcf}
        tabix -f -p vcf {output.vcf}
        test -s {output.vcf}
        test -s {output.tbi}

        rm -rf {params.sort_tmpdir}
        rm -f {params.sanitized_vcf}
        """


rule summarize_caller_support:
    input:
        vcf=rules.survivor_merge.output.vcf
    output:
        summary=PATH + "{sample}/sv/merged/{sample}_caller_support_summary.tsv",
        high_conf_vcf=PATH + "{sample}/sv/merged/{sample}_merged_SV.high_confidence.vcf.gz",
        tbi=PATH + "{sample}/sv/merged/{sample}_merged_SV.high_confidence.vcf.gz.tbi"
    params:
        raw_vcf=PATH + "{sample}/sv/merged/{sample}_merged_SV.high_confidence.vcf"
    conda:
        CONDAENV + "annotsv.yaml"
    shell:
        """
        set -euo pipefail
        python {SCRIPTS}/summarize_sv_caller_support.py \
            --vcf {input.vcf} \
            --output {output.summary} \
            --caller-order "{SURVIVOR_CALLER_ORDER}" \
            --min-callers {HIGH_CONFIDENCE_MIN_SUPP} \
            --high-confidence-vcf {params.raw_vcf}
        bgzip -f {params.raw_vcf}
        tabix -f -p vcf {output.high_conf_vcf}
        """


