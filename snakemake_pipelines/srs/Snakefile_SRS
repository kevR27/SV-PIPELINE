import os
from pathlib import Path


configfile: "config_srs.yaml"

SAMPLES = list(config["samples"].keys())
BAMS = config["samples"]
BAM_INDEXES = config.get("bam_indexes", {})
PATH = config["path"].rstrip("/") + "/"
REF = config["ref"]
THREADS = config["threads"]

PANEL_BED = config.get("bed")
GENE_LIST = config["candidate_genes_list"]
EXCLUDE_BED = config["exclude_bed"]
EH_CATALOG = config["expansionhunter_catalog"]

CONDAENV = config["condaenv"]
SCRIPTS = os.path.abspath(os.path.join(workflow.basedir, "../../scripts"))
SRS_SCRIPTS = os.path.join(SCRIPTS, "srs")

# DeepVariant is genome-wide for WGS. Panel views are derived downstream so
# known-gene review and genome-wide discovery start from the same callset.

# AnnotSV.
ANNOTSV_BENIGN_AF = config.get("annotsv_benign_af", 0.01)
HPO_TERMS = config.get("hpo_terms")
ANNOTSV_ANNOTATIONS_DIR = config.get(
    "annotsv_annotations_dir",
    PATH + "reference/AnnotSV_annotations",
)

# Offline Monarch Knowledge Graph / phenotype discovery.
MONARCH_NODES = config["monarch_nodes"]
MONARCH_EDGES = config["monarch_edges"]
DISCOVERY_HPO_FILE = config.get(
    "discovery_hpo_file",
    "reference/optic_neuropathy_hpo_terms.tsv",
)

# VEP.
VEP_CACHE_DIR = config["vep_cache_dir"]
VEP_ASSEMBLY = config.get("vep_assembly", "GRCh38")

# Pre-Jasmine caller evidence filtering. Hard filters are deliberately
# conservative; GQ and blacklist overlap remain soft evidence flags.
FILTER_SV_EVIDENCE_SCRIPT = config.get(
    "filter_sv_evidence_script",
    os.path.join(SCRIPTS, "filter_sv_evidence.py"),
)
EVIDENCE_MIN_SUPPORT = config.get("evidence_min_support", 2)
EVIDENCE_MIN_SVLEN = config.get("evidence_min_svlen", 50)
EVIDENCE_MAX_SVLEN = config.get("evidence_max_svlen", 250_000_000)
EVIDENCE_MIN_GQ = config.get("evidence_min_gq")
EVIDENCE_BLACKLIST_BED = config.get("evidence_blacklist_bed")

# Jasmine defines the complete Manta/DELLY breakpoint-discovery universe.
# Distance scales with SV length and is capped. The complete union remains the
# master callset; caller concordance is only a companion evidence view.
JASMINE_MAX_DIST = config.get("jasmine_max_dist", 5000)
JASMINE_MAX_DIST_LINEAR = config.get("jasmine_max_dist_linear", 0.5)
JASMINE_MIN_DIST = config.get("jasmine_min_dist", 50)
JASMINE_CALLER_ORDER = config.get("jasmine_caller_order", "Manta,Delly")
CALLER_CONCORDANT_MIN_SUPP = config.get("caller_concordant_min_supp", 2)

# MELT is an independent Illumina MEI branch. Each transposon ZIP is run in an
# isolated directory, then the family VCFs are concatenated and sorted.
MELT_ENABLED = config.get("melt_enabled", False)
MELT_JAR = config.get("melt_jar")
MELT_TRANSPOSONS = config.get("melt_transposons", {})
MELT_GENES_BED = config.get("melt_genes_bed")
MELT_JAVA_MEMORY_GB = config.get("melt_java_memory_gb", 8)
MELT_FAMILIES = list(MELT_TRANSPOSONS.keys())
ORTHOGONAL_BP_TOLERANCE = config.get("orthogonal_breakpoint_tolerance", 500)

MITOCARTA_ENABLED = bool(config.get("mitocarta_enabled", False))
MITOCARTA_FILE = config.get("mitocarta_file")
MITOCARTA_PATHWAYS_FILE = config.get("mitocarta_pathways_file")
if MITOCARTA_ENABLED and not MITOCARTA_FILE:
    raise ValueError("mitocarta_enabled is true but mitocarta_file is not configured")

MITOCARTA_TARGETS = (
    expand(
        PATH + "{sample}/gene_discovery/{sample}_integrated_SRS_evidence.mitocarta.tsv",
        sample=SAMPLES,
    )
    if MITOCARTA_ENABLED
    else []
)

if MELT_ENABLED and not MELT_FAMILIES:
    raise ValueError("melt_enabled is true but melt_transposons is empty")


def bam_index_for(sample):
    """Use an explicit BAM index mapping or the conventional BAM.bai path."""
    return BAM_INDEXES.get(sample, BAMS[sample] + ".bai")


def melt_orthogonal_input(wildcards):
    if not MELT_ENABLED:
        return []
    return PATH + f"{wildcards.sample}/mei/melt/{wildcards.sample}.MEI.merged.vcf.gz"


MELT_TARGETS = []
if MELT_ENABLED:
    MELT_TARGETS = (
        expand(
            PATH + "{sample}/mei/melt/families/{sample}.{family}.final_comp.vcf",
            sample=SAMPLES,
            family=MELT_FAMILIES,
        )
        + expand(
            PATH + "{sample}/mei/melt/{sample}.MEI.merged.vcf.gz",
            sample=SAMPLES,
        )
        + expand(
            PATH + "{sample}/mei/melt/{sample}.MEI.merged.vcf.gz.tbi",
            sample=SAMPLES,
        )
    )


