rule mosdepth_coverage:
    input:
        preflight=rules.srs_preflight.output.tsv,
        bam=lambda wc: BAMS[wc.sample],
        bai=lambda wc: bam_index_for(wc.sample)
    output:
        global_dist=PATH + "{sample}/coverage/{sample}.mosdepth.global.dist.txt",
        summary=PATH + "{sample}/coverage/{sample}.mosdepth.summary.txt"
    params:
        prefix=PATH + "{sample}/coverage/{sample}"
    threads: THREADS
    conda:
        ENV_DIR + "/qc.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.global_dist})
        mosdepth -t {threads} {params.prefix} {input.bam}
        test -s {output.global_dist}
        test -s {output.summary}
        """


rule alignment_qc:
    input:
        preflight=rules.srs_preflight.output.tsv,
        bam=lambda wc: BAMS[wc.sample],
        bai=lambda wc: bam_index_for(wc.sample)
    output:
        flagstat=PATH + "{sample}/qc/{sample}.flagstat.txt",
        stats=PATH + "{sample}/qc/{sample}.samtools.stats.txt"
    threads: THREADS
    conda:
        ENV_DIR + "/qc.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.flagstat})
        samtools flagstat -@ {threads} {input.bam} > {output.flagstat}
        samtools stats -@ {threads} {input.bam} > {output.stats}
        test -s {output.flagstat}
        test -s {output.stats}
        """


rule summarize_wgs_qc:
    input:
        flagstat=rules.alignment_qc.output.flagstat,
        summary=rules.mosdepth_coverage.output.summary,
        script=SCRIPTS + "/build_qc_summary.py"
    output:
        tsv=PATH + "{sample}/qc/{sample}.wgs_qc_summary.tsv"
    conda:
        ENV_DIR + "/qc.yaml"
    shell:
        """
        python {input.script:q} --sample {wildcards.sample:q} --flagstat {input.flagstat:q} \
          --mosdepth-summary {input.summary:q} --min-mean-coverage {QC_MIN_MEAN_COVERAGE} \
          --min-mapped-percent {QC_MIN_MAPPED_PERCENT} --output {output.tsv:q}
        """


