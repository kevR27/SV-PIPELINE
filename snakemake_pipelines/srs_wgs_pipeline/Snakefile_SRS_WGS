    if not GRIDSS_ENABLED:
        return []
    return PATH + f"{wc.sample}/sv/gridss/{wc.sample}.gridss.vcf.gz"


def melt_optional_input(wc):
    if not MELT_ENABLED:
        return []
    return PATH + f"{wc.sample}/mei/melt/{wc.sample}.MEI.merged.vcf.gz"


def diagnostic_source(wc):
    suffix = "_integrated_SV_gene_with_mitocarta.tsv" if MITOCARTA_ENABLED else "_integrated_SV_gene_with_supporting_evidence.tsv"
    return PATH + f"{wc.sample}/gene_discovery/{wc.sample}{suffix}"


