ANNOTSV_ANNOTATIONS_DIR = config["annotsv_annotations_dir"]
MONARCH_NODES = config["monarch_nodes"]
MONARCH_EDGES = config["monarch_edges"]
DISCOVERY_HPO_FILE = config["discovery_hpo_file"]
VEP_CACHE_DIR = config["vep_cache_dir"]
