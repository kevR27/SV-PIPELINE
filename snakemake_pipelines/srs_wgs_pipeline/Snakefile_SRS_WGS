rule srs_preflight:
    input:
        script=SCRIPTS + "/preflight_srs_wgs.py",
        bams=list(BAMS.values()),
        bais=[bam_index_for(sample) for sample in SAMPLES]
    output:
        tsv=PATH + "reference_checks/srs_preflight.tsv",
        json=PATH + "reference_checks/srs_preflight.json"
    params:
        gridss=str(GRIDSS_ENABLED).lower(), mt=str(MTDNA_ENABLED).lower(), mito=str(MITOCARTA_ENABLED).lower(),
        mito_file=(f"--mitocarta {MITOCARTA_FILE}" if MITOCARTA_FILE else ""),
        pathways=(f"--pathways-gmx {MITOCARTA_PATHWAYS}" if MITOCARTA_PATHWAYS else "")
    conda:
        ENV_DIR + "/qc.yaml"
    shell:
        """
        python {input.script:q} --reference {REF:q} --panel-bed {PANEL_BED:q} --gene-list {GENE_LIST:q} \
          --nuclear-mito-bed {NUCLEAR_MITO_BED:q} --gene-bed {GENE_BED:q} \
          --exclude-bed {EXCLUDE_BED:q} --repeat-catalog {EH_CATALOG:q} --hpo-seeds {DISCOVERY_HPO_FILE:q} \
