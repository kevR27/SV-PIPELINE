rule filter_manta_sv:
    input:
        vcf=rules.manta_sv_calling.output.vcf,
        tsv=rules.manta_caller_parse.output.tsv
    output:
        tsv=PATH + "{sample}/parsed/{sample}.manta.evidence.filtered.tsv",
        ids=PATH + "{sample}/parsed/{sample}.manta.pass.ids.txt",
        vcf=PATH + "{sample}/sv/manta/{sample}_manta.filtered.vcf"
    params:
        gq=lambda wc: f"--min-gq {EVIDENCE_MIN_GQ}" if EVIDENCE_MIN_GQ is not None else "",
        blacklist=lambda wc: f"--blacklist-bed {EVIDENCE_BLACKLIST_BED}" if EVIDENCE_BLACKLIST_BED else ""
    conda:
        CONDAENV + "annotsv.yaml"
    shell:
        """
        set -euo pipefail
