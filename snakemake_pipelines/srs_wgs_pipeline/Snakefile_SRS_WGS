        ENV_DIR + "/qc.yaml"
    shell:
        """
        mkdir -p $(dirname {output.fasta})
        samtools faidx {input.ref} {wildcards.contig} > {output.fasta}
        samtools faidx {output.fasta}
        """


rule mutserve_mtdna_calling:
    input:
        preflight=rules.srs_preflight.output.tsv,
        bam=lambda wc: BAMS[wc.sample],
        bai=lambda wc: bam_index_for(wc.sample),
        mtref=lambda wc: PATH + f"reference/mt/{MT_CONTIG}.fa",
        mtfai=lambda wc: PATH + f"reference/mt/{MT_CONTIG}.fa.fai"
    output:
        mtbam=PATH + "{sample}/mtDNA/{sample}.chrM.primary.bam",
        mtbai=PATH + "{sample}/mtDNA/{sample}.chrM.primary.bam.bai",
        vcf=PATH + "{sample}/mtDNA/{sample}.mutserve.vcf.gz",
        tsv=PATH + "{sample}/mtDNA/{sample}.mutserve.tsv"
    threads: min(THREADS, 8)
    conda:
        ENV_DIR + "/mutserve.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.vcf})
        samtools view -@ {threads} -bh -F 3852 {input.bam} {MT_CONTIG} > {output.mtbam}
        samtools index -@ {threads} {output.mtbam}
        mutserve call --reference {input.mtref} --output {output.vcf} --threads {threads} \
            --level {MUTSERVE_LEVEL} {output.mtbam}
        python {SCRIPTS}/summarize_mtdna_variants.py --vcf {output.vcf} --output {output.tsv}
        """


##############################################
# Add independent supporting evidence to the final table
##############################################

##########################################################################
# ADD SUPPORTING EVIDENCE
#
# This step does not create new pathogenicity classifications.
# It only records whether the same candidate has support from:
#   - CNVpytor read depth
#   - GRIDSS breakpoint/assembly evidence
#   - MELT mobile-element calls
#   - ExpansionHunter repeat loci
##########################################################################

rule add_supporting_evidence:
    input:
        integrated=PATH + "{sample}/gene_discovery/{sample}_allele_assessment.tsv",
        integrated_vcf=rules.combine_sv_and_cnv_calls.output.vcf,
        expansionhunter=rules.expansionhunter_str.output.vcf,
        gridss=gridss_optional_input,
        melt=melt_optional_input
    output:
        tsv=PATH + "{sample}/gene_discovery/{sample}_integrated_SV_gene_with_supporting_evidence.tsv"
    params:
        gridss=lambda wc: (
            f"--gridss {PATH}{wc.sample}/sv/gridss/{wc.sample}.gridss.vcf.gz"
            if GRIDSS_ENABLED else ""
        ),
        melt=lambda wc: (
            f"--melt {PATH}{wc.sample}/mei/melt/{wc.sample}.MEI.merged.vcf.gz"
            if MELT_ENABLED else ""
        ),
        gridss_qual=lambda wc: f"--gridss-min-qual {GRIDSS_MIN_QUAL}" if GRIDSS_MIN_QUAL is not None else ""
    conda:
        CONDAENV + "monarch.yaml"
    shell:
        """
        python {SCRIPTS}/add_supporting_evidence.py --integrated {input.integrated:q} \
            --integrated-vcf {input.integrated_vcf:q} --expansionhunter {input.expansionhunter:q} \
            {params.gridss} {params.gridss_qual} {params.melt} --breakpoint-tolerance {SUPPORTING_BP_TOLERANCE} \
            --output {output.tsv:q}
        """


##############################################
# Primary MitoCarta nuclear-mitochondrial context
##############################################

rule mitocarta_context_srs:
    input:
        integrated=rules.add_supporting_evidence.output.tsv,
        ranking=rules.rank_genomewide_candidates.output.tsv,
        mitocarta=lambda wc: MITOCARTA_FILE,
        pathways=lambda wc: [MITOCARTA_PATHWAYS] if MITOCARTA_PATHWAYS else []
    output:
        tsv=PATH + "{sample}/gene_discovery/{sample}_integrated_SV_gene_with_mitocarta.tsv",
        summary=PATH + "{sample}/gene_discovery/{sample}_mitocarta_summary.tsv"
    params:
        pathways=lambda wc: f"--pathways-gmx {MITOCARTA_PATHWAYS}" if MITOCARTA_PATHWAYS else ""
    conda:
        CONDAENV + "plots.yaml"
    shell:
        """
        python {SCRIPTS}/annotate_mitocarta_context.py --integrated {input.integrated:q} \
            --mitocarta {input.mitocarta:q} {params.pathways} --ranking {input.ranking:q} \
            --output {output.tsv:q} --summary-output {output.summary:q}
        """


##############################################
# Diagnostic-support review and benchmarking
##############################################

rule build_diagnostic_candidates:
    input:
        table=diagnostic_source,
        script=SCRIPTS + "/build_diagnostic_candidates.py"
    output:
        tsv=PATH + "{sample}/diagnostic_review/{sample}.diagnostic_candidates.tsv"
    conda:
        CONDAENV + "plots.yaml"
    shell:
        """
        python {input.script:q} --input {input.table:q} --top-n {DIAGNOSTIC_TOP_N} --output {output.tsv:q}
        """


rule rank_mitochondrial_genes_srs:
    input:
        integrated=diagnostic_source,
        gene_bed=GENE_BED,
        panel=GENE_LIST,
        script=SCRIPTS + "/rank_mitochondrial_genes.py",
        ranking_common=SCRIPTS + "/ranking_common.py"
    output:
        tsv=PATH + "{sample}/diagnostic_review/{sample}.mitochondrial_gene_ranking.tsv"
    conda:
        CONDAENV + "plots.yaml"
    shell:
        """
        python {input.script:q} \
            --input {input.integrated:q} \
            --gene-bed {input.gene_bed:q} \
            --panel {input.panel:q} \
            --output {output.tsv:q}
        """


rule samplot_diagnostic_candidates:
    input:
        candidates=rules.build_diagnostic_candidates.output.tsv,
        bam=lambda wc: BAMS[wc.sample],
        bai=lambda wc: bam_index_for(wc.sample),
        ref=REF,
        script=SCRIPTS + "/run_samplot_candidates.py"
    output:
        manifest=PATH + "{sample}/diagnostic_review/{sample}.samplot_manifest.tsv"
    params:
        outdir=PATH + "{sample}/diagnostic_review/samplot"
    conda:
        ENV_DIR + "/srs_samplot.yaml"
    shell:
        """
        python {input.script:q} --input {input.candidates:q} --bam {input.bam:q} --reference {input.ref:q} \
          --sample {wildcards.sample:q} --out-dir {params.outdir:q} --top-n {SAMPLOT_TOP_N} \
          --min-mapq {SAMPLOT_MIN_MAPQ} --manifest {output.manifest:q}
        """


rule benchmark_diagnostic_candidates:
    input:
        candidates=rules.build_diagnostic_candidates.output.tsv,
        truth=lambda wc: CANDIDATE_TRUTH,
        script=SCRIPTS + "/benchmark_candidates.py"
    output:
        tsv=PATH + "{sample}/benchmark/{sample}.candidate_benchmark.tsv",
        json=PATH + "{sample}/benchmark/{sample}.candidate_benchmark.json"
    conda:
        ENV_DIR + "/benchmark.yaml"
    shell:
        """
        python {input.script:q} --candidates {input.candidates:q} --truth {input.truth:q} \
          --output-tsv {output.tsv:q} --output-json {output.json:q}
        """


rule benchmark_sv_callset:
    input:
        calls=rules.combine_sv_and_cnv_calls.output.vcf,
        truth=lambda wc: SV_TRUTH_VCFS[wc.sample],
        bed=lambda wc: SV_TRUTH_BEDS[wc.sample],
        ref=REF
    output:
        directory(PATH + "{sample}/benchmark/truari")
    conda:
        ENV_DIR + "/benchmark.yaml"
    shell:
        """
        mkdir -p $(dirname {output:q})
        truvari bench -b {input.truth:q} -c {input.calls:q} -f {input.ref:q} -o {output:q} \
          --includebed {input.bed:q} --passonly --sizemin 50 --sizemax 250000000 \
          --pctseq 0 --pctsize 0.7
        test -s {output:q}/summary.json
        """


