        tbi=PATH + "{sample}/snp_deepvariant/{sample}.nuclear_mito_candidates.vcf.gz.tbi",
        bed=temp(PATH + "{sample}/snp_deepvariant/{sample}.nuclear_mito_targets.bed")
    conda:
        CONDAENV + "annotsv.yaml"
    shell:
        """
        # bcftools interprets .bed as 0-based but .tsv as 1-based. The curated
        # gene intervals are BED coordinates, even when named .tsv.
        awk 'BEGIN {{OFS="\\t"}} !/^#/ && NF>=3 {{print $1,$2,$3}}' {input.bed:q} > {output.bed:q}
        bcftools view -f 'PASS,.' -R {output.bed:q} -Oz -o {output.vcf:q} {input.vcf:q}
        tabix -f -p vcf {output.vcf:q}
        """


