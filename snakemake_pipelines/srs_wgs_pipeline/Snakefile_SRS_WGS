          --annotsv-dir {ANNOTSV_ANNOTATIONS_DIR:q} --vep-cache-dir {VEP_CACHE_DIR:q} \
          --vep-cache-version {VEP_CACHE_VERSION} \
          --gridss-enabled {params.gridss} --mt-enabled {params.mt} --mt-contig {MT_CONTIG:q} \
          --mitocarta-enabled {params.mito} {params.mito_file} {params.pathways} \
          --bam {input.bams:q} --bai {input.bais:q} \
          --output-tsv {output.tsv:q} --output-json {output.json:q}
        """


