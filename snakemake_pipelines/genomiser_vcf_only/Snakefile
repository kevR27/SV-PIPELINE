"""Run Genomiser and shared custom SV ranking from existing VCFs.

This is a separate, BAM-free entry point. It intentionally does not include
the LRS or SRS variant-calling, depth, methylation, phasing or plot rules.
Patient profiles and Genomiser analysis remain mandatory.
"""

import os
import shlex
import sys

configfile: "config.yaml"

REPO_ROOT = os.path.abspath(os.path.join(workflow.basedir, "../.."))
SCRIPTS = os.path.join(REPO_ROOT, "scripts")
CONDAENV = os.path.join(REPO_ROOT, "envs") + "/"
sys.path.insert(0, SCRIPTS)

from sv_evidence_common import hon_hpo_seed_path
from genomiser_requirements import require_genomiser
from benchmark_sample_selection import confirmed_benchmark_samples

PATH = os.path.abspath(os.path.expanduser(config["path"])).rstrip("/") + "/"
VCF_INPUTS = {
    str(sample): entry
    for sample, entry in config.get("vcf_samples", {}).items()
}
SAMPLES = list(VCF_INPUTS)
if not SAMPLES:
    raise ValueError("Add at least one sample to vcf_samples in the VCF-only config.")

for sample, entry in VCF_INPUTS.items():
    if not isinstance(entry, dict):
        raise ValueError(f"{sample}: provide small_vcf and sv_vcf paths.")
    for key in ("small_vcf", "sv_vcf"):
        value = entry.get(key)
        if not isinstance(value, str) or not value.strip():
            raise ValueError(f"{sample}: missing {key} path.")
        if not value.endswith(".vcf.gz"):
            raise ValueError(f"{sample}: {key} must be a .vcf.gz file.")
    if entry["small_vcf"] == entry["sv_vcf"]:
        raise ValueError(f"{sample}: small_vcf and sv_vcf must be different files.")

# Snakemake treats these paths as existing external inputs: no BAM or upstream
# caller is defined here, so a missing VCF causes an input error, not re-calling.
GENOMISER_SMALL_VCF = lambda wc: VCF_INPUTS[wc.sample]["small_vcf"]
GENOMISER_SV_VCF = lambda wc: VCF_INPUTS[wc.sample]["sv_vcf"]

GENOMISER_ENABLED = require_genomiser(config, SAMPLES)
GENOMISER_TARGETS = expand(
    PATH + "{sample}/genomiser/{sample}.genomiser.manifest.json",
    sample=SAMPLES
)

GENOMISER_CUSTOM_GENE = PATH + "{sample}/gene_discovery/final/{sample}_gene_candidates.ranked.tsv"
GENOMISER_CUSTOM_SV = PATH + "{sample}/gene_discovery/final/{sample}_sv_gene_candidates.ranked.tsv"
GENOMISER_BENCHMARK_SAMPLES = confirmed_benchmark_samples(config.get("genomiser_benchmark_truth_tsv"), SAMPLES)
GENOMISER_BENCHMARK_TARGETS = expand(PATH + "{sample}/benchmark/{sample}.genomiser_vs_custom.json", sample=GENOMISER_BENCHMARK_SAMPLES)
GENOMISER_COMPARISON_TARGETS = expand(PATH + "{sample}/benchmark/{sample}.ranking_comparison.json", sample=SAMPLES)
STABILITY_TARGETS = (
    expand(PATH + "{sample}/ranking_stability/stability_manifest.json", sample=SAMPLES)
    if config.get("ranking_stability_enabled", True) else []
)
BENCHMARK_REVIEW_TARGETS = expand(
    PATH + "{sample}/benchmark/{sample}.benchmark_review.tsv", sample=SAMPLES
)

rule all:
    input:
        GENOMISER_TARGETS,
        GENOMISER_BENCHMARK_TARGETS,
        GENOMISER_COMPARISON_TARGETS,
        STABILITY_TARGETS,
        BENCHMARK_REVIEW_TARGETS,
        expand(GENOMISER_CUSTOM_GENE, sample=SAMPLES),
        expand(GENOMISER_CUSTOM_SV, sample=SAMPLES),
        expand(PATH + "{sample}/gene_discovery/final/{sample}_clinical_candidates.ranked.tsv", sample=SAMPLES)

include: "../common/patient_profiles.smk"
include: "../common/genomiser.smk"

include: "custom_ranking.smk"
include: "../common/benchmark_genomiser.smk"
include: "../common/compare_genomiser_rankings.smk"
RANKING_STABILITY_SV = GENOMISER_CUSTOM_SV
include: "../common/ranking_stability.smk"
BENCHMARK_REVIEW_SAMPLES = SAMPLES
include: "../common/benchmark_review.smk"
