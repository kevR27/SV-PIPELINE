"""Rebuild LRS downstream interpretation from archived BAM-derived outputs.

Sample IDs are discovered from the directories below input_root, or selected
by their folder names. The original LRS downstream rules are reused, without
defining any BAM-based coverage/caller/Samplot rule.
"""

import os
from pathlib import Path
import yaml

configfile: "config.yaml"

WORKFLOW_DIR = Path(workflow.basedir).resolve()
ROOT = WORKFLOW_DIR.parents[1]
SETTINGS_PATH = (WORKFLOW_DIR / config.get("original_lrs_config", "../lrs/config_lrs.yaml")).resolve()
if not SETTINGS_PATH.is_file():
    raise ValueError(f"Original LRS configuration not found: {SETTINGS_PATH}")

with SETTINGS_PATH.open(encoding="utf-8") as handle:
    settings = yaml.safe_load(handle) or {}
if not isinstance(settings, dict):
    raise ValueError("Original LRS settings must be a YAML mapping.")
user_settings = dict(config)
result_root = Path(
    user_settings.get("input_root") or settings["path"]
).expanduser().resolve()
requested = user_settings.get("sample_ids", "auto")

if requested in ("auto", None):
    if not result_root.is_dir():
        raise ValueError(f"input_root directory does not exist: {result_root}")
    selected = sorted(
        (entry.name for entry in result_root.iterdir()
         if entry.is_dir() and entry.name.isdecimal()),
        key=lambda name: (int(name), name)
    )
elif isinstance(requested, list):
    selected = [str(sample) for sample in requested]
elif isinstance(requested, (str, int)):
    selected = [str(requested)]
else:
    raise ValueError("sample_ids must be auto, a sample ID, or a list of sample IDs.")

if not selected:
    raise ValueError(
        f"No numeric patient directories found in {result_root}; "
        "set sample_ids: [\"11446\"] in config.yaml for explicit selection."
    )
if len(set(selected)) != len(selected):
    raise ValueError("sample_ids includes duplicate patient IDs.")
if any(not sample or "/" in sample or sample in {".", ".."}
       for sample in selected):
    raise ValueError("Sample IDs must be folder names without path separators.")

# Reuse the existing analysis reference, gene databases and ranking settings.
# The imported LRS postprocess pipeline expects 'samples', but this entry
# point deliberately has no BAM paths. No BAM rule is scheduled.
config.clear()
config.update(settings)
config.update(user_settings)
config["samples"] = {sample: None for sample in selected}
config["postprocess_samples"] = selected
config["path"] = str(result_root) + "/"
config["bam_free_downstream"] = True
config["xci_samples"] = []
# AlphaGenome may be switched on separately in the full workflow, but this
# archived-data reanalysis does not assume its cache or native model data.
config["alphagenome_atlas_enabled"] = False
config["alphagenome_native_plots_enabled"] = False

print("[LRS archived downstream] input_root:", result_root)
print("[LRS archived downstream] selected sample IDs:", ", ".join(selected))
print("[LRS archived downstream] BAM-independent reanalysis; new coverage, Samplot and XCI are not run")

# Includes the original phenotype ranking, annotation integration,
# score-free allele-event prioritization, cohort recurrence, final candidate ranking,
# Genomiser and further filtering. Missing BAM-derived upstream TSVs/bins
# remain explicit external prerequisites rather than silently re-called.
include: "../lrs/Snakefile_LRS_postprocess"

# Optional separate CADD-supported Genomiser comparison, never changes default all.
include: "cadd_comparison.smk"


# Optional plots that can be rebuilt from existing tabular files and
# coverage bins. This target intentionally excludes Samplot, XCI and
# sequencing QC plots that need BAMs or archived QC outputs.
rule saved_evidence_plots:
    input:
        expand(
            PATH + "{sample}/plots/15_downstream_filtering/.filter_plots.done",
            sample=POSTPROCESS_SAMPLES
        ),
        expand(
            PATH + "{sample}/plots_r/population_gene_effect/{sample}_population_gene_effect.pdf",
            sample=POSTPROCESS_SAMPLES
        ),
        expand(
            PATH + "{sample}/plots_r/candidate_evidence/{sample}_candidate_evidence.pdf",
            sample=POSTPROCESS_SAMPLES
        ),
        expand(
            PATH + "{sample}/plots_r/hpo/{sample}_hpo_heatmap.pdf",
            sample=POSTPROCESS_SAMPLES
        ),
        expand(
            PATH + "{sample}/plots_r/large_sv_depth/{sample}_large_sv_depth.pdf",
            sample=POSTPROCESS_SAMPLES
        ),
        COHORT_PLOT_OUTPUTS


# Full exploratory plot regeneration from saved LRS data.
# Do not call the legacy all_thesis_plots target: it requires Samplot/BAMs.
# Outputs are isolated in plots_reanalysis/ to avoid selecting old images.
ARCHIVED_PLOT_CONTEXT = {
    key: str(value) for key, value in PLOT_CONTEXT.items()
    if value and os.path.isfile(str(value))
}
ARCHIVED_PLOT_REPEATS = {
    key: str(value) for key, value in PLOT_REPEAT_BEDS.items()
    if value and os.path.isfile(str(value))
}
ARCHIVED_PLOT_CONTEXT_ARGS = " ".join(
    "--" + key + " " + shlex.quote(path)
    for key, path in ARCHIVED_PLOT_CONTEXT.items()
)
ARCHIVED_PLOT_CONTEXT_ARGS += " " + " ".join(
    "--repeat-bed " + shlex.quote(str(label) + "=" + path)
    for label, path in ARCHIVED_PLOT_REPEATS.items()
)
ARCHIVED_PLOT_CONTEXT_ARGS += " --random-draws " + str(
    int(config.get("genome_plot_random_draws", 200))
)
ARCHIVED_PLOT_INPUTS = (
    list(ARCHIVED_PLOT_CONTEXT.values())
    + list(ARCHIVED_PLOT_REPEATS.values())
)
ARCHIVED_PLOT_SCRIPTS = sorted(str(p) for p in Path(PLOTS).glob("*.py"))


rule archived_thesis_plots_sample:
    input:
        events=rules.finalize_candidate_ranking.output.sv,
        genes=rules.finalize_candidate_ranking.output.genes,
        integrated=rules.merge_integrated_annotations.output.tsv,
        multimodal=rules.build_gene_multimodal_summary.output.tsv,
        phenotypes=PATH + "{sample}/gene_discovery/{sample}_human_gene_phenotypes.tsv",
        genomiser=rules.genomiser_genome.output.manifest,
        comparison=rules.compare_genomiser_rankings.output.summary,
        available=existing_plot_inputs,
        context=ARCHIVED_PLOT_INPUTS,
        runner=PLOTS + "/run_thesis_plots.py",
        scripts=ARCHIVED_PLOT_SCRIPTS,
    output:
        manifest=PATH + "{sample}/plots_reanalysis/plot_run_manifest.tsv",
        done=touch(PATH + "{sample}/plots_reanalysis/.thesis_plots.done")
    params:
        outdir=PATH + "{sample}/plots_reanalysis",
        context_args=ARCHIVED_PLOT_CONTEXT_ARGS,
        gene_bed_arg=(
            "--gene-bed " + shlex.quote(str(GENE_BED))
            if GENE_BED and os.path.isfile(str(GENE_BED)) else ""
        ),
        gene_gtf_arg=(
            "--gene-gtf " + shlex.quote(str(PLOT_GENE_GTF))
            if PLOT_GENE_GTF and os.path.isfile(str(PLOT_GENE_GTF)) else ""
        ),
        methylation_units=config.get("methylation_units", "percent"),
        top_genes=THESIS_TOP_GENES,
        review_top_n=REVIEW_TOP_N,
        locus_top_n=LOCUS_TOP_N,
    conda:
        CONDAENV + "plots.yaml"
    log:
        PATH + "{sample}/logs/plots/{sample}.archived_thesis_plots.log"
    shell:
        """
        set -euo pipefail
        mkdir -p "$(dirname {log:q})"
        python {input.runner:q} \\
            --root {PATH:q} \\
            --sample {wildcards.sample:q} \\
            --platform lrs --focused \\
            --candidate-table {input.events:q} \\
            --evidence-table {input.integrated:q} \\
            --out-dir {params.outdir:q} \\
            --top-genes {params.top_genes} \\
            --review-top-n {params.review_top_n} \\
            --locus-top-n {params.locus_top_n} \\
            --methylation-units {params.methylation_units} \\
            {params.gene_bed_arg} \\
            {params.gene_gtf_arg} \\
            {params.context_args} \\
            > {log:q} 2>&1
        test -s {output.manifest:q}
        """


# Optional QC plots can be rebuilt only when Dorado QC and N50
# summaries were retained. Missing files are not treated as normal QC.
ARCHIVED_QC_SAMPLES = [
    sample for sample in POSTPROCESS_SAMPLES
    if os.path.isfile(PATH + f"{sample}/qc/{sample}.dorado_qc.tsv")
    and os.path.isfile(PATH + f"{sample}/qc/{sample}.n50.tsv")
]

# Comprehensive BAM-free plotting target: R/filtering/cohort plots plus all
# currently applicable Python plots. QC is included when saved metrics exist.
rule all_saved_thesis_plots:
    input:
        # Focused target excludes redundant R HPO/evidence/population figures.
        expand(
            PATH + "{sample}/plots/15_downstream_filtering/.filter_plots.done",
            sample=POSTPROCESS_SAMPLES,
        ),
        expand(
            PATH + "{sample}/plots_r/large_sv_depth/{sample}_large_sv_depth.pdf",
            sample=POSTPROCESS_SAMPLES,
        ),
        expand(
            PATH + "{sample}/plots_reanalysis/.thesis_plots.done",
            sample=POSTPROCESS_SAMPLES,
        ),
        expand(
            PATH + "{sample}/plots_r/qc/{sample}_sequencing_qc.pdf",
            sample=ARCHIVED_QC_SAMPLES,
        ),
