# SRS-WGS v2 postprocessing.
# Includes the isolated SRS workflow and adds only analyses that are valid for
# Illumina WGS. No LRS rule or LRS file is modified.

include: "Snakefile_SRS_WGS"

import os
import shlex

PLOTS = os.path.abspath(os.path.join(workflow.basedir, "../../plots"))
GENE_BED_SRS = config.get("gene_bed", os.path.abspath(os.path.join(workflow.basedir, "../../reference/gencode.genes.hg38.sorted.bed")))
MITOCARTA_FILE_SRS = config.get("mitocarta_file")
MITOCARTA_PATHWAYS_SRS = config.get("mitocarta_pathways_file")
GNOMAD_SV_VCF_SRS = config.get("gnomad_sv_vcf")
SV_GENE_BREAKPOINT_TOLERANCE_SRS = int(config.get("sv_gene_breakpoint_tolerance", 500))

SAMPLOT_TOP_N_SRS = int(config.get("samplot_top_n", 20))
SAMPLOT_MIN_MAPQ_SRS = int(config.get("samplot_min_mapq", 20))
SAMPLOT_ZOOM_BP_SRS = int(config.get("samplot_zoom_bp", 20000))
SAMPLOT_WINDOW_BP_SRS = int(config.get("samplot_window_bp", 5000))
SAMPLOT_LARGE_SV_THRESHOLD_SRS = int(config.get("samplot_large_sv_threshold", 1000000))


def gnomad_sv_inputs_srs(wc):
    if not GNOMAD_SV_VCF_SRS:
        return []
    return [GNOMAD_SV_VCF_SRS, GNOMAD_SV_VCF_SRS + ".tbi"]


def gnomad_sv_arg_srs(wc):
    return f"--gnomad-vcf {shlex.quote(GNOMAD_SV_VCF_SRS)}" if GNOMAD_SV_VCF_SRS else ""


def cohort_recurrence_args_srs():
    return " ".join(
        "--sample-input "
        + shlex.quote(
            sample
            + "="
            + PATH
            + f"{sample}/gene_discovery/{sample}_SRS_evidence_with_mitocarta.tsv"
        )
        for sample in SAMPLES
    )


############################################################
# MitoCarta / mechanism-aware candidate ranking             #
############################################################

rule annotate_mitocarta_context_srs:
    input:
        integrated=rules.integrate_srs_independent_evidence.output.enhanced,
        mitocarta=MITOCARTA_FILE_SRS,
        pathways=MITOCARTA_PATHWAYS_SRS,
        ranking=PATH + "{sample}/gene_discovery/{sample}_ranked_candidates.tsv",
        script=SCRIPTS + "/annotate_mitocarta_context.py"
    output:
        tsv=PATH + "{sample}/gene_discovery/{sample}_SRS_evidence_with_mitocarta.tsv",
        summary=PATH + "{sample}/gene_discovery/{sample}_SRS_mitocarta_summary.tsv"
    conda:
        CONDAENV + "plots.yaml"
    shell:
        """
        set -euo pipefail
        python {input.script:q} \
            --integrated {input.integrated:q} \
            --mitocarta {input.mitocarta:q} \
            --pathways-gmx {input.pathways:q} \
            --ranking {input.ranking:q} \
            --output {output.tsv:q} \
            --summary-output {output.summary:q}
        test -s {output.tsv}
        test -s {output.summary}
        """


rule rank_sv_gene_events_srs:
    input:
        integrated=rules.annotate_mitocarta_context_srs.output.tsv,
        script=SCRIPTS + "/rank_sv_gene_events.py"
    output:
        tsv=PATH + "{sample}/gene_discovery/{sample}_SRS_ranked_SV_gene_events.tsv"
    params:
        tolerance=SV_GENE_BREAKPOINT_TOLERANCE_SRS
    conda:
        CONDAENV + "plots.yaml"
    shell:
        """
        set -euo pipefail
        python {input.script:q} \
            --input {input.integrated:q} \
            --output {output.tsv:q} \
            --breakpoint-gene-tolerance {params.tolerance}
        test -s {output.tsv}
        """


rule annotate_gnomad_sv_exact_srs:
    input:
        events=rules.rank_sv_gene_events_srs.output.tsv,
        gnomad=gnomad_sv_inputs_srs,
        script=SCRIPTS + "/annotate_gnomad_sv_exact.py"
    output:
        tsv=PATH + "{sample}/gene_discovery/{sample}_SRS_ranked_SV_gene_events.gnomad.tsv"
    params:
        arg=gnomad_sv_arg_srs
    conda:
        CONDAENV + "plots.yaml"
    shell:
        """
        set -euo pipefail
        python {input.script:q} \
            --input {input.events:q} \
            {params.arg} \
            --output {output.tsv:q}
        test -s {output.tsv}
        """


rule build_gene_evidence_summary_srs:
    input:
        integrated=rules.annotate_mitocarta_context_srs.output.tsv,
        ranking=PATH + "{sample}/gene_discovery/{sample}_ranked_candidates.tsv",
        phenotypes=PATH + "{sample}/gene_discovery/{sample}_human_gene_phenotypes.tsv",
        script=PLOTS + "/build_gene_evidence_summary.py"
    output:
        tsv=PATH + "{sample}/gene_discovery/{sample}_SRS_gene_evidence_summary.tsv"
    conda:
        CONDAENV + "plots.yaml"
    shell:
        """
        set -euo pipefail
        python {input.script:q} \
            --integrated {input.integrated:q} \
            --ranking {input.ranking:q} \
            --phenotypes {input.phenotypes:q} \
            --output {output.tsv:q}
        test -s {output.tsv}
        """


############################################################
# Genome-wide small-variant / SV same-gene review           #
############################################################

rule vep_small_variants_srs:
    input:
        vcf=rules.whatshap_phasing.output.phased
    output:
        txt=PATH + "{sample}/snp_deepvariant/{sample}.phased.vep.txt"
    threads: min(THREADS, 8)
    conda:
        CONDAENV + "vep.yaml"
    shell:
        """
        set -euo pipefail
        vep \
            --input_file {input.vcf:q} \
            --format vcf \
            --output_file {output.txt:q} \
            --cache --offline \
            --dir_cache {VEP_CACHE_DIR:q} \
            --assembly {VEP_ASSEMBLY} \
            --canonical --flag_pick --symbol --biotype --variant_class \
            --force_overwrite --fork {threads}
        test -s {output.txt}
        """


rule build_snv_sv_candidates_srs:
    input:
        vep=rules.vep_small_variants_srs.output.txt,
        phased=rules.whatshap_phasing.output.phased,
        sv=rules.annotate_gnomad_sv_exact_srs.output.tsv,
        script=SRS_V2_SCRIPTS + "/build_srs_snv_sv_candidates.py"
    output:
        tsv=PATH + "{sample}/gene_discovery/final/{sample}_SRS_snv_sv_candidates.tsv"
    conda:
        CONDAENV + "plots.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.tsv})
        python {input.script:q} \
            --vep {input.vep:q} \
            --phased-vcf {input.phased:q} \
            --sv-candidates {input.sv:q} \
            --output {output.tsv:q}
        test -e {output.tsv}
        """


############################################################
# Short-read Samplot evidence                               #
############################################################

rule prepare_samplot_gene_annotation_srs:
    input:
        bed=GENE_BED_SRS
    output:
        bed=PATH + "reference_checks/srs_samplot_genes.bed.gz",
        index=PATH + "reference_checks/srs_samplot_genes.bed.gz.tbi"
    conda:
        CONDAENV + "samplot.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.bed})
        awk 'BEGIN{{OFS="\t"}} NF >= 4 && $1 ~ /^chr([1-9]|1[0-9]|2[0-2]|X|Y|M)$/ {{print}}' {input.bed:q} \
            | sort -k1,1V -k2,2n \
            | bgzip -c > {output.bed:q}
        tabix -f -p bed {output.bed:q}
        """


rule samplot_candidate_breakpoints_srs:
    input:
        candidates=rules.annotate_gnomad_sv_exact_srs.output.tsv,
        bam=lambda wc: BAMS[wc.sample],
        bai=lambda wc: bam_index_for(wc.sample),
        genes=rules.prepare_samplot_gene_annotation_srs.output.bed,
        gene_index=rules.prepare_samplot_gene_annotation_srs.output.index,
        script=SRS_V2_SCRIPTS + "/run_samplot_candidates_srs.py"
    output:
        manifest=PATH + "{sample}/plots_srs/breakpoint_evidence/samplot_manifest.tsv",
        marker=touch(PATH + "{sample}/plots_srs/breakpoint_evidence/.samplot.done")
    params:
        outdir=PATH + "{sample}/plots_srs/breakpoint_evidence/images"
    conda:
        CONDAENV + "samplot.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {params.outdir}
        python {input.script:q} \
            --input {input.candidates:q} \
            --bam {input.bam:q} \
            --reference {REF:q} \
            --sample {wildcards.sample:q} \
            --out-dir {params.outdir:q} \
            --top-n {SAMPLOT_TOP_N_SRS} \
            --min-mapq {SAMPLOT_MIN_MAPQ_SRS} \
            --zoom {SAMPLOT_ZOOM_BP_SRS} \
            --window {SAMPLOT_WINDOW_BP_SRS} \
            --large-sv-threshold {SAMPLOT_LARGE_SV_THRESHOLD_SRS} \
            --gene-annotation {input.genes:q} \
            --manifest {output.manifest:q}
        touch {output.marker:q}
        """


############################################################
# Cohort recurrence                                          #
############################################################

rule cohort_sv_recurrence_srs:
    input:
        tables=expand(
            PATH + "{sample}/gene_discovery/{sample}_SRS_evidence_with_mitocarta.tsv",
            sample=SAMPLES,
        ),
        script=SCRIPTS + "/build_cohort_sv_recurrence.py"
    output:
        summary=PATH + "cohort_analysis_srs/sv_recurrence.tsv",
        members=PATH + "cohort_analysis_srs/sv_recurrence_members.tsv"
    params:
        sample_args=lambda wc: cohort_recurrence_args_srs()
    conda:
        CONDAENV + "plots.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {PATH}cohort_analysis_srs
        python {input.script:q} \
            {params.sample_args} \
            --output {output.summary:q} \
            --members-output {output.members:q}
        test -s {output.summary}
        test -s {output.members}
        """


rule all_srs_postprocess:
    input:
        expand(PATH + "{sample}/gene_discovery/{sample}_SRS_evidence_with_mitocarta.tsv", sample=SAMPLES),
        expand(PATH + "{sample}/gene_discovery/{sample}_SRS_ranked_SV_gene_events.gnomad.tsv", sample=SAMPLES),
        expand(PATH + "{sample}/gene_discovery/{sample}_SRS_gene_evidence_summary.tsv", sample=SAMPLES),
        expand(PATH + "{sample}/gene_discovery/final/{sample}_SRS_snv_sv_candidates.tsv", sample=SAMPLES),
        expand(PATH + "{sample}/plots_srs/breakpoint_evidence/.samplot.done", sample=SAMPLES),
        PATH + "cohort_analysis_srs/sv_recurrence.tsv",
        PATH + "cohort_analysis_srs/sv_recurrence_members.tsv"
