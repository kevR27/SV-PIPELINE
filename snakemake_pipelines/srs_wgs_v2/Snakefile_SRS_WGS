import os
from pathlib import Path


configfile: "config_srs_wgs.yaml"

SAMPLES = list(config["samples"].keys())
BAMS = config["samples"]
BAM_INDEXES = config.get("bam_indexes", {})
PATH = config["path"].rstrip("/") + "/"
REF = config["ref"]
THREADS = config["threads"]

PANEL_BED = config.get("bed")
GENE_LIST = config["candidate_genes_list"]
EXCLUDE_BED = config["exclude_bed"]
EH_CATALOG = config["expansionhunter_catalog"]

CONDAENV = config["condaenv"]
SCRIPTS = os.path.abspath(os.path.join(workflow.basedir, "../../scripts"))
SRS_V2_SCRIPTS = os.path.abspath(os.path.join(workflow.basedir, "../../scripts/srs_wgs_v2"))
SRS_V2_ENVS = os.path.abspath(os.path.join(workflow.basedir, "../../envs/srs_wgs_v2")) + "/"

# SRS-WGS v2 independent evidence branches.
GRIDSS_ENABLED = config.get("gridss_enabled", True)
GRIDSS_BLACKLIST = config.get("gridss_blacklist")
GRIDSS_JVM_HEAP = config.get("gridss_jvm_heap", "24g")
GRIDSS_SKIP_SOFTCLIP_REALIGNMENT = config.get("gridss_skip_softclip_realignment", False)

CNVPYTOR_ENABLED = config.get("cnvpytor_enabled", True)
CNVPYTOR_BINS = [int(x) for x in config.get("cnvpytor_bins", [1000, 10000])]
CNVPYTOR_PRIMARY_BIN = int(config.get("cnvpytor_primary_bin", 1000))
if CNVPYTOR_PRIMARY_BIN not in CNVPYTOR_BINS:
    raise ValueError("cnvpytor_primary_bin must be one of cnvpytor_bins")

MTDNA_ENABLED = config.get("mtdna_enabled", True)
MT_CONTIG = config.get("mtdna_contig", "chrM")
MUTSERVE_LEVEL = config.get("mutserve_level", 0.01)

INDEPENDENT_RECIPROCAL_OVERLAP = config.get("independent_reciprocal_overlap", 0.5)
INDEPENDENT_BREAKPOINT_TOLERANCE = config.get("independent_breakpoint_tolerance", 500)

# DeepVariant is intentionally genome-wide in this WGS workflow. Panel-only
# subsets are downstream views, never the discovery input.

# AnnotSV.
ANNOTSV_BENIGN_AF = config.get("annotsv_benign_af", 0.01)
HPO_TERMS = config.get("hpo_terms")
ANNOTSV_ANNOTATIONS_DIR = config.get(
    "annotsv_annotations_dir",
    PATH + "reference/AnnotSV_annotations",
)

# Offline Monarch Knowledge Graph / phenotype discovery.
MONARCH_NODES = config["monarch_nodes"]
MONARCH_EDGES = config["monarch_edges"]
