        + expand(PATH + "{sample}/cnv/cnvpytor/{sample}.cnvpytor.annotsv.tsv", sample=SAMPLES)
    )

MTDNA_TARGETS = []
if MTDNA_ENABLED:
    MTDNA_TARGETS = (
        expand(PATH + "{sample}/mtdna/{sample}.mtDNA.vcf.gz", sample=SAMPLES)
        + expand(PATH + "{sample}/mtdna/{sample}.mtDNA.vcf.gz.tbi", sample=SAMPLES)
        + expand(PATH + "{sample}/mtdna/{sample}.mtDNA.vep.txt", sample=SAMPLES)
    )


