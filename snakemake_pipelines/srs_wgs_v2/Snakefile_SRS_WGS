rule srs_wgs_preflight:
    input:
        ref=REF,
        fai=REF + ".fai",
        panel=PANEL_BED,
        genes=GENE_LIST,
        bams=lambda wc: list(BAMS.values()),
        bais=lambda wc: [bam_index_for(s) for s in SAMPLES],
        script=SRS_V2_SCRIPTS + "/preflight_srs_wgs.py"
    output:
        marker=PATH + "reference_checks/srs_wgs_v2.preflight.ok"
    params:
        bam_args=lambda wc, input: " ".join(f"--bam {x}" for x in input.bams),
        bai_args=lambda wc, input: " ".join(f"--bai {x}" for x in input.bais),
        gridss="true" if GRIDSS_ENABLED else "false",
        mt="true" if MTDNA_ENABLED else "false"
    conda:
        SRS_V2_ENVS + "qc.yaml"
    shell:
        """
        set -euo pipefail
        python {input.script:q} \
            --reference {input.ref:q} \
            --panel-bed {input.panel:q} \
            --gene-list {input.genes:q} \
            --gridss-enabled {params.gridss} \
            --mt-enabled {params.mt} \
            --mt-contig {MT_CONTIG:q} \
            {params.bam_args} {params.bai_args} \
            --output {output.marker:q}
        """


rule samtools_flagstat:
    input:
        bam=lambda wc: BAMS[wc.sample],
        bai=lambda wc: bam_index_for(wc.sample)
    output:
        txt=PATH + "{sample}/qc/{sample}.flagstat.txt"
    threads: min(THREADS, 8)
    conda:
        SRS_V2_ENVS + "qc.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.txt})
        samtools flagstat -@ {threads} {input.bam:q} > {output.txt:q}
        """


rule samtools_stats:
    input:
        bam=lambda wc: BAMS[wc.sample],
        bai=lambda wc: bam_index_for(wc.sample)
    output:
        txt=PATH + "{sample}/qc/{sample}.samtools.stats.txt"
    threads: min(THREADS, 8)
    conda:
        SRS_V2_ENVS + "qc.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.txt})
        samtools stats -@ {threads} {input.bam:q} > {output.txt:q}
        """


rule build_wgs_qc_summary:
    input:
        flagstat=rules.samtools_flagstat.output.txt,
        stats=rules.samtools_stats.output.txt,
        mosdepth=PATH + "{sample}/coverage/{sample}.mosdepth.summary.txt",
        script=SRS_V2_SCRIPTS + "/build_qc_summary.py"
    output:
        tsv=PATH + "{sample}/qc/{sample}.wgs_qc_summary.tsv"
    conda:
        SRS_V2_ENVS + "qc.yaml"
    shell:
        """
        python {input.script:q} --sample {wildcards.sample:q} \
            --flagstat {input.flagstat:q} --stats {input.stats:q} \
            --mosdepth-summary {input.mosdepth:q} --output {output.tsv:q}
        """


rule mosdepth_coverage:
    input:
        bam=lambda wc: BAMS[wc.sample],
        bai=lambda wc: bam_index_for(wc.sample)
    output:
        global_dist=PATH + "{sample}/coverage/{sample}.mosdepth.global.dist.txt",
        summary=PATH + "{sample}/coverage/{sample}.mosdepth.summary.txt"
    params:
        prefix=PATH + "{sample}/coverage/{sample}"
    threads: THREADS
    conda:
        CONDAENV + "mosdepth.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.global_dist})
        mosdepth -t {threads} {params.prefix} {input.bam}
        test -s {output.global_dist}
        test -s {output.summary}
        """


