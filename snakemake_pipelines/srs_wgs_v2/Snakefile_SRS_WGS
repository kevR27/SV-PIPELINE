rule integrate_srs_independent_evidence:
    input:
        master=rules.intersect_srs_orthogonal_evidence.output.tsv,
        gridss=optional_gridss_vcf,
        gridss_ann=optional_gridss_annotsv,
        cnvpytor=optional_cnvpytor_calls,
        cnvpytor_ann=optional_cnvpytor_annotsv,
        script=SRS_V2_SCRIPTS + "/integrate_independent_evidence.py"
    output:
        enhanced=PATH + "{sample}/gene_discovery/{sample}_SRS_evidence_enhanced.tsv",
        cnv_only=PATH + "{sample}/gene_discovery/{sample}_CNVpytor_only_candidates.tsv",
        gridss_only=PATH + "{sample}/gene_discovery/{sample}_GRIDSS_only_candidates.tsv"
    params:
        gridss=lambda wc: (
            f"--gridss {PATH}{wc.sample}/sv/gridss/{wc.sample}.gridss.vcf.gz "
            f"--gridss-annotsv {PATH}{wc.sample}/sv/gridss/{wc.sample}.gridss.annotsv.tsv"
            if GRIDSS_ENABLED else ""
        ),
        cnvpytor=lambda wc: (
            f"--cnvpytor {PATH}{wc.sample}/cnv/cnvpytor/{wc.sample}.cnvpytor.calls.tsv "
            f"--cnvpytor-annotsv {PATH}{wc.sample}/cnv/cnvpytor/{wc.sample}.cnvpytor.annotsv.tsv"
            if CNVPYTOR_ENABLED else ""
        )
    conda:
        CONDAENV + "monarch.yaml"
    shell:
        """
        set -euo pipefail
        python {input.script:q} \
            --master {input.master:q} \
            {params.cnvpytor} {params.gridss} \
            --reciprocal-overlap {INDEPENDENT_RECIPROCAL_OVERLAP} \
            --breakpoint-tolerance {INDEPENDENT_BREAKPOINT_TOLERANCE} \
            --output {output.enhanced:q} \
            --cnvpytor-only {output.cnv_only:q} \
            --gridss-only {output.gridss_only:q}
        """


