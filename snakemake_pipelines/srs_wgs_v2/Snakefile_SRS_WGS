rule cnvpytor_wgs:
    input:
        bam=lambda wc: BAMS[wc.sample],
        bai=lambda wc: bam_index_for(wc.sample),
        snv=rules.deepvariant_snp.output.vcf,
        snv_tbi=rules.deepvariant_snp.output.tbi,
        preflight=rules.srs_wgs_preflight.output.marker,
        parser=SRS_V2_SCRIPTS + "/parse_cnvpytor_calls.py"
    output:
        root=PATH + "{sample}/cnv/cnvpytor/{sample}.cnvpytor.pytor",
        calls=PATH + "{sample}/cnv/cnvpytor/{sample}.cnvpytor.calls.tsv",
        vcf=PATH + "{sample}/cnv/cnvpytor/{sample}.cnvpytor.primary.vcf.gz",
        tbi=PATH + "{sample}/cnv/cnvpytor/{sample}.cnvpytor.primary.vcf.gz.tbi"
    params:
        bins=" ".join(str(x) for x in CNVPYTOR_BINS),
        primary=CNVPYTOR_PRIMARY_BIN,
        workdir=PATH + "{sample}/cnv/cnvpytor/work",
        rawvcf=PATH + "{sample}/cnv/cnvpytor/{sample}.cnvpytor.primary.vcf"
    conda:
        SRS_V2_ENVS + "cnvpytor.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {params.workdir}
        rm -f {output.root}
        cnvpytor -root {output.root:q} -rd {input.bam:q}
        cnvpytor -root {output.root:q} -his {params.bins}
        cnvpytor -root {output.root:q} -partition {params.bins}

        VCF_SAMPLE=$(bcftools query -l {input.snv:q} | head -n 1)
        test -n "$VCF_SAMPLE"
        cnvpytor -root {output.root:q} -snp {input.snv:q} -sample "$VCF_SAMPLE"
        cnvpytor -root {output.root:q} -baf {params.bins}

        CALL_ARGS=""
        for BIN in {params.bins}; do
            CALL_FILE="{params.workdir}/calls.$BIN.tsv"
            cnvpytor -root {output.root:q} -call "$BIN" > "$CALL_FILE"
            CALL_ARGS="$CALL_ARGS --call $BIN=$CALL_FILE"
        done

        python {input.parser:q} $CALL_ARGS \
            --primary-bin {params.primary} \
            --output-tsv {output.calls:q} \
            --output-vcf {params.rawvcf:q}

        bcftools sort -Oz -o {output.vcf:q} {params.rawvcf:q}
        tabix -f -p vcf {output.vcf:q}
        test -s {output.calls}
        test -s {output.vcf}
        """


