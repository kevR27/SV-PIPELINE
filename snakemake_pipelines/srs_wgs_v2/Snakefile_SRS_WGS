        samtools faidx {input.ref:q} {MT_CONTIG:q} > {output.fa:q}
        samtools faidx {output.fa:q}
        """


rule extract_mtdna_bam:
    input:
        bam=lambda wc: BAMS[wc.sample],
        bai=lambda wc: bam_index_for(wc.sample)
    output:
        bam=PATH + "{sample}/mtdna/{sample}.chrM.bam",
        bai=PATH + "{sample}/mtdna/{sample}.chrM.bam.bai"
    threads: min(THREADS, 8)
    conda:
        SRS_V2_ENVS + "mutserve.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.bam})
        samtools view -@ {threads} -b {input.bam:q} {MT_CONTIG:q} -o {output.bam:q}
        samtools index -@ {threads} {output.bam:q}
        """


rule mutserve_mtdna:
    input:
        bam=rules.extract_mtdna_bam.output.bam,
        bai=rules.extract_mtdna_bam.output.bai,
        ref=rules.extract_mtdna_reference.output.fa,
        fai=rules.extract_mtdna_reference.output.fai
    output:
        vcf=PATH + "{sample}/mtdna/{sample}.mtDNA.vcf.gz",
        tbi=PATH + "{sample}/mtdna/{sample}.mtDNA.vcf.gz.tbi"
    threads: min(THREADS, 16)
    conda:
        SRS_V2_ENVS + "mutserve.yaml"
    shell:
        """
        set -euo pipefail
        mutserve call \
            --reference {input.ref:q} \
            --output {output.vcf:q} \
            --threads {threads} \
            --level {MUTSERVE_LEVEL} \
            {input.bam:q}
        tabix -f -p vcf {output.vcf:q}
        test -s {output.vcf}
        """


rule vep_mtdna:
    input:
        vcf=rules.mutserve_mtdna.output.vcf
    output:
        txt=PATH + "{sample}/mtdna/{sample}.mtDNA.vep.txt"
    threads: min(THREADS, 8)
    conda:
        CONDAENV + "vep.yaml"
    shell:
        """
        set -euo pipefail
        vep \
            --input_file {input.vcf:q} \
            --format vcf \
            --output_file {output.txt:q} \
            --cache --offline \
            --dir_cache {VEP_CACHE_DIR:q} \
            --assembly {VEP_ASSEMBLY} \
            --canonical --symbol --biotype --fork {threads}
        test -s {output.txt}
        """


